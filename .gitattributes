# ========================================
# Git Attributes
# ========================================
# Git이 파일을 처리하는 방식을 제어
# https://git-scm.com/docs/gitattributes
# ========================================

# ========================================
# 기본 설정 - 자동 줄바꿈 변환
# ========================================
* text=auto

# ========================================
# 소스 코드 - LF로 통일
# ========================================
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.prisma text eol=lf
*.sql text eol=lf

# ========================================
# Shell Scripts - LF
# ========================================
*.sh text eol=lf
*.bash text eol=lf

# ========================================
# Windows Scripts - CRLF
# ========================================
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ========================================
# 문서
# ========================================
*.txt text eol=lf
*.doc diff=astextplain
*.DOC diff=astextplain
*.docx diff=astextplain
*.DOCX diff=astextplain
*.dot diff=astextplain
*.DOT diff=astextplain
*.pdf diff=astextplain
*.PDF diff=astextplain
*.rtf diff=astextplain
*.RTF diff=astextplain

# ========================================
# Config Files
# ========================================
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
package.json text eol=lf
package-lock.json text eol=lf
tsconfig*.json text eol=lf
*.config.js text eol=lf
*.config.ts text eol=lf
*.config.mjs text eol=lf
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
.dockerignore text eol=lf

# ========================================
# 바이너리 파일 - diff 제외
# ========================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg binary
*.pdf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# ========================================
# 폰트 파일
# ========================================
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# ========================================
# 미디어 파일
# ========================================
*.mp3 binary
*.mp4 binary
*.wav binary
*.ogg binary
*.mov binary
*.avi binary

# ========================================
# 인증서 및 키
# ========================================
*.pem binary
*.key binary
*.crt binary
*.pfx binary
*.p12 binary

# ========================================
# macOS 아이콘
# ========================================
*.icns binary

# ========================================
# Linguist 설정 (GitHub 언어 통계)
# ========================================
# 문서 및 벤더 코드는 언어 통계에서 제외
*.md linguist-documentation
docs/** linguist-documentation
*.svg linguist-generated=true
swagger.json linguist-generated=true

# ========================================
# Diff 설정
# ========================================
# Package lock 파일은 diff에서 제외
package-lock.json -diff
yarn.lock -diff

# Prisma 마이그레이션은 diff에 포함
*.sql diff

# ========================================
# Merge 전략
# ========================================
# 특정 파일은 충돌 시 수동 병합 필요
package.json merge=union
package-lock.json merge=union

