{
  "root": "apps/api",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "command": "npx prisma generate --schema=apps/api/prisma/schema.prisma && tspc -p apps/api/tsconfig.app.json",
        "cwd": "."
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "DOTENV_CONFIG_PATH=env.development node -r dotenv/config dist/apps/api/src/apps/api-gateway/src/main.js",
        "cwd": ".",
        "env": {
          "NODE_ENV": "development",
          "DATABASE_URL": "mysql://papyrus:papyrus@localhost:3307/papyrus",
          "API_PORT": "8000",
          "PORT": "8000",
          "BIND_HOST": "0.0.0.0",
          "JWT_SECRET": "dev-jwt-secret-key-not-for-production-use-only",
          "JWT_EXPIRES_IN": "15m",
          "JWT_REFRESH_EXPIRES_IN": "7d",
          "APP_ORIGINS": "https://app.civilization.zone,https://app.civilization.local,http://localhost:4200,http://127.0.0.1:4200",
          "CORS_ORIGIN": "*",
          "UPLOAD_PATH": "./uploads",
          "MAX_FILE_SIZE": "10485760",
          "PRISMA_HIDE_UPDATE_MESSAGE": "true",
          "DOMAIN_NAME": "app.civilization.zone",
          "DOMAIN_LOCAL": "app.civilization.local",
          "DOMAIN_ALIASES": "localhost",
          "NGINX_HTTP_PORT": "8080",
          "NGINX_HTTPS_PORT": "8443",
          "WEB_PORT": "3000",
          "MYSQL_PORT": "3307",
          "DOCKER_NETWORK_NAME": "papyrus-network",
          "MYSQL_VOLUME_NAME": "papyrus_mysql-data",
          "CORS_METHODS": "GET,POST,PUT,DELETE,OPTIONS",
          "CORS_HEADERS": "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization",
          "CACHE_MAX_AGE": "1y",
          "GZIP_MIN_LENGTH": "1024"
        }
      },
      "dependsOn": ["build"]
    },
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "shx rm -rf src/api && shx mkdir -p src/api && npx nestia all && node -e \"const fs=require('fs');const p='src/api/functional/index.ts';if(fs.existsSync(p)){const s=fs.readFileSync(p,'utf8');if(!/\\\\bexport\\\\b/.test(s))fs.appendFileSync(p,'\\nexport {}\\n');}\"",
        "cwd": "./apps/api"
      }
    }
  }
}
