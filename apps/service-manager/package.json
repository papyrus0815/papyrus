{
  "name": "papyrus-service-manager",
  "version": "1.0.1",
  "description": "Papyrus Service Manager - 독립 실행형 서비스 관리 도구",
  "author": "Papyrus Team",
  "license": "MIT",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build:main && npm run build:renderer && npm run copy-renderer && npx electron .",
    "dev:watch": "npm run build:main && npm run build:renderer:watch & npm run copy-renderer:watch & npx electron .",
    "build": "npm run build:main && npm run build:renderer && npm run copy-renderer && npm run create-icon",
    "build:main": "tsc",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "build:renderer:watch": "tsc -p tsconfig.renderer.json --watch",
    "copy-renderer": "node scripts/copy-renderer.js",
    "copy-renderer:watch": "node scripts/copy-renderer.js && chokidar 'dist/renderer/ts/*.js' -c 'node scripts/copy-renderer.js'",
    "create-icon": "node create-icon.js",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "start": "npm run build && npx electron .",
    "start:win": "chcp 65001 >nul && npm run build && npx electron .",
    "start-gui": "npm run build && npx electron . --no-console",
    "start-gui-mac": "./start-gui.sh",
    "electron": "npx electron .",
    "electron-bg": "node electron-start.js"
  },
  "dependencies": {
    "electron": "^33.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.papyrus.service-manager",
    "productName": "Papyrus Service Manager",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "start-web-server.bat",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
