`

const CustomCheckbox = styled.label`
  display: flex;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
  font-size: 0.85rem;
  color: #6b7280;
  user-select: none;
  margin-bottom: 0.5rem;

  input[type='checkbox'] {
    display: none;
  }

  .checkmark {
    width: 18px;
    height: 18px;
    border: 2px solid #d1d5db;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    background: white;

    svg {
      opacity: 0;
      color: white;
      transition: opacity 0.2s;
    }
  }

  input[type='checkbox']:checked + .checkmark {
    background: #a78bfa;
    border-color: #a78bfa;

    svg {
      opacity: 1;
    }
  }

  &:hover .checkmark {
    border-color: #a78bfa;
  }

  .label {
    color: #374151;
  }
`

const UnknownDateBox = styled.div`
  display: flex;
  align-items: center;
