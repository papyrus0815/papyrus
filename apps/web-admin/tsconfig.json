{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "es2017"],
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "@api": ["../apps/api/src/api/index.ts"],
      "@api/*": ["../apps/api/src/api/*"],
      "@papyrus/api-sdk": ["../libs/api-sdk/src/index.ts"]
    }
  },
  "include": ["src"]
}
