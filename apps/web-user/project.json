{
  "name": "web-user",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web-user/src",
  "projectType": "application",
  "tags": ["type:app", "scope:web-user"],

  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/web-user"],
      "defaultConfiguration": "production",
      "options": {
        "command": "vite build",
        "cwd": "apps/web-user"
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },

    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "vite --port 4200",
        "cwd": "apps/web-user"
      },
      "configurations": {
        "development": {
          "command": "vite --mode development --port 4200"
        },
        "production": {
          "command": "vite --mode production --port 4200"
        }
      }
    },

    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/web-user/jest.config.ts"
      }
    },

    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}

