# 이 파일을 secrets.env로 복사해 값을 채운다 (`deploy/scripts/k8s.sh up`은 없으면 무작위로 만든다).
# DATABASE_URL에 그대로 들어가므로 비밀번호에 @ : / # ? 같은 URL 예약 문자를 쓰지 말 것.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=papyrus
MYSQL_USER=papyrus
MYSQL_PASSWORD=change-me
# 32자 이상 (Joi 검증)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
