# 개발 환경용 추가 설정
# 이 파일은 개발 중 CORS 문제 해결을 위한 추가 설정을 포함합니다
server {
    # 포트에서 HTTP 요청 수신 (환경 변수 사용)
    listen ${NGINX_HTTP_PORT:-80};
    # 와일드카드 도메인 매칭 (모든 civilization.local, civilization.zone 하위 도메인)
    server_name *.civilization.local *.civilization.zone;
    
    # CORS (Cross-Origin Resource Sharing) 헤더 설정
    # 개발 환경에서 브라우저의 동일 출처 정책 우회를 위해 필요
    
    # 모든 도메인에서의 요청 허용 (개발 환경에서만 사용)
    add_header 'Access-Control-Allow-Origin' '${CORS_ORIGIN:-*}' always;
    # 허용되는 HTTP 메서드들 (환경 변수 사용)
    add_header 'Access-Control-Allow-Methods' '${CORS_METHODS:-GET,POST,PUT,DELETE,OPTIONS}' always;
    # 허용되는 요청 헤더들 (환경 변수 사용)
    add_header 'Access-Control-Allow-Headers' '${CORS_HEADERS:-DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization}' always;
    
    # Preflight OPTIONS 요청 처리
    # 브라우저가 실제 요청 전에 보내는 사전 요청에 대한 응답
    if ($request_method = 'OPTIONS') {
        # CORS 헤더 재설정 (if 블록 내에서는 always 플래그 사용 불가)
        add_header 'Access-Control-Allow-Origin' '${CORS_ORIGIN:-*}';
        add_header 'Access-Control-Allow-Methods' '${CORS_METHODS:-GET,POST,PUT,DELETE,OPTIONS}';
        add_header 'Access-Control-Allow-Headers' '${CORS_HEADERS:-DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization}';
        # Preflight 결과 캐시 시간 (20일)
        add_header 'Access-Control-Max-Age' 1728000;
        # 응답 타입 설정
        add_header 'Content-Type' 'text/plain; charset=utf-8';
        # 응답 본문 길이 0
        add_header 'Content-Length' 0;
        # HTTP 204 No Content 응답 (성공적이지만 본문 없음)
        return 204;
    }
}
