# Nginx 이벤트 모듈 설정
events {
    # 각 워커 프로세스가 동시에 처리할 수 있는 최대 연결 수
    # 개발 환경에서는 1024로 충분하지만, 프로덕션에서는 더 높게 설정 가능
    worker_connections 1024;
}

# HTTP 모듈 설정
http {
    # MIME 타입 파일 포함 (파일 확장자별 Content-Type 설정)
    include       /etc/nginx/mime.types;
    # 기본 MIME 타입 (알 수 없는 파일 타입에 대한 기본값)
    default_type  application/octet-stream;
    
    # 로그 포맷 정의 - 요청 정보를 구조화된 형태로 기록
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
    
    # 액세스 로그: 모든 HTTP 요청 기록
    access_log /var/log/nginx/access.log main;
    # 에러 로그: Nginx 에러 및 경고 메시지 기록
    error_log /var/log/nginx/error.log;
    
    # 성능 최적화 설정
    sendfile on;           # 파일 전송 시 커널의 sendfile() 사용으로 효율성 증대
    tcp_nopush on;         # TCP_NOPUSH 옵션으로 패킷 전송 최적화
    tcp_nodelay on;        # TCP_NODELAY 옵션으로 지연 시간 최소화
    keepalive_timeout 65;  # Keep-Alive 연결 유지 시간 (초)
    types_hash_max_size 2048;  # MIME 타입 해시 테이블 크기
    
    # Gzip 압축 설정 - 전송 데이터 크기 감소로 성능 향상
    gzip on;                    # Gzip 압축 활성화
    gzip_vary on;               # Vary 헤더 추가로 캐시 호환성 확보
    gzip_min_length ${GZIP_MIN_LENGTH:-1024};       # 최소 압축 대상 파일 크기 (기본값: 1KB)
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json;
    
    # 업스트림 서버 정의 - 백엔드 서버들의 그룹
    # API 서버 그룹 (NestJS 애플리케이션)
    upstream api_backend {
        # host.docker.internal: Docker Desktop에서 호스트 머신 접근
        # 포트: NestJS API 서버 포트 (환경 변수 사용)
        server host.docker.internal:${API_PORT:-8000};
    }
    
    # 웹 서버 그룹 (React 애플리케이션)
    upstream web_backend {
        # 포트: React 개발 서버 포트 (환경 변수 사용)
        server host.docker.internal:${WEB_PORT:-3000};
    }
    
    # 가상 서버 블록 - 도메인별 요청 처리
    server {
        # 포트에서 HTTP 요청 수신 (환경 변수 사용)
        listen ${NGINX_HTTP_PORT:-80};
        # 이 서버가 처리할 도메인들 (환경 변수 사용)
        server_name ${DOMAIN_NAME:-app.civilization.zone} ${DOMAIN_LOCAL:-app.civilization.local} ${DOMAIN_ALIASES:-localhost};
        
        # API 요청 프록시 설정
        # /api/로 시작하는 모든 요청을 NestJS API 서버로 전달
        location /api/ {
            # 업스트림 서버로 요청 전달 (끝의 /는 경로 정규화)
            proxy_pass http://api_backend/;
            # HTTP/1.1 프로토콜 사용 (WebSocket 지원을 위해 필요)
            proxy_http_version 1.1;
            # WebSocket 업그레이드 헤더 전달
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            # 원본 호스트 정보 전달 (가상 호스팅 지원)
            proxy_set_header Host $host;
            # 클라이언트 실제 IP 주소 전달 (로드 밸런서 뒤의 실제 IP 확인)
            proxy_set_header X-Real-IP $remote_addr;
            # 프록시 체인 정보 전달 (X-Forwarded-For 헤더 누적)
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            # 원본 프로토콜 정보 전달 (HTTP/HTTPS 구분)
            proxy_set_header X-Forwarded-Proto $scheme;
            # WebSocket 요청 시 캐시 우회
            proxy_cache_bypass $http_upgrade;
        }
        
        # Swagger API 문서 프록시 설정
        # /swagger 경로로 접근하는 API 문서 요청 처리
        location /swagger {
            # NestJS의 Swagger 엔드포인트로 요청 전달
            proxy_pass http://api_backend/swagger;
            proxy_http_version 1.1;
            # 기본 프록시 헤더 설정
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        
        # 웹 애플리케이션 프록시 설정 (기본 경로)
        # 위의 특정 경로가 아닌 모든 요청을 React 개발 서버로 전달
        location / {
            # React 개발 서버로 요청 전달
            proxy_pass http://web_backend/;
            proxy_http_version 1.1;
            # WebSocket 지원 (HMR - Hot Module Replacement)
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            # 프록시 헤더 설정
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # WebSocket 요청 시 캐시 우회
            proxy_cache_bypass $http_upgrade;
        }
        
        # 정적 파일 캐싱 설정
        # 정규식으로 정적 파일 확장자 매칭 (대소문자 구분 없음)
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
            # 정적 파일도 웹 서버를 통해 제공 (개발 환경)
            proxy_pass http://web_backend;
            # 브라우저 캐시 설정 (환경 변수 사용)
            expires ${CACHE_MAX_AGE:-1y};
            # 캐시 제어 헤더 추가 (공개 캐시, 변경 불가)
            add_header Cache-Control "public, immutable";
        }
    }
}
