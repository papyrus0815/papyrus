# 개발 환경 설정
NODE_ENV=development
LOG_LEVEL=debug

# 데이터베이스 설정
DATABASE_URL=mysql://papyrus:papyrus@localhost:3307/papyrus?timezone=Asia/Seoul
SHADOW_DATABASE_URL=mysql://papyrus:papyrus@localhost:3307/papyrus_shadow?timezone=Asia/Seoul
MYSQL_HOST=localhost
MYSQL_ROOT_PASSWORD=papyrus
MYSQL_DATABASE=papyrus
MYSQL_USER=papyrus
MYSQL_PASSWORD=papyrus

# JWT 설정 (개발용 - 보안이 약함)
JWT_SECRET=dev-jwt-secret-key-not-for-production-use-only
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=90d

# 서버 설정
API_PORT=8000
PORT=8000
BIND_HOST=0.0.0.0
WEB_BIND_HOST=0.0.0.0

# CORS 설정 (개발 환경에서는 모든 도메인 허용)
APP_ORIGINS=https://app.civilization.zone,https://app.civilization.local,http://app.civilization.zone:3000,http://app.civilization.local:3000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:4200,http://127.0.0.1:4200,http://172.30.1.38:3000,http://172.25.160.1:3000
CORS_ORIGIN=*

# 업로드 설정
UPLOAD_PATH=./apps/api/uploads
MAX_FILE_SIZE=10485760

# Prisma 설정
PRISMA_HIDE_UPDATE_MESSAGE=true

# 도메인 설정
DOMAIN_NAME=app.civilization.zone
DOMAIN_LOCAL=app.civilization.local
DOMAIN_ALIASES=localhost

# 포트 설정
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
WEB_PORT=3000
MYSQL_PORT=3307

# API 연결 설정
API_ORIGIN=http://localhost:8000

# 네트워크 설정
DOCKER_NETWORK_NAME=papyrus-network
MYSQL_VOLUME_NAME=papyrus_mysql-data

# CORS 설정
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization

# 캐시 설정
CACHE_MAX_AGE=1y
GZIP_MIN_LENGTH=1024

# Vite 클라이언트 환경 변수 (VITE_ 접두사 필요)
VITE_API_BASE_URL=


