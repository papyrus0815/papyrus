# 프로덕션 환경 설정
NODE_ENV=production
LOG_LEVEL=info

# 데이터베이스 설정 (보안을 위해 강력한 비밀번호 사용)
DATABASE_URL="mysql://papyrus_user:your_strong_password@localhost:3306/papyrus_prod?timezone=Asia/Seoul"
MYSQL_ROOT_PASSWORD=your_very_strong_root_password_here
MYSQL_DATABASE=papyrus_prod
MYSQL_USER=papyrus_user
MYSQL_PASSWORD=your_very_strong_user_password_here

# JWT 설정 (프로덕션용 - 강력한 비밀키 필요)
JWT_SECRET="your-super-secure-jwt-secret-key-for-production-minimum-64-characters-long"
JWT_EXPIRES_IN="30d"
JWT_REFRESH_EXPIRES_IN="90d"

# 서버 설정
API_PORT=8000
PORT=8000
BIND_HOST="0.0.0.0"

# CORS 설정 (프로덕션에서는 특정 도메인만 허용)
APP_ORIGINS="https://your-domain.com,https://www.your-domain.com"
CORS_ORIGIN=https://your-domain.com

# 업로드 설정
UPLOAD_PATH="/var/uploads"
MAX_FILE_SIZE=10485760

# Prisma 설정
PRISMA_HIDE_UPDATE_MESSAGE="true"

# 도메인 설정
DOMAIN_NAME=your-domain.com
DOMAIN_LOCAL=
DOMAIN_ALIASES=

# 포트 설정
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
WEB_PORT=3000
MYSQL_PORT=3306

# 네트워크 설정
DOCKER_NETWORK_NAME=papyrus-prod-network
MYSQL_VOLUME_NAME=papyrus_prod_mysql-data

# CORS 설정
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization

# 캐시 설정 (프로덕션에서는 더 긴 캐시 시간)
CACHE_MAX_AGE=31536000
GZIP_MIN_LENGTH=1024
