/// ║                               COMMON DOMAIN                                  ║
/// ╚══════════════════════════════════════════════════════════════════════════════╝
/// 
/// 이 도메인은 시스템의 기본적인 사용자 관리와 공통 기능을 담당합니다.
/// 
/// 주요 기능:
/// - 사용자 계정(Account): 로그인, 인증, 권한 관리
/// - 히어로(Hero): 사용자가 선택할 수 있는 아바타/캐릭터 시스템
/// - 리프레시 토큰(RefreshToken): JWT 토큰 갱신을 위한 보안 토큰 관리
/// - 액션 로그(ActionLog): 시스템 전체의 CRUD 작업 기록
/// - 첨부파일(Attachment): 다양한 엔티티에 연결되는 파일 관리
/// 
/// 특징:
/// - 인증/인가 관련 핵심 기능
/// - 다형성 관계 활용 (ActionLog, Attachment)
/// - 보안과 직결되는 민감한 데이터 포함

// ========================
// User
// ========================

/// 사용자 정보 테이블
model Account {
  id            String         @id @default(uuid()) @db.Char(36)
  /// 선택한 히어로 (nullable)
  heroId        String?        @map("hero_id")
  /// 사용자 계정명 (고유)
  username      String         @unique @map("user_name") @db.VarChar(50)
  /// 해시된 비밀번호
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  /// 가입 일자
  createdAt     DateTime       @default(now()) @map("created_at")
  /// 사용자에 연결된 리프레시 토큰 목록
  refreshTokens RefreshToken[]
  hero          Hero?          @relation(fields: [heroId], references: [id])
  /// 이 계정이 등록한 인물 (개인 정보 플랫폼: 계정별 소유)
  persons           Person[]            @relation("AccountPersons")
  /// 이 계정이 등록한 역사적 국가
  historicalCountries HistoricalCountry[] @relation("AccountHistoricalCountries")
  /// 이 계정이 등록한 현대 국가
  countries Country[] @relation("AccountCountries")
  /// 이 계정이 등록한 행정부(Cabinet)
  cabinets Cabinet[] @relation("AccountCabinets")
  /// 다국 행정부 묶음 그룹 (CabinetLinkageGroup)
  cabinetLinkageGroups CabinetLinkageGroup[] @relation("AccountCabinetLinkageGroups")
  /// 이 계정이 등록한 재임/각료(GovernmentPositionTenure)
  governmentTenures GovernmentPositionTenure[] @relation("AccountGovernmentTenures")
  sovereignReigns   SovereignReign[]           @relation("AccountSovereignReigns")
  /// 이 계정이 등록한 조약(Treaty)
  treaties Treaty[] @relation("AccountTreaties")
  /// 이 계정이 등록한 선거(Election)
  elections Election[] @relation("AccountElections")

  @@map("account")
}

/// 히어로 도감(카탈로그) 테이블
model Hero {
  id        String  @id @default(uuid()) @db.Char(36)
  /// 히어로 이름 (고유)
  name      String  @unique
  /// 히어로 설명
  bio       String?
  /// 썸네일 이미지 경로
  thumbnail String?

  /// 이 히어로를 선택한 유저 목록 (1:N 관계)
  accounts Account[]

  @@map("hero")
}

/// 리프레시 토큰 저장 테이블
model RefreshToken {
  /// 고유 토큰 ID
  id        String   @id @default(uuid()) @db.Char(36)
  /// 연결된 사용자 ID (FK)
  accountId String   @map("account_id") @db.Char(36)
  /// 토큰 해시 (고유)
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  /// 만료 시각
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  /// 취소 여부 (true = 무효화된 토큰)
  revoked   Boolean  @default(false) @map("revoked")
  /// 사용자와의 관계
  account   Account  @relation(fields: [accountId], references: [id])

  /// 사용자 기준 인덱스 (조회 속도 향상)
  @@index([accountId])
  @@map("refresh_token")
}

model ActionLog {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 대상 타입
  ownerType AggregateType @map("owner_type")

  /// 대상 PK
  recordId String? @map("record_id") @db.Char(36)

  /// 메시지
  message String? @db.VarChar(255)

  /// 이벤트 메서드 (CREATE/UPDATE/DELETE)
  method EventMethod @map("method")

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")

  @@map("action_log")
}

/// 헤더 알림 (전체 CRUD). "무엇이" CRUD됐는지 특정값(entityLabel)으로 명시.
model Notification {
  id        String   @id @default(uuid()) @db.Char(36)
  /// CRUD된 대상을 식별하는 이름 (필수). 예: 인물명 "홍길동", 국가명 "한국", 사건명 "임진왜란", 재임 "세종대왕 - 대통령"
  /// → 클라이언트 표시: "{entityLabel}이(가) 등록/수정/삭제되었습니다"
  entityLabel String  @map("entity_label") @db.VarChar(255)
  /// 동작 구분. entityLabel + method로 "홍길동이 등록되었습니다" 등 문장 조합 가능
  method    EventMethod  @map("method")
  /// 리소스 타입 (필터·딥링크·문장 조합용). 예: PERSON → "인물이"
  ownerType AggregateType? @map("owner_type")
  /// 상세 페이지 이동용 ID
  recordId  String?  @map("record_id") @db.Char(36)
  /// (선택) 부가 설명. 예: 직책명만, 기간, 하위 항목 요약 등
  preview   String?  @db.VarChar(500)
  /// (선택) 서버에서 이미 조합한 완성 문장. 넣으면 클라이언트는 이걸 우선 표시
  title     String?  @db.VarChar(255)
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt], name: "idx_notification_created_at")
  @@index([ownerType], name: "idx_notification_owner_type")
  @@index([read], name: "idx_notification_read")
  @@map("notification")
}

// ========================
// Attachment
// ========================
model Attachment {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 첨부 대상(열거형)
  ownerType AttachmentOwner @map("owner_type")

  /// 첨부 대상의 PK값
  ownerId String @map("owner_id") @db.Char(36)

  /// 파일 제목
  title String @db.VarChar(100)

  /// 파일 경로 (업로드 루트 기준 상대 `images/...` 또는 레거시 절대 `/uploads/...` URL)
  filePath String @map("file_path") @db.VarChar(500)

  /// 파일 유형 (예: mime)
  fileType String @map("file_type") @db.VarChar(100)

  /// 파일 크기(byte)
  fileSize Int @map("file_size")

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ownerType], name: "idx_attachment_ownerType")
  @@index([ownerId], name: "idx_attachment_ownerId")
  @@map("attachment")
}
