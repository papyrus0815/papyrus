/// ║                              COUNTRY DOMAIN                                  ║
/// ╚══════════════════════════════════════════════════════════════════════════════╝
/// 
/// 이 도메인은 현대 국가들과 그 행정 체계를 관리합니다.
/// 
/// 주요 기능:
/// - 국가(Country): 현재 존재하는 국가들의 기본 정보
///   • 인구, 면적, 수도, 국기 이모지
///   • ISO 코드, 화폐, 언어, 대륙 연결
///   • 수출입 데이터, 사회현상, 군사자산 등과 연관
/// 
/// - 행정구역(AdministrativeDivision): 국가 내 행정 단위
///   • 계층적 구조 (도 > 시 > 구 등)
///   • 국가별 맞춤 설정 가능
///   • 지역별 명칭 및 의미 정보
/// 
/// - 도시(City): 주요 도시 정보
///   • 인구, 면적 통계
///   • 행정구역과의 연결
///   • 기업 시설, 조직 본부 등의 위치 기준
/// 
/// 특징:
/// - 현대 지정학적 실체 중심
/// - 역사적 국가(historical.prisma)와 구분
/// - 다양한 도메인의 지리적 앵커 역할

// ========================
// Country
// ========================
model Country {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 국가명 (표시용 단축명)
  name String @unique @db.VarChar(100)

  /// 공식/전체 명칭 (예: 대한민국, 일본국, Republic of Korea — ** 공화국 등)
  fullName String? @map("full_name") @db.VarChar(150)

  /// 로컬 국가명
  localName String? @map("local_name") @db.VarChar(100)

  /// 국기 이모지
  flagEmoji String? @map("flag_emoji") @db.VarChar(10)

  /// ISO 코드
  isoCode String? @unique @map("iso_code") @db.VarChar(10)

  /// 인구
  population BigInt? @db.BigInt

  /// 면적
  areaSqKm Decimal? @map("area_sq_km") @db.Decimal(15, 2)

  /// 썸네일
  thumbnailUrl String? @map("thumbnail_url") @db.VarChar(255)

  /// 수도
  capital String? @db.VarChar(100)

  /// 위도 (수도 또는 중심부)
  latitude Decimal? @db.Decimal(10, 7)

  /// 경도 (수도 또는 중심부)
  longitude Decimal? @db.Decimal(10, 7)

  /// 인물 표시명 기본 순서 (성·이름 / 이름·성). null이면 동양식(성+이름) 취급
  defaultNameDisplayOrder NameDisplayOrder? @map("default_name_display_order")

  //--- 외래키
  currencyId  String? @map("currency_id") @db.Char(36)
  languageId  String? @map("language_id") @db.Char(36)
  continentId String? @map("continent_id") @db.Char(36)

  //--- 관계 필드
  currency  Currency?  @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  language  Language?  @relation(fields: [languageId], references: [id], onDelete: SetNull)
  continent Continent? @relation(fields: [continentId], references: [id], onDelete: SetNull)

  records                   CountryRecord[]
  exportsImports            ExportImport[]
  /// 교역 품목에서 '상대국'으로 지목된 행들 (자국의 교역 자료가 아니다)
  tradeItemPartnerOf        ExportImportItem[]               @relation("TradeItemPartnerCountry")
  economicIndicators        CountryEconomicIndicator[]
  demographicIndicators     CountryDemographicIndicator[]
  developmentIndicators     CountryDevelopmentIndicator[]
  /// 연도·만기별 국채 금리 (한 해에 만기 수만큼 행이 선다)
  bondYields                CountryBondYield[]
  ethnicities               Ethnicity[]  @relation("CountryEthnicities")
  persons                   Person[]                         @relation("CountryToPerson")
  personAffiliations        PersonCountryAffiliation[]       @relation("PersonCountryAffiliations")
  personGroups              PersonGroup[]                    @relation("CountryPersonGroups")
  adminDivisionConfigs      CountryAdminDivisionConfig[]
  adminDivisionSchemes      AdminDivisionScheme[]            @relation("CountryAdminDivisionSchemes")
  administrationDepartments AdministrationDepartment[]       @relation("Country_Department")
  /// 이 국가에만 적용되는 관직 정의 스코프 (없으면 그 정의는 전역)
  positionDefinitionScopes  GovernmentPositionDefinitionScope[] @relation("CountryPositionDefinitionScopes")
  historicalConnections     HistoricalCountryModernCountry[]
  /// 이 나라 자격으로 사건에 참여한 인물(PersonEvent.countryId)
  personEventParticipations PersonEvent[] @relation("PersonEventCountry")
  /// 건국·멸망 주체로 지목된 역사 국가 (예: 대한민국이 세운 임시정부 등)
  statehoodAgentOf          HistoricalCountryStatehoodAgent[] @relation("StatehoodAgentCountry")
  Law                       Law[]
  groundVehicles            GroundVehicle[]
  aircraft                  Aircraft[]
  navalVessels              NavalVessel[]
  militaryUnits             MilitaryUnit[]
  socialPhenomena           SocialPhenomenon[]
  Organizations             Organization[]                   @relation("OrganizationCountry")
  organizationMemberships   OrganizationCountryMembership[]  @relation("OrgMembershipCountry")
  PoliticalParty            PoliticalParty[]                 @relation("PoliticalPartyCountry")
  electoralDistricts      ElectoralDistrict[]              @relation("ElectoralDistrictCountry")
  elections                 Election[]                       @relation("ElectionCountry")
  governmentTenures         GovernmentPositionTenure[]       @relation("TenureCountry")
  politicalSystems          PoliticalSystem[]                @relation("CountryPoliticalSystems")
  eventCountryRelations     EventCountryRelation[]
  territoryTransfersFrom    EventTerritoryTransfer[] @relation("TerritoryTransferFromCountry")
  territoryTransfersTo      EventTerritoryTransfer[] @relation("TerritoryTransferToCountry")

  // 🆕 정규화된 군사 사건 관계
  treatySignatories    TreatySignatory[]
  allianceMembers      AllianceMember[]

  // 🆕 왕조 통치 관계
  /// 이 국가를 통치한/통치하는 왕조들의 역사 (입헌군주제 등)
  dynastyRules DynastyModernRule[] @relation("CountryDynastyRules")

  /// 용어 사전 (본문 문구·관직 설명)
  glossaryTerms GlossaryTerm[] @relation("GlossaryTermCountry")

  /// 자연 지리(산·강·호수·해안) 및 인프라(고속도로·철도·공항·항구)
  naturalFeatures NaturalFeature[]
  infrastructures Infrastructure[]

  //--- 등록 계정 (개인 정보 플랫폼)
  accountId String? @map("account_id") @db.Char(36)
  account   Account? @relation("AccountCountries", fields: [accountId], references: [id], onDelete: SetNull)

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  /// 마지막 수정 일시
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([accountId], name: "idx_country_accountId")
  @@index([currencyId], name: "idx_country_currencyId")
  @@index([languageId], name: "idx_country_languageId")
  @@index([continentId], name: "idx_country_continentId")
  @@map("country")
}

// ========================
// CountryRecord
// ========================
model CountryRecord {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 국가 ID
  countryId String @map("country_id") @db.Char(36)

  /// 기록 내용
  description String @db.Text

  /// 기록 시점
  recordedAt DateTime @default(now()) @map("recorded_at")

  //--- 관계 필드
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@index([countryId], name: "idx_country_record_countryId")
  @@map("country_record")
}

// ========================
// AdminDivisionScheme (행정구역 체계 — 시기별 편제)
// ========================
/// 한 국가의 행정구역 편제 단위 (예: 조선 팔도제 1413–1895, 23부제 1895–1896, 13도제 1896–1910).
/// 구역·단위 설정이 체계에 소속되어 시기별 등록과 국가 간 비교의 기준이 된다.
/// 현대 국가(countryId) 또는 역사적 국가(historicalCountryId) 소속 — 둘 중 하나만 설정.
model AdminDivisionScheme {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 현대 국가 ID
  countryId String? @map("country_id") @db.Char(36)

  /// 역사적 국가 ID
  historicalCountryId String? @map("historical_country_id") @db.Char(36)

  /// 체계 이름 (예: 팔도제, 13도제, 50주 체제)
  name String @db.VarChar(100)

  /// 설명
  description String? @db.Text

  /// 시행 시작일 (NULL이면 미상)
  startDate DateTime? @map("start_date")

  /// 시행 종료일 (NULL이면 현행)
  endDate DateTime? @map("end_date")

  //--- 관계 필드
  country           Country?           @relation("CountryAdminDivisionSchemes", fields: [countryId], references: [id], onDelete: Cascade)
  historicalCountry HistoricalCountry? @relation("HistoricalCountryAdminDivisionSchemes", fields: [historicalCountryId], references: [id], onDelete: Cascade)
  divisions         AdministrativeDivision[]
  configs           CountryAdminDivisionConfig[]

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([countryId], name: "idx_admin_div_scheme_countryId")
  @@index([historicalCountryId], name: "idx_admin_div_scheme_historicalCountryId")
  @@map("admin_division_scheme")
}

// ========================
// CountryAdminDivisionConfig
// ========================
/// 현대 국가(countryId) 또는 역사적 국가(historicalCountryId) 소속 — 둘 중 하나만 설정.
model CountryAdminDivisionConfig {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 현대 국가 ID
  countryId String? @map("country_id") @db.Char(36)

  /// 역사적 국가 ID (조선 팔도의 '도' 등)
  historicalCountryId String? @map("historical_country_id") @db.Char(36)

  /// 소속 체계 (시기별 편제). NULL이면 체계 공용
  schemeId String? @map("scheme_id") @db.Char(36)

  /// 행정구역 레벨
  divisionLevel Int @map("division_level")

  /// 행정구역 명칭 (예: 도, 주, 현 등)
  divisionLabel String @map("division_label") @db.VarChar(50)

  /// 설명
  description String?

  //--- 관계 필드
  country                 Country?                 @relation(fields: [countryId], references: [id], onDelete: Restrict)
  historicalCountry       HistoricalCountry?       @relation("AdminDivConfigHistoricalCountry", fields: [historicalCountryId], references: [id], onDelete: Restrict)
  scheme                  AdminDivisionScheme?     @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  administrativeDivisions AdministrativeDivision[]

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 같은 레벨에 복수 단위 타입 허용 (예: 미국 2차 = 카운티 + 통합시(NYC) + 독립시).
  // 유일성은 (국가, 체계, 레벨, 라벨)까지 봐야 동일 레벨의 서로 다른 단위가 공존 가능.
  // 체계가 다르면 같은 레벨·같은 라벨도 별개(팔도제 1차=도 vs 23부제 1차=부).
  // schemeId NULL(공용)의 (레벨,라벨) 중복은 서비스 레이어 dup 체크가 막는다 (MySQL unique는 NULL 중복 허용).
  @@unique([countryId, schemeId, divisionLevel, divisionLabel])
  @@unique([historicalCountryId, schemeId, divisionLevel, divisionLabel])
  @@index([historicalCountryId], name: "idx_admin_div_config_historicalCountryId")
  @@index([schemeId], name: "idx_admin_div_config_schemeId")
  @@map("country_admin_division_config")
}

// ========================
// AdministrativeDivision
// ========================
model AdministrativeDivision {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 명칭
  name String @db.VarChar(100)

  /// 로컬 명칭
  localName String? @map("local_name") @db.VarChar(100)

  /// 명칭 뜻
  nameMeaning String? @map("name_meaning") @db.Text

  /// 현대 국가 ID (역사적 국가 소속이면 null)
  countryId String? @map("country_id") @db.Char(36)

  /// 역사적 국가 ID (조선 팔도 등. 현대 국가 소속이면 null)
  historicalCountryId String? @map("historical_country_id") @db.Char(36)

  /// 국가별 지방자치단체 구성 ID
  adminDivisionId String @map("admin_division_id") @db.Char(36)

  /// 소속 체계 (시기별 편제 — 예: 팔도제). NULL이면 체계 미지정
  schemeId String? @map("scheme_id") @db.Char(36)

  /// 상위 행정구역 ID
  parentId String? @map("parent_id") @db.Char(36)

  /// 중심 좌표 — 위도
  centerLat Decimal? @map("center_lat") @db.Decimal(9, 6)

  /// 중심 좌표 — 경도
  centerLng Decimal? @map("center_lng") @db.Decimal(9, 6)

  /// 설립일 (구역 신설·승격일)
  establishedDate DateTime? @map("established_date")

  /// 폐지일 (통합·폐지일)
  abolishedDate DateTime? @map("abolished_date")

  /// 이전 행정구역 ID (분리·승격 전 모체)
  predecessorId String? @map("predecessor_id") @db.Char(36)

  //--- 관계 필드
  historicalCountry   HistoricalCountry?         @relation("AdminDivHistoricalCountry", fields: [historicalCountryId], references: [id], onDelete: Cascade)
  scheme              AdminDivisionScheme?       @relation(fields: [schemeId], references: [id], onDelete: SetNull)
  parent              AdministrativeDivision?    @relation("AdminDivHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children            AdministrativeDivision[]   @relation("AdminDivHierarchy")
  adminDivisionConfig CountryAdminDivisionConfig @relation(fields: [adminDivisionId], references: [id], onDelete: Restrict)
  predecessor         AdministrativeDivision?    @relation("AdminDivSuccession", fields: [predecessorId], references: [id], onDelete: SetNull)
  successors          AdministrativeDivision[]   @relation("AdminDivSuccession")

  homeTown        HomeTown[]
  cities          City[]
  event           Event[]
  CompanyFacility CompanyFacility[]
  personsBornHere Person[]          @relation("PersonBirthAdminDivision")
  personsDiedHere Person[]          @relation("PersonDeathAdminDivision")

  /// 이 행정구역을 서명 장소 DB로 둔 조약
  treatiesSignedHere Treaty[] @relation("TreatySigningAdminDivision")

  /// 선거구·선거 적용 범위와 연결
  electoralDistricts ElectoralDistrict[] @relation("ElectoralDistrictAdminDiv")
  electionsInScope   Election[]          @relation("ElectionScopeAdminDiv")

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// 서술 섹션 (제목 있는 다중 본문 — 사건의 EventSection과 동일 패턴)
  sections AdministrativeDivisionSection[]

  @@index([countryId], name: "idx_admin_div_countryId")
  @@index([historicalCountryId], name: "idx_admin_div_historicalCountryId")
  @@index([schemeId], name: "idx_admin_div_schemeId")
  @@index([parentId], name: "idx_admin_div_parentId")
  @@index([adminDivisionId], name: "idx_admin_div_typeId")
  @@index([predecessorId], name: "idx_admin_div_predecessorId")
  @@map("administrative_division")
}

// ========================
// AdministrativeDivisionSection (행정구역 서술 섹션)
// ========================
/// 행정구역의 제목 있는 서술 섹션 — 역사·지리·행정 변천 등을 장(章) 단위로 서술.
/// 수정은 EventSection과 동일하게 전체 배열 delete-and-recreate.
model AdministrativeDivisionSection {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 행정구역 FK
  administrativeDivisionId String                 @map("administrative_division_id") @db.Char(36)
  administrativeDivision   AdministrativeDivision @relation(fields: [administrativeDivisionId], references: [id], onDelete: Cascade)

  /// 섹션 제목
  title String @db.VarChar(500)

  /// 섹션 내용 (리치 텍스트 HTML)
  content String @db.Text

  /// 표시 순서
  order Int @default(0)

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([administrativeDivisionId, order], name: "idx_admin_div_section_divId_order")
  @@map("administrative_division_section")
}

// ========================
// City
// ========================
model City {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 국가 ID
  countryId String @map("country_id") @db.Char(36)

  /// 행정구역 ID
  administrativeDivisionId String? @map("administrative_division_id") @db.Char(36)

  /// 도시명
  name String @db.VarChar(100)

  /// 인구
  population BigInt?

  /// 면적
  areaSqKm Decimal? @map("area_sq_km") @db.Decimal(15, 2)

  //--- 관계 필드
  administrativeDivision AdministrativeDivision? @relation(fields: [administrativeDivisionId], references: [id], onDelete: Cascade)
  hometown               HomeTown[]
  CompanyFacility        CompanyFacility[]
  Event                  Event[]
  Organizations          Organization[]          @relation("OrganizationHeadquartersCity")
  PoliticalParty         PoliticalParty[]        @relation("PoliticalPartyHeadquartersCity")
  personsBornHere        Person[]                @relation("PersonBirthCity")
  personsDiedHere        Person[]                @relation("PersonDeathCity")

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([countryId], name: "idx_city_countryId")
  @@index([administrativeDivisionId], name: "idx_city_adminDivId")
  @@map("city")
}

// ========================
// AdministrationDepartmentCategory (전세계 공통 부처 카테고리: 국방·외교·재정 등)
// ========================
model AdministrationDepartmentCategory {
  id String @id @default(uuid()) @db.Char(36)

  name   String  @db.VarChar(80)
  nameEn String? @map("name_en") @db.VarChar(80)

  departments         AdministrationDepartment[]
  positionDefinitions GovernmentPositionDefinition[] @relation("CategoryPositionDefinitions")

  @@unique([name], name: "uniq_admin_dept_category_name")
  @@map("administration_department_category")
}

// ========================
// AdministrationDepartment (국가 기관)
// ========================
/// 국가 기관의 종류 — 같은 '국방' 분류 안에서도 국방부와 최고사령부는 다른 것이다.
/// 2026-11-08 재설계: OKW(국방군 최고사령부)·OHL·스타프카·대본영을 '국방부'와 구별할 칸이 없었다.
enum AdministrationDepartmentKind {
  /// 부처 — 부·성·조·인민위원부 (외무부, 대장성, 이조, 전쟁부)
  MINISTRY
  /// 외청·위원회·독립기관 — 청·처·원·위원회 (국정원, 감사원, 중앙정보국)
  AGENCY
  /// 군 최고사령부·참모본부 — 국가의 군령 기관 (OKW, OHL, 스타프카, 대본영). 야전 편제는 MilitaryUnit
  MILITARY_COMMAND
  /// 총독부·속령 통치기관 (조선총독부, 인도 정청, 폴란드 총독부의 행정청)
  COLONIAL_GOVERNMENT
  /// 궁내·왕실 기관 (궁내부, 궁내성, 내무반)
  ROYAL_HOUSEHOLD
  /// 기타
  OTHER
}

/// 국가 기관 — 부처·외청·군 최고사령부·총독부·궁내 기관.
///
/// 경계 규칙(2026-11-08): **국가 기관은 여기**(최고사령부·총독부 포함). 국가 밖 단체·국제기구·군사동맹은
/// Organization, 야전 편제(집단군·사단)는 MilitaryUnit, 특정 시점의 구성원 명단은 PersonGroup.
///
/// 국가 소속 — 현대(countryId)·역사(historicalCountryId) 듀얼 FK. 상호배타 아님: 둘 다 설정 가능하며
/// countryId는 표시/그룹핑 축, historicalCountryId는 소속 축이라 의미가 다르다. 도출·표시는 역사 우선.
/// 역사 기관은 historicalCountryId 필수 + 현대 국가 dual-fill(현대 국가 상세에 노출되도록).
///
/// 이름(name)에는 나라 이름을 넣지 않는다('미국 국방부' ✗ → '국방부' + 나라 칩). 원어명·영문명·약칭은 별도 칸.
/// 설립·폐지일은 구조화(era/연/월/일)가 진실 — DateTime은 서기 1000~9999만 서버가 파생(정렬·레거시 호환용).
/// 개편 이력은 successor 1칸이 아니라 AdministrationDepartmentTransition(개칭·통합·분리·개편·흡수) 그래프.
model AdministrationDepartment {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 현대 국가 ID (표시/그룹핑용. 역사적 국가 기관도 연결된 현대 국가를 넣는다)
  countryId String? @map("country_id") @db.Char(36)

  /// 역사적 국가 ID (조선의 6조, 나치 독일의 OKW 등). null이면 현대 국가 기관만 해당
  historicalCountryId String? @map("historical_country_id") @db.Char(36)

  /// 상위 기관 ID (OKW → 국방군 지휘참모부). 순환 금지(서버 검증)
  parentId String? @map("parent_id") @db.Char(36)

  /// 전세계 공통 카테고리 (국방·외교·재정·경제 등)
  categoryId String? @map("category_id") @db.Char(36)

  /// 기관 종류
  kind AdministrationDepartmentKind @default(MINISTRY)

  /// 기관명 (한국어, 나라 이름 없이)
  name String @db.VarChar(100)

  /// 원어명 (Oberkommando der Wehrmacht, 外務省)
  nameLocal String? @map("name_local") @db.VarChar(200)

  /// 영문명 (High Command of the Armed Forces)
  nameEn String? @map("name_en") @db.VarChar(200)

  /// 약칭 (OKW, OHL, NKVD, CIA) — 검색 대상
  abbreviation String? @db.VarChar(40)

  /// 썸네일 이미지 URL
  thumbnailUrl String? @map("thumbnail_url") @db.VarChar(255)

  /// 일반 설명 (소개, 연혁 등 — 리치 텍스트·긴 소개 허용)
  description String? @db.Text

  /// 설립일 — 구조화(진실). 기원전·고대·연 단위 지원
  establishedEra       Era?    @map("established_era")
  establishedYear      Int?    @map("established_year")
  establishedMonth     Int?    @map("established_month")
  establishedDay       Int?    @map("established_day")
  /// 'year' | 'month' | 'day' — 서버가 구조화 값에서 파생
  establishedPrecision String? @map("established_precision") @db.VarChar(10)

  /// 폐지일 — 구조화(진실). NULL이면 현존
  abolishedEra       Era?    @map("abolished_era")
  abolishedYear      Int?    @map("abolished_year")
  abolishedMonth     Int?    @map("abolished_month")
  abolishedDay       Int?    @map("abolished_day")
  abolishedPrecision String? @map("abolished_precision") @db.VarChar(10)

  /// 설립일 DateTime — 서기 1000~9999 완전일자만 서버가 파생(정렬·레거시 호환). 직접 쓰지 말 것
  establishedDate DateTime? @map("established_date")

  /// 폐지일 DateTime — 서버 파생. 직접 쓰지 말 것
  abolishedDate DateTime? @map("abolished_date")

  //--- 관계 필드
  /// 현대 국가가 지워져도 기관은 남긴다(역사국가 축이 있으면 그대로 보인다)
  country            Country?                       @relation("Country_Department", fields: [countryId], references: [id], onDelete: SetNull)
  historicalCountry  HistoricalCountry?             @relation("DeptHistoricalCountry", fields: [historicalCountryId], references: [id], onDelete: SetNull)
  /// 상위 기관 삭제는 하위 기관이 있으면 막는다(예전 Cascade는 하위 기관을 소리 없이 함께 지웠다)
  parent             AdministrationDepartment?      @relation("DeptHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           AdministrationDepartment[]     @relation("DeptHierarchy")
  category           AdministrationDepartmentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// 이 기관이 앞선 기관인 계보(→ 후신)
  successorTransitions   AdministrationDepartmentTransition[] @relation("DeptTransitionPredecessor")
  /// 이 기관이 뒤 기관인 계보(전신 →)
  predecessorTransitions AdministrationDepartmentTransition[] @relation("DeptTransitionSuccessor")
  /// 이 기관이 관여한 사건(발령·수령·주체·관여)
  eventRelations     EventDepartmentRelation[]
  /// 이 기관 소속으로 등록된 재임 기록 (역대 장관 조회)
  tenures            GovernmentPositionTenure[]     @relation("TenureDepartment")
  /// 군사 부대(MilitaryUnit)와 1:N 연결 — 국방부·최고사령부 산하 부대
  militaryUnits      MilitaryUnit[]                 @relation("DeptMilitaryUnits")

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([countryId], name: "idx_admin_dept_countryId")
  @@index([historicalCountryId], name: "idx_admin_dept_historicalCountryId")
  @@index([parentId], name: "idx_admin_dept_parentId")
  @@index([categoryId], name: "idx_admin_dept_categoryId")
  @@index([kind], name: "idx_admin_dept_kind")
  @@index([establishedDate], name: "idx_admin_dept_establishedDate")
  @@map("administration_department")
}

// ========================
// AdministrationDepartmentTransition (국가 기관 계보)
// ========================
/// 기관이 다른 기관으로 이어진 방식.
enum DepartmentTransitionKind {
  /// 개칭 — 같은 기관의 이름만 바뀜 (외무부 → 외교통상부)
  RENAME
  /// 통합 — 여럿이 하나로 (전쟁부 + 해군부 → 국방부). 앞 기관마다 한 줄씩
  MERGE
  /// 분리 — 하나가 여럿으로. 뒤 기관마다 한 줄씩
  SPLIT
  /// 개편 — 권한·조직이 바뀌며 새 기관으로 (전쟁부 → OKW, 안기부 → 국정원)
  REORGANIZE
  /// 흡수 — 폐지되며 기능이 다른 기관으로 넘어감
  ABSORBED
}

/// 국가 기관 계보 — A → B. successor 1칸으로는 통합·분리를 표현할 수 없어 그래프로 둔다(2026-11-08).
model AdministrationDepartmentTransition {
  id String @id @default(uuid()) @db.Char(36)

  /// 앞 기관
  predecessorId String @map("predecessor_id") @db.Char(36)
  /// 뒤 기관
  successorId String @map("successor_id") @db.Char(36)

  kind DepartmentTransitionKind

  /// 이어진 시점(구조화) — 보통 뒤 기관의 설립일과 같지만 다를 수 있다
  era   Era? @map("era")
  year  Int? @map("year")
  month Int? @map("month")

  note String? @db.Text

  predecessor AdministrationDepartment @relation("DeptTransitionPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   AdministrationDepartment @relation("DeptTransitionSuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([predecessorId, successorId], name: "uniq_admin_dept_transition_pair")
  @@index([successorId], name: "idx_admin_dept_transition_successorId")
  @@map("administration_department_transition")
}
