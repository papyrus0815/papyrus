/// ║                           EVENT MILITARY DOMAIN                            ║
/// ╚══════════════════════════════════════════════════════════════════════════════╝
/// 
/// 이 도메인은 군사 사건의 상세 정보를 정규화된 테이블 구조로 관리합니다.
/// 
/// 주요 모델:
/// - EventSide: 사건 진영 (전쟁 전용 아님)
/// - Treaty: 조약
/// - Alliance: 동맹
/// - MilitaryDetailsNorm: 군사 상세 정보

// ========================
// 사건 진영 (EventSide) — 전쟁 전용 아님
// ========================
/// 사건의 '편' — 교전 진영, 조약 협상의 양측, 내전의 파벌, 선거의 진영까지 같은 모델.
/// 설계: docs/event-detail-data-foundation.md D1. 예전 이름 BelligerentSide(belligerent_side).
///
/// 진영은 참여자를 **묶는 층**이다. 참여 한 줄은 여전히 하나 — 참여국(EventCountryRelation)·
/// 참여 인물(PersonEvent)·참여 조직(EventOrganizationRelation)이 sideId로 이 진영을 가리킨다.
/// 그래서 '이 나라는 이 사건에서 무슨 배역이고 어느 편인가'가 한 행에 있다(두 번 입력하지 않는다).
model EventSide {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 사건 FK
  eventId String @map("event_id") @db.Char(36)
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// 진영명 (예: 연합군, 추축국, 로마 측)
  name String @db.VarChar(100)

  /// 진영 레벨
  level SideLevel? @default(COALITION)

  /// 진영 설명
  description String? @db.Text

  /// 결과 — 이 진영에게 이 사건은 어떻게 끝났나(승리·패배…). null = 미기록
  outcome SideOutcome?
  /// 결과 한마디 — '결정적 승리', '전술적 패배·전략적 승리' 같은 단서
  outcomeNote String? @map("outcome_note") @db.Text

  /// 진영별 작전 목표·전략·전술·첩보·보급 대칭 서술 (추축국의 전격전 계획 vs 소련군의 종심방어·첩보 오판 등 양측 대칭 비교)
  objective    String? @db.Text
  strategy     String? @db.Text
  tactics      String? @db.Text
  intelligence String? @db.Text
  logistics    String? @db.Text

  /// 상위 진영 FK (하위 사건인 경우 상위 사건의 진영 참조)
  parentSideId String?    @map("parent_side_id") @db.Char(36)
  parentSide   EventSide? @relation("SideHierarchy", fields: [parentSideId], references: [id], onDelete: SetNull)
  childSides   EventSide[] @relation("SideHierarchy")

  /// 영구 등록된 인물 묶음·계파 FK (예: 지롱드파, 산악파, 노론, 소론 등 PersonGroup 연결)
  personGroupId String?      @map("person_group_id") @db.Char(36)
  personGroup   PersonGroup? @relation("EventSidePersonGroup", fields: [personGroupId], references: [id], onDelete: SetNull)

  /// 색상 코드 (UI용)
  color String? @db.VarChar(7)

  /// 표시 순서
  sortOrder Int @default(0) @map("sort_order")

  /// 이 진영의 참여국 줄
  participants  EventCountryRelation[]
  /// 이 진영의 참여 인물
  persons       PersonEvent[]
  /// 이 진영의 참여 조직
  organizations    EventOrganizationRelation[]
  /// 이 진영의 참여 정당
  politicalParties EventPoliticalPartyRelation[]

  /// 투입 부대 목록 (군사 확장)
  deployedUnits SideDeployedUnit[]

  /// 사용 무기/장비 목록 (군사 확장)
  weaponsUsed SideWeapon[]

  /// 이 진영의 지도 기동 축선·포위망·전선 피처
  mapFeatures EventMapFeature[] @relation("EventSideMapFeatures")

  /// 이 진영에 귀속된 지리·인프라·기후·자원·법령·사회현상 맥락 연결
  contextLinks EventContextLink[] @relation("EventSideContextLinks")

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([eventId, sortOrder], name: "idx_event_side_eventId")
  @@index([parentSideId], name: "idx_event_side_parentSideId")
  @@index([personGroupId], name: "idx_event_side_personGroupId")
  @@map("event_side")
}

// ========================
// 조약 (독립 엔티티 — Event 종속 제거)
// ========================
model Treaty {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 조약명 (예: 독소 불가침 조약)
  name String @db.VarChar(200)

  /// 조약 별칭 (예: 몰로토프-리벤트로프 조약)
  alias String? @db.VarChar(200)

  /// 조약 타입
  type TreatyType

  /// 서명일
  signDate DateTime @map("sign_date")

  /// 발효일
  effectiveDate DateTime? @map("effective_date")

  /// 만료일
  expiryDate DateTime? @map("expiry_date")

  /// 파기/위반일
  violationDate DateTime? @map("violation_date")

  /// 파기/종료 사유
  violationReason String? @map("violation_reason") @db.VarChar(500)

  /// 서명 장소 (자유 텍스트, 상세)
  location String? @db.VarChar(300)

  /// 서명 장소 행정구역 (선택, DB 행정구역 마스터)
  signingAdministrativeDivisionId String? @map("signing_administrative_division_id") @db.Char(36)
  signingAdministrativeDivision     AdministrativeDivision? @relation("TreatySigningAdminDivision", fields: [signingAdministrativeDivisionId], references: [id], onDelete: SetNull)

  /// 개요
  summary String? @db.Text

  /// 상세 배경
  background String? @db.Text

  /// 주요 결과/여파
  aftermath String? @db.Text

  /// 등록한 계정
  accountId String? @map("account_id") @db.Char(36)
  account   Account? @relation("AccountTreaties", fields: [accountId], references: [id], onDelete: SetNull)

  /// 서명국/참여국 목록
  signatories TreatySignatory[]

  /// 조약 조항 목록
  terms TreatyTerm[]

  /// 이미지 목록
  images TreatyImage[]

  /// 이 조약이 연 교역 흐름 (강화도조약 ↔ 부산 개항 무역)
  tradeFlows ExportImportItem[] @relation("TradeFlowTreaty")

  /// 이 조약이 걸린 사건 (체결 사건·비준 사건·파기 사건은 서로 다른 행)
  eventLinks TreatyEventLink[]

  /// 이 조약을 근거로 한 영토 이전
  territoryTransfers EventTerritoryTransfer[] @relation("TerritoryTransferTreaty")

  /// 이 조약을 종전·휴전 근거로 삼는 선전포고·개전 기록
  endedWarDeclarations WarDeclaration[] @relation("WarDeclarationPeaceTreaty")

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([signDate], name: "idx_treaty_signDate")
  @@index([type], name: "idx_treaty_type")
  @@index([accountId], name: "idx_treaty_accountId")
  @@index([signingAdministrativeDivisionId], name: "idx_treaty_signingAdminDivId")
  @@map("treaty")
}

// ========================
// 조약 ↔ 사건 연결
//
// 단일 FK(Treaty.eventId)가 아니라 링크표인 이유: Treaty에 이미 effectiveDate·
// violationDate가 있고, 체결·비준·파기는 각각 **다른 사건**이다. 하나의 조약이
// 여러 사건에 서로 다른 자격으로 걸린다. (event_parent_link와 같은 모양)
// ========================
model TreatyEventLink {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 조약 FK
  treatyId String @map("treaty_id") @db.Char(36)
  treaty   Treaty @relation(fields: [treatyId], references: [id], onDelete: Cascade)

  /// 사건 FK
  eventId String @map("event_id") @db.Char(36)
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// 연결 성격 (체결/비준/파기/기타)
  linkType TreatyEventLinkType @default(SIGNING) @map("link_type")

  /// 연결 사유·메모
  note String? @db.Text

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// 같은 조약·사건 쌍이 같은 자격으로 두 번 걸리지 않는다.
  /// (세 컬럼 모두 NOT NULL이라 MySQL에서도 유니크가 실제로 걸린다)
  @@unique([treatyId, eventId, linkType], name: "uq_treaty_event_link")
  @@index([eventId], name: "idx_treaty_event_link_eventId")
  @@map("treaty_event_link")
}

// ========================
// 조약 서명국/참여국
// ========================
model TreatySignatory {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 조약 FK
  treatyId String @map("treaty_id") @db.Char(36)
  treaty   Treaty @relation(fields: [treatyId], references: [id], onDelete: Cascade)

  /// 현대 국가 FK
  countryId String?  @map("country_id") @db.Char(36)
  country   Country? @relation(fields: [countryId], references: [id], onDelete: Cascade)

  /// 역사적 국가 FK
  historicalCountryId String?            @map("historical_country_id") @db.Char(36)
  historicalCountry   HistoricalCountry? @relation(fields: [historicalCountryId], references: [id], onDelete: Cascade)

  /// 서명 인물 FK (예: 몰로토프, 리벤트로프)
  personId String?  @map("person_id") @db.Char(36)
  person   Person?  @relation("TreatySignatoryPerson", fields: [personId], references: [id], onDelete: SetNull)

  /// 소속 행정부 FK (예: 스탈린 행정부)
  cabinetId String?  @map("cabinet_id") @db.Char(36)
  cabinet   Cabinet? @relation("TreatySignatoryCabinet", fields: [cabinetId], references: [id], onDelete: SetNull)

  /// 서명자 역할/직책 (예: 외무인민위원, 외무장관) — 직접 입력
  role String? @db.VarChar(200)

  /// 행정부 관직 정의 (GovernmentPositionDefinition, 선택)
  positionDefinitionId String?                       @map("position_definition_id") @db.Char(36)
  positionDefinition   GovernmentPositionDefinition? @relation(fields: [positionDefinitionId], references: [id], onDelete: SetNull)

  /// 서명 당시 재임 기록 (GovernmentPositionTenure, 선택 — 몰로토프·리벤트로프·카이텔 등 당시 직위 정본 연결)
  tenureId String?                   @map("tenure_id") @db.Char(36)
  tenure   GovernmentPositionTenure? @relation("TreatySignatoryTenure", fields: [tenureId], references: [id], onDelete: SetNull)

  /// 참여 유형 (서명국, 보증국, 조정국 등)
  participationType TreatyParticipationType @default(SIGNATORY) @map("participation_type")

  /// 국가별 서명일 (조약 전체 서명일과 다를 수 있음)
  signedAt DateTime? @map("signed_at")

  /// 국내 비준 동의·심의 의회 원 (Chamber, 예: 미국 상원, 대한민국 국회)
  ratifiedChamberId  String?                   @map("ratified_chamber_id") @db.Char(36)
  ratifiedChamber    Chamber?                  @relation("TreatySignatoryRatifiedChamber", fields: [ratifiedChamberId], references: [id], onDelete: SetNull)
  /// 국내 비준 상태 (가결·부결·계류·불요)
  ratificationStatus TreatyRatificationStatus? @map("ratification_status")
  /// 비준(또는 부결) 의결일
  ratifiedAt         DateTime?                 @map("ratified_at")
  /// 비준 표결 찬성·반대 의석 수 (선택)
  ratificationYeas   Int?                      @map("ratification_yeas")
  ratificationNays   Int?                      @map("ratification_nays")

  /// 비고
  note String? @db.Text

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([treatyId], name: "idx_treaty_signatory_treatyId")
  @@index([personId], name: "idx_treaty_signatory_personId")
  @@index([cabinetId], name: "idx_treaty_signatory_cabinetId")
  @@index([positionDefinitionId], name: "idx_treaty_signatory_positionDefId")
  @@index([tenureId], name: "idx_treaty_signatory_tenureId")
  @@index([ratifiedChamberId], name: "idx_treaty_signatory_ratifiedChamberId")
  @@map("treaty_signatory")
}

// ========================
// 조약 조항
// ========================
model TreatyTerm {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 조약 FK
  treatyId String @map("treaty_id") @db.Char(36)
  treaty   Treaty @relation(fields: [treatyId], references: [id], onDelete: Cascade)

  /// 조항 순번
  order Int @default(0)

  /// 조항 제목 (선택)
  title String? @db.VarChar(200)

  /// 조항 내용
  content String @db.Text

  /// 비밀 조항 여부 (예: 독소 불가침 조약 비밀의정서)
  isSecret Boolean @default(false) @map("is_secret")

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([treatyId], name: "idx_treaty_term_treatyId")
  @@map("treaty_term")
}

// ========================
// 조약 이미지
// ========================
model TreatyImage {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 조약 FK
  treatyId String @map("treaty_id") @db.Char(36)
  treaty   Treaty @relation(fields: [treatyId], references: [id], onDelete: Cascade)

  /// 이미지 URL
  imageUrl String @map("image_url") @db.VarChar(1000)

  /// 캡션
  caption String? @db.VarChar(500)

  /// 출처
  source String? @db.VarChar(500)

  /// 표시 순서
  order Int @default(0)

  /// 대표 이미지 여부
  isPrimary Boolean @default(false) @map("is_primary")

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([treatyId, isPrimary], name: "idx_treaty_image_treatyId_isPrimary")
  @@map("treaty_image")
}

// ========================
// 동맹
// ========================
model Alliance {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 사건 FK
  eventId String @map("event_id") @db.Char(36)
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// 동맹명 (예: NATO, 바르샤바 조약기구)
  name String @db.VarChar(200)

  /// 결성일
  formationDate DateTime @map("formation_date")

  /// 해체일
  dissolutionDate DateTime? @map("dissolution_date")

  /// 동맹 설명
  description String? @db.Text

  /// 가입국 목록
  members AllianceMember[]

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([eventId], name: "idx_alliance_eventId")
  @@map("alliance")
}

// ========================
// 동맹 가입국
// ========================
model AllianceMember {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 동맹 FK
  allianceId String   @map("alliance_id") @db.Char(36)
  alliance   Alliance @relation(fields: [allianceId], references: [id], onDelete: Cascade)

  /// 현대 국가 FK
  countryId String?  @map("country_id") @db.Char(36)
  country   Country? @relation(fields: [countryId], references: [id], onDelete: Cascade)

  /// 역사적 국가 FK
  historicalCountryId String?            @map("historical_country_id") @db.Char(36)
  historicalCountry   HistoricalCountry? @relation(fields: [historicalCountryId], references: [id], onDelete: Cascade)

  /// 가입일
  joinDate DateTime @map("join_date")

  /// 탈퇴일
  leaveDate DateTime? @map("leave_date")

  /// 가입 상태
  status AllianceMemberStatus

  /// 비고
  note String? @db.Text

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([allianceId], name: "idx_alliance_member_allianceId")
  @@map("alliance_member")
}

// ========================
// 군사 상세 정보 (정규화)
// ========================
model MilitaryDetailsNorm {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 사건 FK (1:1)
  eventId String @unique @map("event_id") @db.Char(36)
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// 전투 유형
  conflictType ConflictType?

  /// 목표
  objective String? @db.Text

  /// 전술
  tactics String? @db.Text

  /// 전략
  strategy String? @db.Text

  /// 결과
  outcome String? @db.Text

  /// 영토 변화
  territoryChanges String? @map("territory_changes") @db.Text

  /// 관련 조약
  treaty String? @db.Text

  /// 전략적 영향
  strategicImpact String? @map("strategic_impact") @db.Text

  /// 교전 형태 목록
  combatTypes MilitaryDetailsCombatType[]

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("military_details_norm")
}

// ========================
// 군사 상세 정보 - 교전 형태 연결
// ========================
model MilitaryDetailsCombatType {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 군사 상세 정보 FK
  militaryDetailsId String              @map("military_details_id") @db.Char(36)
  militaryDetails   MilitaryDetailsNorm @relation(fields: [militaryDetailsId], references: [id], onDelete: Cascade)

  /// 교전 형태
  combatType CombatType

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([militaryDetailsId, combatType])
  @@map("military_details_combat_type")
}

// ========================
// 진영 - 투입 부대 연결
// ========================
/// 이 작전에서 부대가 맡은 몫
enum SideUnitRole {
  /// 주공(主攻) — 결정적 타격을 맡은 축
  MAIN_EFFORT
  /// 조공(助攻)·견제
  SUPPORTING
  /// 예비
  RESERVE
  /// 수비·방어 — 공격받은 쪽의 주력 방어 부대
  DEFENSE
  /// 기타
  OTHER
}

/// 사건 진영에 투입된 야전 부대(집단군·군·군단·사단). 부대 자체(이름·계통·소속 기관)는 MilitaryUnit,
/// 이 작전에서의 몫·병력은 여기(병력 수치는 측정값 subjectType=EVENT_SIDE_UNIT, subjectId=이 행 id).
model SideDeployedUnit {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 진영 FK
  sideId String          @map("side_id") @db.Char(36)
  side   EventSide @relation(fields: [sideId], references: [id], onDelete: Cascade)

  /// 군사 유닛 FK
  militaryUnitId String       @map("military_unit_id") @db.Char(36)
  militaryUnit   MilitaryUnit @relation(fields: [militaryUnitId], references: [id], onDelete: Cascade)

  /// 작전 당시 배속 상급 부대 오버라이드(선택) — 비어 있으면 MilitaryUnit.parentUnitId 기본 편제를 따르고,
  /// 값이 있으면 이 작전에서의 직속 상급 부대로 우선 연결한다 (예: 제4기갑집단이 바르바로사 개전 시 북부집단군 → 태풍 작전 시 중부집단군 배속).
  parentUnitId String?       @map("parent_unit_id") @db.Char(36)
  parentUnit   MilitaryUnit? @relation("SideDeployedUnitParent", fields: [parentUnitId], references: [id], onDelete: SetNull)

  /// 작전 당시 부대 지휘관 오버라이드(선택) — 비어 있으면 MilitaryUnitCommander 임기에서 사건 시점 지휘관을 자동 추론하고,
  /// 값이 있으면 명시된 지휘관을 우선 표시한다.
  commanderId String? @map("commander_id") @db.Char(36)
  commander   Person? @relation("SideDeployedUnitCommander", fields: [commanderId], references: [id], onDelete: SetNull)

  /// 이 작전에서의 몫 — 주공·조공·예비·수비
  role SideUnitRole?

  /// 한 줄 메모 — '제2·제3 기갑집단을 앞세워 민스크 포위'
  note String? @db.Text

  /// 진영 안 표시 순서
  sortOrder Int @default(0) @map("sort_order")

  /// 이 투입 부대에 배속·운용된 주요 무기·장비
  weaponsUsed SideWeapon[] @relation("SideDeployedUnitWeapons")

  /// 이 투입 부대의 기동 축선·포위망·전선 지도 피처 (예: 제2기갑집단 민스크-스몰렌스크 돌파 축선)
  mapFeatures EventMapFeature[] @relation("SideDeployedUnitMapFeatures")

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([sideId, militaryUnitId])
  @@index([parentUnitId], name: "idx_side_deployed_unit_parentUnitId")
  @@index([commanderId], name: "idx_side_deployed_unit_commanderId")
  @@map("side_deployed_unit")
}

// ========================
// 진영 - 사용 무기 연결
// ========================
model SideWeapon {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 진영 FK
  sideId String    @map("side_id") @db.Char(36)
  side   EventSide @relation(fields: [sideId], references: [id], onDelete: Cascade)

  /// 특정 투입 부대에 배속된 장비인 경우 연결 (선택 — 비어 있으면 진영 전체 사용 장비)
  deployedUnitId String?           @map("deployed_unit_id") @db.Char(36)
  deployedUnit   SideDeployedUnit? @relation("SideDeployedUnitWeapons", fields: [deployedUnitId], references: [id], onDelete: SetNull)

  /// 무기 FK (Weapon, GroundVehicle, Aircraft, NavalVessel 중 하나)
  weaponId        String?        @map("weapon_id") @db.Char(36)
  weapon          Weapon?        @relation("SideWeaponToWeapon", fields: [weaponId], references: [id], onDelete: Cascade)
  groundVehicleId String?        @map("ground_vehicle_id") @db.Char(36)
  groundVehicle   GroundVehicle? @relation("SideWeaponToGroundVehicle", fields: [groundVehicleId], references: [id], onDelete: Cascade)
  aircraftId      String?        @map("aircraft_id") @db.Char(36)
  aircraft        Aircraft?      @relation("SideWeaponToAircraft", fields: [aircraftId], references: [id], onDelete: Cascade)
  navalVesselId   String?        @map("naval_vessel_id") @db.Char(36)
  navalVessel     NavalVessel?   @relation("SideWeaponToNavalVessel", fields: [navalVesselId], references: [id], onDelete: Cascade)

  /// 투입 수량 (선택, 예: 3350)
  quantity  Int?

  /// 이 작전에서 잃은 수(격파·노획·고장 포기 포함) — 정의가 다르면 메모에 밝힌다
  lost      Int?

  /// 역할 한 줄 — '주력 중형전차', '근접 항공지원'
  role      String? @db.VarChar(100)
  /// 운용 메모·비고 (예: '중부집단군 제2기갑집단 주력 전차')
  note      String? @db.Text
  /// 표시 순서
  sortOrder Int     @default(0) @map("sort_order")

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sideId, sortOrder], name: "idx_side_weapon_sideId")
  @@index([deployedUnitId], name: "idx_side_weapon_deployedUnitId")
  @@index([weaponId], name: "idx_side_weapon_weaponId")
  @@index([groundVehicleId], name: "idx_side_weapon_groundVehicleId")
  @@index([aircraftId], name: "idx_side_weapon_aircraftId")
  @@index([navalVesselId], name: "idx_side_weapon_navalVesselId")
  @@map("side_weapon")
}


/// 진영 결과 — 교전만이 아니라 협상·선거의 편에도 쓴다
enum SideOutcome {
  /// 승리
  VICTORY
  /// 패배
  DEFEAT
  /// 무승부·교착
  DRAW
  /// 철수·이탈(끝나기 전에 빠짐)
  WITHDRAWAL
  /// 결론 없음·논쟁 중
  INCONCLUSIVE
}

// ========================
// 선전포고 · 개전 정본 (국가 주권 행위 원장 — Event 종속 제거)
// ========================
/// 선전포고·개전 행위의 유형
enum WarDeclarationKind {
  /// 공식 선전포고 (개전 포고문·칙령·외교 각서 전달)
  FORMAL_DECLARATION
  /// 최후통첩 시한 만료 개전 (예: 1914·1939 영국의 대독 개전)
  ULTIMATUM_EXPIRY
  /// 동맹·상호방위 의무 참전 선언 (예: 사르데냐 참전, 삼국동맹·추축국 참전)
  ALLIANCE_ENTRY
  /// 선전포고 없는 기습·사실상 개전 (예: 1904 여순 기습, 무력 침공 개시, 사후 포고)
  UNDECLARED_HOSTILITIES
  /// 진영 전환·재참전·공동교전국 선언 (예: 1943.10 이탈리아 대독 선전포고, 1918.11 루마니아 재참전)
  CO_BELLIGERENCY
  /// 국교 단절·통첩 (개전 직전 외교 단교를 독립 기록할 때)
  DIPLOMATIC_SEVERANCE
}

/// 교전 상태 종결 방식
enum WarTerminationKind {
  /// 강화·평화 조약 발효
  PEACE_TREATY
  /// 휴전·정전 협정
  ARMISTICE
  /// 무조건 항복·항복 문서 조인
  SURRENDER
  /// 일방 국가 소멸·병합
  STATE_EXTINCTION
  /// 일방적·공동 전쟁 상태 종료 선언 (예: 1951 서방 연합국 대독 전쟁상태 종료, 1956 일소 공동선언)
  UNILATERAL_DECLARATION
  /// 법적 교전·휴전 상태 지속
  ONGOING
}

/// 국가 간 선전포고·개전 정본 1행 = "[선포국 1곳] ──▶ [대상국 1곳]" 단방향 주권 행위.
///
/// 조약(Treaty)·선거(Election)·법령(Law)과 마찬가지로 **국가 측 원장이 정본**이며,
/// 외교 비화·의회 연설·각서 전달 경위 등 서사(배경·전개·여파)가 필요한 경우에만
/// 보조 사건(`narrativeEventId`)을 선택 연결한다(다국 공동 선포 사건 1건에 여러 행이 N:1 연결 가능).
model WarDeclaration {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 선포국(개전 주체국) — 현대 국가 또는 역사적 국가 중 하나 (XOR)
  declaringCountryId           String?            @map("declaring_country_id") @db.Char(36)
  declaringCountry             Country?           @relation("WarDeclarationDeclaringCountry", fields: [declaringCountryId], references: [id], onDelete: Cascade)
  declaringHistoricalCountryId String?            @map("declaring_historical_country_id") @db.Char(36)
  declaringHistoricalCountry   HistoricalCountry? @relation("WarDeclarationDeclaringHistoricalCountry", fields: [declaringHistoricalCountryId], references: [id], onDelete: Cascade)

  /// 대상국(피선포국) — 현대 국가 또는 역사적 국가 중 하나 (XOR)
  targetCountryId           String?            @map("target_country_id") @db.Char(36)
  targetCountry             Country?           @relation("WarDeclarationTargetCountry", fields: [targetCountryId], references: [id], onDelete: Cascade)
  targetHistoricalCountryId String?            @map("target_historical_country_id") @db.Char(36)
  targetHistoricalCountry   HistoricalCountry? @relation("WarDeclarationTargetHistoricalCountry", fields: [targetHistoricalCountryId], references: [id], onDelete: Cascade)

  /// 개전 행위 유형
  kind WarDeclarationKind @default(FORMAL_DECLARATION)

  /// 고유 표시 제목 오버라이드 (비우면 '{선포국}의 대(對){대상국} 선전포고' 자동 구성)
  title String? @db.VarChar(200)

  /// 개전 명분·사유 한 줄 (예: '사라예보 사건 배후 책임 및 최후통첩 일부 거부')
  casusBelli String? @map("casus_belli") @db.VarChar(500)

  /// 국가 원장 요약·전달 경위 메모
  summary String? @db.Text

  /// 개전·선포 시점 (AD 1000+ DATETIME 거울 + BC·정밀도 안전 구조화 필드)
  declaredDate      DateTime? @map("declared_date")
  declaredEra       Era?      @map("declared_era")
  declaredYear      Int?      @map("declared_year")
  declaredMonth     Int?      @map("declared_month")
  declaredDay       Int?      @map("declared_day")
  declaredPrecision String?   @map("declared_precision") @db.VarChar(10)

  /// 외교 단교 시점 (선전포고에 앞서 국교를 먼저 끊은 경우, 선택)
  severanceEra   Era? @map("severance_era")
  severanceYear  Int? @map("severance_year")
  severanceMonth Int? @map("severance_month")
  severanceDay   Int? @map("severance_day")

  /// 국가 헌정 의사결정 주체 (내각 · 결정/서명 인물 · 재임 직위 · 승인 의회 원 및 표결)
  cabinetId         String?                   @map("cabinet_id") @db.Char(36)
  cabinet           Cabinet?                  @relation("WarDeclarationCabinet", fields: [cabinetId], references: [id], onDelete: SetNull)
  decidedByPersonId String?                   @map("decided_by_person_id") @db.Char(36)
  decidedByPerson   Person?                   @relation("WarDeclarationDecidedByPerson", fields: [decidedByPersonId], references: [id], onDelete: SetNull)
  decidedByTenureId String?                   @map("decided_by_tenure_id") @db.Char(36)
  decidedByTenure   GovernmentPositionTenure? @relation("WarDeclarationDecidedByTenure", fields: [decidedByTenureId], references: [id], onDelete: SetNull)
  approvedChamberId String?                   @map("approved_chamber_id") @db.Char(36)
  approvedChamber   Chamber?                  @relation("WarDeclarationApprovedChamber", fields: [approvedChamberId], references: [id], onDelete: SetNull)
  yeas              Int?                      @map("yeas")
  nays              Int?                      @map("nays")
  abstentions       Int?                      @map("abstentions")

  /// 상위 전쟁(Event: WAR) 연결 — 전쟁 조망의 개전·참전 도미노가 이 컬럼으로 집계된다
  warEventId String? @map("war_event_id") @db.Char(36)
  warEvent   Event?  @relation("WarDeclarationParentWar", fields: [warEventId], references: [id], onDelete: SetNull)

  /// 선행 최후통첩 사건(Event: DECLARATION 등) 연결 — '최후통첩 발송 → 거부/만료 → 개전' 외교 체인 (선택)
  ultimatumEventId String? @map("ultimatum_event_id") @db.Char(36)
  ultimatumEvent   Event?  @relation("WarDeclarationUltimatumEvent", fields: [ultimatumEventId], references: [id], onDelete: SetNull)

  /// 보조 서술 사건(Event) 연결 — 전후 외교 경위·연설·비화를 서술할 때만 선택 연결 (N:1 허용)
  narrativeEventId String? @map("narrative_event_id") @db.Char(36)
  narrativeEvent   Event?  @relation("WarDeclarationNarrativeEvent", fields: [narrativeEventId], references: [id], onDelete: SetNull)

  /// 법적·실질적 교전 상태 종결 정보 (휴전·강화조약·항복·종전선언)
  terminationKind WarTerminationKind? @map("termination_kind")
  endedDate       DateTime?           @map("ended_date")
  endedEra        Era?                @map("ended_era")
  endedYear       Int?                @map("ended_year")
  endedMonth      Int?                @map("ended_month")
  endedDay        Int?                @map("ended_day")
  endedPrecision  String?             @map("ended_precision") @db.VarChar(10)
  peaceTreatyId   String?             @map("peace_treaty_id") @db.Char(36)
  peaceTreaty     Treaty?             @relation("WarDeclarationPeaceTreaty", fields: [peaceTreatyId], references: [id], onDelete: SetNull)
  terminationNote String?             @map("termination_note") @db.VarChar(500)

  /// 등록 계정
  accountId String?  @map("account_id") @db.Char(36)
  account   Account? @relation("AccountWarDeclarations", fields: [accountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([declaringCountryId], name: "idx_war_decl_declaringCountryId")
  @@index([declaringHistoricalCountryId], name: "idx_war_decl_declaringHistCountryId")
  @@index([targetCountryId], name: "idx_war_decl_targetCountryId")
  @@index([targetHistoricalCountryId], name: "idx_war_decl_targetHistCountryId")
  @@index([warEventId], name: "idx_war_decl_warEventId")
  @@index([ultimatumEventId], name: "idx_war_decl_ultimatumEventId")
  @@index([narrativeEventId], name: "idx_war_decl_narrativeEventId")
  @@index([peaceTreatyId], name: "idx_war_decl_peaceTreatyId")
  @@index([approvedChamberId], name: "idx_war_decl_approvedChamberId")
  @@index([cabinetId], name: "idx_war_decl_cabinetId")
  @@index([decidedByPersonId], name: "idx_war_decl_decidedByPersonId")
  @@index([decidedByTenureId], name: "idx_war_decl_decidedByTenureId")
  @@index([declaredYear], name: "idx_war_decl_declaredYear")
  @@index([accountId], name: "idx_war_decl_accountId")
  @@map("war_declaration")
}
