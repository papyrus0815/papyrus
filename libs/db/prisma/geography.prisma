/// ║                              GEOGRAPHY DOMAIN                                ║
/// ╚══════════════════════════════════════════════════════════════════════════════╝
/// 
/// 이 도메인은 지구의 지리적 구분과 지역 정보를 관리합니다.
/// 
/// 주요 기능:
/// - 대륙(Continent): 세계의 대륙 구분 및 계층적 관리
///   • 면적, 인구, 국가 수 통계
///   • 타임존 정보 (JSON 형태)
///   • 상위-하위 대륙 관계 (예: 아시아 > 동아시아)
/// 
/// 특징:
/// - 국가(Country) 모델과 긴밀한 연관
/// - 계층적 구조 지원 (자기참조 관계)
/// - 통계 정보 포함으로 대시보드 활용 가능
/// - ISO 코드 표준 준수

// ========================
// Continent
// ========================
model Continent {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 대륙명
  name String @unique @db.VarChar(50)

  /// 영문명
  enName String? @unique @map("en_name") @db.VarChar(50)

  /// ISO 코드
  isoCode String? @unique @map("iso_code") @db.VarChar(5)

  /// 면적
  areaSqKm Decimal? @map("area_sq_km") @db.Decimal(15, 2)

  /// 인구
  population BigInt?

  /// 국가 수
  countryCount Int? @map("country_count")

  /// 시/분/초대 목록 (타임존)
  timeZones Json? @map("time_zones")

  /// 상위 대륙
  parentId String? @map("parent_id") @db.Char(36)

  //--- 관계 필드
  parent    Continent?  @relation("ContinentHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Continent[] @relation("ContinentHierarchy")
  countries Country[]

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([parentId], name: "idx_continent_parentId")
  @@map("continent")
}

// ========================
// NaturalFeature
// ========================
/// 자연 지리 항목 — 산·강·호수·해안을 type으로 구분.
/// 자주 쓰는 검색·정렬 필드(고도·길이·면적·보호구역 여부)는 1급 컬럼,
/// 그 외 부가 정보는 attributes JSON으로.
model NaturalFeature {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 소속 국가
  countryId String @map("country_id") @db.Char(36)

  /// 항목 유형
  type NaturalFeatureType

  /// 명칭 (한국어 또는 기본 표기)
  name String @db.VarChar(120)

  /// 현지어 명칭
  localName String? @map("local_name") @db.VarChar(120)

  /// 위치 설명 (예: "강원특별자치도", "전북/전남/경남")
  region String? @db.VarChar(120)

  /// 위도
  latitude Decimal? @db.Decimal(10, 7)

  /// 경도
  longitude Decimal? @db.Decimal(10, 7)

  /// 산 고도 (미터)
  heightM Int? @map("height_m")

  /// 길이 (km) — 강·해안
  lengthKm Decimal? @map("length_km") @db.Decimal(10, 2)

  /// 면적 (km²) — 호수
  areaSqKm Decimal? @map("area_sq_km") @db.Decimal(15, 2)

  /// 국립공원·보호구역 등록 여부
  isProtected Boolean @default(false) @map("is_protected")

  /// 부가 정보 (수원지·하구·수심·유형 등 type별 자유서식)
  attributes Json?

  //--- 관계 필드
  country           Country            @relation(fields: [countryId], references: [id], onDelete: Cascade)
  eventContextLinks EventContextLink[] @relation("EventContextNaturalFeature")

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([countryId, type], name: "idx_natural_feature_country_type")
  @@index([type], name: "idx_natural_feature_type")
  @@map("natural_feature")
}

enum NaturalFeatureType {
  mountain
  river
  lake
  coast
}

// ========================
// Infrastructure
// ========================
/// 인프라 항목 — 고속도로·철도·공항·항구를 type으로 구분.
/// 자주 쓰는 1급 필드(코드·길이·운영자·개통연도)만 컬럼으로,
/// 차로 수·역 수·이용객 등 부가 정보는 attributes JSON으로.
model Infrastructure {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 소속 국가
  countryId String @map("country_id") @db.Char(36)

  /// 항목 유형
  type InfrastructureType

  /// 명칭
  name String @db.VarChar(120)

  /// 현지어 명칭
  localName String? @map("local_name") @db.VarChar(120)

  /// 식별 코드 — 노선번호(고속도로 1번), IATA 코드(ICN), 항구코드 등
  code String? @db.VarChar(20)

  /// 위치 설명
  region String? @map("region") @db.VarChar(120)

  /// 위도
  latitude Decimal? @db.Decimal(10, 7)

  /// 경도
  longitude Decimal? @db.Decimal(10, 7)

  /// 길이 (km) — 고속도로·철도
  lengthKm Decimal? @map("length_km") @db.Decimal(10, 2)

  /// 처리능력·이용객 (자유서식, 예: "연 7천만명", "20만 TEU")
  capacity String? @db.VarChar(80)

  /// 운영 기관
  operatorName String? @map("operator_name") @db.VarChar(120)

  /// 개통 연도
  openedYear Int? @map("opened_year")

  /// 부가 정보 (차선·역수·구간 등)
  attributes Json?

  //--- 관계 필드
  country           Country            @relation(fields: [countryId], references: [id], onDelete: Cascade)
  eventContextLinks EventContextLink[] @relation("EventContextInfrastructure")

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([countryId, type], name: "idx_infrastructure_country_type")
  @@index([type], name: "idx_infrastructure_type")
  @@map("infrastructure")
}

enum InfrastructureType {
  highway
  railway
  airport
  port
}

// ========================
// Place (범용 역사·지리 장소 정본 카탈로그 — Historical Gazetteer)
// ========================
/// 도시만이 아니라 촌락·궁궐·성곽·생가터·왕릉·묘소·전장·섬·역사 권역까지 포괄하는
/// 플랫폼 단일 지리 지점 정본(Place). 기존 City(5행)를 SETTLEMENT로 단계적 흡수한다.

enum PlaceKind {
  /// 도시·읍·면·촌락 (정주지 — 기존 City 포괄)
  SETTLEMENT
  /// 구·동·가·번지 (세부 구획)
  DISTRICT
  /// 궁궐·성곽·생가·저택·관청·사찰·병원 등 특정 건물/터
  SITE
  /// 왕릉·묘소·현충원·기념관·사당
  TOMB
  /// 전장·해협·고지
  BATTLEFIELD
  /// 섬·유배지
  ISLAND
  /// 역사 권역·지방 (예: 가스코뉴, 실롱스크, 프랑켄)
  REGION
  /// 기타
  OTHER
}

enum PlaceCoordinatePrecision {
  /// 건물·생가터·능묘 정밀 핀
  EXACT
  /// 거리·동 단위
  STREET
  /// 도시·읍·촌 중심점
  SETTLEMENT
  /// 행정구역·권역 중심점
  REGION
  /// 대략 추정 위치
  APPROXIMATE
}

enum PlaceNameKind {
  /// 현대 표준 명칭
  MODERN
  /// 당대 역사 지명 (한성부, 에도, 티플리스, 엑스라샤펠)
  HISTORICAL
  /// 현지어 원문 (Mouilleron-en-Pareds, 和歌山城)
  LOCAL
  /// 로마자·영문 표기
  ROMANIZED
  /// 기타 이칭·별칭
  ALIAS
}

model Place {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 장소 스케일·성격
  kind PlaceKind @default(SETTLEMENT)

  /// 표준 대표명 (한국어 우선, 예: "와카야마성", "파리", "아헨")
  name String @db.VarChar(200)

  /// 현지어·영문 대표명 (예: "Wakayama Castle", "Aachen")
  localName String? @map("local_name") @db.VarChar(200)

  /// 현대 행정 주소·위치 설명 (예: "일본 와카야마현 와카야마시 이치반초 3")
  modernAddress String? @map("modern_address") @db.VarChar(500)

  /// 장소 해설·맥락 메모
  description String? @db.Text

  /// WGS84 위도
  latitude Decimal? @db.Decimal(10, 7)

  /// WGS84 경도
  longitude Decimal? @db.Decimal(10, 7)

  /// 좌표 정밀도
  coordinatePrecision PlaceCoordinatePrecision? @map("coordinate_precision")

  /// Google Places API 정본 ID (ChIJ... — 동일 장소 중복 생성 원천 차단)
  googlePlaceId String? @unique @map("google_place_id") @db.VarChar(255)

  /// OpenStreetMap / Nominatim 식별 키 (예: "relation:7444", "node:12345" — 무키 폴백 환경 중복 방지)
  externalKey String? @unique @map("external_key") @db.VarChar(120)

  /// 스케일별 권장 지도 기본 배율 (건물 16, 동네 14, 도시 12, 권역 8)
  defaultZoom Int? @map("default_zoom") @db.SmallInt

  /// 인구 (SETTLEMENT — City 통합용)
  population BigInt?

  /// 면적 km² (SETTLEMENT — City 통합용)
  areaSqKm Decimal? @map("area_sq_km") @db.Decimal(15, 2)

  /// 상위 장소 FK (예: 리베이라 궁 -> 리스본, 튈르리 궁 -> 파리)
  parentPlaceId String? @map("parent_place_id") @db.Char(36)

  /// 현대 소속 국가 FK (공해·국경 분쟁지 등 예외 대비 nullable)
  countryId String? @map("country_id") @db.Char(36)

  /// 역사적 국가 직접 연결 (선택)
  historicalCountryId String? @map("historical_country_id") @db.Char(36)

  /// 소속 행정구역 FK (선택)
  administrativeDivisionId String? @map("administrative_division_id") @db.Char(36)

  /// 기존 City 테이블 흡수용 1:1 브리지 키
  legacyCityId String? @unique @map("legacy_city_id") @db.Char(36)

  //--- 관계 필드
  parentPlace            Place?                  @relation("PlaceHierarchy", fields: [parentPlaceId], references: [id], onDelete: SetNull)
  childPlaces            Place[]                 @relation("PlaceHierarchy")
  country                Country?                @relation("CountryPlaces", fields: [countryId], references: [id], onDelete: SetNull)
  historicalCountry      HistoricalCountry?      @relation("HistoricalCountryPlaces", fields: [historicalCountryId], references: [id], onDelete: SetNull)
  administrativeDivision AdministrativeDivision? @relation("AdminDivPlaces", fields: [administrativeDivisionId], references: [id], onDelete: SetNull)
  names                  PlaceName[]
  personPlaces           PersonPlace[]           @relation("PlaceToPersonPlaces")
  personsBornHere        Person[]                @relation("PersonBirthPlace")
  personsDiedHere        Person[]                @relation("PersonDeathPlace")
  personsBuriedHere      Person[]                @relation("PersonBurialPlace")
  personLifeEvents       PersonLifeEvent[]       @relation("PersonLifeEventPlace")

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name], name: "idx_place_name")
  @@index([kind], name: "idx_place_kind")
  @@index([countryId], name: "idx_place_countryId")
  @@index([historicalCountryId], name: "idx_place_historicalCountryId")
  @@index([administrativeDivisionId], name: "idx_place_adminDivId")
  @@index([parentPlaceId], name: "idx_place_parentPlaceId")
  @@map("place")
}

// ========================
// PlaceName (장소의 시대별·언어별 지명 이력)
// ========================
model PlaceName {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 소속 Place FK
  placeId String @map("place_id") @db.Char(36)
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  /// 지명 표기 (예: "티플리스", "한성부", "엑스라샤펠", "Mouilleron-en-Pareds")
  name String @db.VarChar(250)

  /// 언어 코드 (예: ko, en, fr, ja, zh-Hant)
  languageCode String? @map("language_code") @db.VarChar(16)

  /// 표기 종류
  kind PlaceNameKind @default(HISTORICAL)

  /// 이 지명이 쓰인 역사 국가 (선택)
  historicalCountryId String?            @map("historical_country_id") @db.Char(36)
  historicalCountry   HistoricalCountry? @relation("HistoricalCountryPlaceNames", fields: [historicalCountryId], references: [id], onDelete: SetNull)

  /// 사용 기간 (구조화 연도 — BC 수용)
  startEra  Era? @map("start_era")
  startYear Int? @map("start_year")
  endEra    Era? @map("end_era")
  endYear   Int? @map("end_year")

  /// 비고
  note String? @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([placeId], name: "idx_place_name_placeId")
  @@index([name], name: "idx_place_name_text")
  @@index([historicalCountryId], name: "idx_place_name_histCountryId")
  @@map("place_name")
}
