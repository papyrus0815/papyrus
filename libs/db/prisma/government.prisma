/// ╔══════════════════════════════════════════════════════════════════════════════╗
/// ║                            GOVERNMENT DOMAIN                                 ║
/// ╚══════════════════════════════════════════════════════════════════════════════╝
/// 
/// 이 도메인은 **공식적인 정부 관직과 국가 지도자의 재임 기록**을 관리합니다.
/// 
/// 사건·인물 페이지의 "역대 수반"은 이 도메인의 GovernmentPositionTenure(연대표)만 사용합니다.
///
/// 주요 기능:
/// - 정부 직위 정의(GovernmentPositionDefinition): 관직 체계
///   • 국가원수, 정부수반, 왕세자, 섭정 등
///   • 직위의 설치와 폐지 이력
///   • 국가별/시대별 관직 체계
/// 
/// - 재임 기록(GovernmentPositionTenure): 공식 재임 이력
///   • 제N대 대통령, 왕, 황제, 총리 등
///   • 재위/임기 시작과 종료
///   • 임명/계승 방식과 종료 사유
///   • 연호 관리 (동아시아 군주)
/// 
/// - 연호(RegnalEra): 동아시아 군주 연호
///   • 한 군주의 여러 연호 관리
///   • 연호 변경 이력 추적
/// 
/// 활용 사례:
/// - 한국: 제20대 대통령 윤석열 (2022.05.10~현재)
/// - 미국: 제46대 대통령 조 바이든 (2021.01.20~현재)
/// - 영국: 제80대 총리 리시 수낙 (2022.10.25~2024.07.05)
/// - 조선: 제4대 국왕 세종 (1418.08.10~1450.02.17)
/// - 청나라: 제4대 황제 강희제/康熙 연호 (1661~1722)
/// - 영국: 제임스 1세/6세 (잉글랜드 1세, 스코틀랜드 6세)
/// 
/// 특징:
/// - 대수/회차(termNumber)로 역대 순서 관리
/// - 재위 번호(regnalNumber) 국가별 관리
/// - 현대 국가와 역사적 국가 모두 지원
/// - 직위별 재임자 목록과 통계 제공
/// - 중임 및 겸직 처리 가능
/// - 임명 방식 기록 (선거, 임명, 세습, 쿠데타 등)
/// - 연호 체계 완전 지원

// ========================
// Enums
// ========================

/// 정부 관직의 유형을 분류합니다.
enum GovernmentPositionType {
  /// 국가원수 (대통령, 국왕, 황제, 천황 등)
  HEAD_OF_STATE
  /// 정부수반 (총리, 수상, 영의정 등)
  HEAD_OF_GOVERNMENT
  /// 왕위 계승자 (왕세자, 황태자, 황태손, Crown Prince 등)
  HEIR_APPARENT
  /// 섭정 (Regent, 대리청정)
  REGENT
  /// 각료/장관 (외교부 장관, 국방부 장관, 6조 판서 등)
  CABINET_MINISTER
  /// 차관/차관보 (정무직 고위 공무원)
  VICE_MINISTER
  /// 의회의원 (국회의원, 상원의원, 하원의원 등)
  LEGISLATOR
  /// 사법부 (대법원장, 대법관, 헌법재판소장 등)
  JUDICIARY
  /// 지방정부 (도지사, 시장, 군수 등)
  LOCAL_GOVERNMENT
  /// 특별직 (감사원장, 중앙선거관리위원장 등)
  SPECIAL_POSITION
  /// 군 지휘관 (국군통수권자는 HEAD_OF_STATE)
  MILITARY_COMMANDER
  /// 왕족/귀족 칭호 (공작, 후작, 백작, 대군, 군 등)
  ROYAL_NOBLE_TITLE
  /// 기타
  OTHER
}

/// 임명 또는 선출 방식
enum AppointmentMethod {
  /// 직접 선거
  DIRECT_ELECTION
  /// 간접 선거
  INDIRECT_ELECTION
  /// 임명 (대통령/총리 등의 임명)
  APPOINTMENT
  /// 세습 (왕위 계승 등)
  HEREDITARY
  /// 쿠데타/혁명
  COUP
  /// 의회 선출
  PARLIAMENTARY_ELECTION
  /// 기타
  OTHER
}

/// 재임 종료 사유
enum TenureEndReason {
  /// 임기 만료 (정상)
  TERM_COMPLETED
  /// 사임/사퇴
  RESIGNATION
  /// 자진 퇴위 (왕/군주)
  ABDICATION
  /// 양위/선위 (후계자에게 양보)
  SUCCESSION_TRANSFER
  /// 폐위/해임
  REMOVAL
  /// 탄핵
  IMPEACHMENT
  /// 사망 (재임 중)
  DEATH_IN_OFFICE
  /// 쿠데타/혁명으로 축출
  OVERTHROWN
  /// 전쟁 패배
  WAR_DEFEAT
  /// 국가 멸망
  STATE_DISSOLVED
  /// 기타
  OTHER
}

// ========================
// GovernmentPositionDefinition (단일 레벨: 직함 + enum 분류)
// ========================

/// 관직 정의 — 직함(대통령, 총리, 국왕 등) 단일 레벨. 분류는 positionType(enum)으로만 구분.
/// 재임(Tenure)은 이 테이블 행을 참조. 국가 무관 전역 목록.
model GovernmentPositionDefinition {
  id String @id @default(uuid()) @db.Char(36)

  /// 유형(enum). 직함의 분류 (국가원수, 정부수반 등)
  positionType GovernmentPositionType @map("position_type")

  /// 직함 표시명
  title String @db.VarChar(100)

  titleEn    String? @map("title_en") @db.VarChar(100)
  titleLocal String? @map("title_local") @db.VarChar(100)

  description String? @db.Text
  rank        Int?    @default(999)

  /// 중앙부처 카테고리 연결 — 외교부 장관, 국방부 장관 등 일반 직위 (관리자 등록)
  categoryId String? @map("category_id") @db.Char(36)

  /// 행정기구(Organization) 연결 — 조선총독, 만철 총재 등 특정 기구 직위 (사용자 등록)
  organizationId String? @map("organization_id") @db.Char(36)

  establishedDate DateTime? @map("established_date")
  abolishedDate   DateTime? @map("abolished_date")

  category     AdministrationDepartmentCategory? @relation("CategoryPositionDefinitions", fields: [categoryId], references: [id], onDelete: SetNull)
  organization Organization?                     @relation("GovernmentPositionOrganization", fields: [organizationId], references: [id], onDelete: SetNull)

  tenures             GovernmentPositionTenure[]
  treatySignatories TreatySignatory[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId], name: "idx_gov_pos_def_categoryId")
  @@index([organizationId], name: "idx_gov_pos_def_organizationId")
  @@index([positionType], name: "idx_gov_pos_def_positionType")
  @@index([rank], name: "idx_gov_pos_def_rank")
  @@map("government_position_definition")
}

// ========================
// Cabinet (행정부) — 정규화된 행정부 단위
// ========================
/// 한 수반(대통령·수상) 재임을 중심으로 한 행정부. 각료 재임은 cabinetId로 소속.
/// - 기간·국가는 headTenure 조인으로 조회 (이중 저장 제거, 정규화)
/// - "이 행정부 각료" = GovernmentPositionTenure where cabinetId = id
model Cabinet {
  id String @id @default(uuid()) @db.Char(36)

  /// 이 행정부의 수반 재임 (대통령·수상 등 1건)
  headTenureId String @unique @map("head_tenure_id") @db.Char(36)

  /// 행정부 명칭 (선택, 예: "루즈벨트 제1기")
  name String? @db.VarChar(120)

  /// 등록한 계정 (계정별 행정부 구분)
  accountId String? @map("account_id") @db.Char(36)

  headTenure    GovernmentPositionTenure  @relation("CabinetHead", fields: [headTenureId], references: [id], onDelete: Cascade)
  memberTenures GovernmentPositionTenure[] @relation("CabinetMembers")
  account       Account?                  @relation("AccountCabinets", fields: [accountId], references: [id], onDelete: SetNull)
  treatySignatories TreatySignatory[]     @relation("TreatySignatoryCabinet")
  /// 연정·여당 등 이 행정부를 지지한 정당(행정부 단위 기록)
  politicalParties CabinetPoliticalParty[] @relation("CabinetPoliticalParties")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([accountId], name: "idx_cabinet_accountId")
  @@map("cabinet")
}

// ========================
// GovernmentPositionTenure
// ========================

/// 🔶 국가 최고 지도자의 공식 재임 기록 (역대 수반)
/// 사건 페이지·연대표에서 사용. 국가원수, 왕, 황제, 대통령, 총리 등.
///
/// 활용 사례:
/// - 윤석열: 제20대 대통령 (2022.05.10~현재)
/// - 세종: 조선 제4대 국왕 (1418~1450)
/// - 루이 14세: 프랑스 국왕, 재위번호 14 (1643~1715)
/// - 제임스 1세/6세: 잉글랜드 1세 + 스코틀랜드 6세 (동시)
/// - 강희제: 청나라 제4대 황제, 康熙 연호 (1661~1722)
model GovernmentPositionTenure {
  /// 고유 식별자 (PK)
  id String @id @default(uuid()) @db.Char(36)

  /// 재임자 (인물) ID
  personId String @map("person_id") @db.Char(36)

  /// 직위 타입 (필수)
  positionType GovernmentPositionType @map("position_type")

  /// 직위명 — positionDefinitionId가 있으면 정의에서 조회, 없으면(기타) 여기 값 사용
  title String? @db.VarChar(100)

  /// 영문 직위명 (기타 직접 입력 시에만 사용)
  titleEn String? @map("title_en") @db.VarChar(100)

  /// 사건 타임라인에 직책 정보 표시 여부 (기본값: true)
  showPositionInfo Boolean @default(false) @map("show_position_info")

  /// 소속 국가 (현대 국가)
  countryId String? @map("country_id") @db.Char(36)

  /// 소속 국가 (역사적 국가)
  historicalCountryId String? @map("historical_country_id") @db.Char(36)

  /// 직위 정의 ID (선택사항, 공식 직위를 참조하고 싶을 때만)
  positionDefinitionId String? @map("position_definition_id") @db.Char(36)

  /// 대수/회차 (예: 20 = 제20대, 100 = 제100대)
  /// NULL이면 대수 개념이 없는 직위 (예: 조선시대 관직)
  termNumber Int? @map("term_number")

  /// 기수 (예: 1 → 1기, 2 → 2기)
  /// 같은 대수에서 여러 기(期)가 존재할 때 사용 (예: 클린턴 42대 1기/2기)
  /// NULL이면 기수 구분 없음
  subTermNumber Int? @map("sub_term_number")

  /// 재위 번호 (예: 14 → "루이 14세", 1 → "제임스 1세")
  /// 주의: 같은 인물이라도 국가마다 다를 수 있음 (제임스 1세/6세)
  /// 서양 군주 전용, 동아시아는 termNumber 사용
  regnalNumber Int? @map("regnal_number")

  /// 임기 시작일 (즉위일)
  startDate DateTime @map("start_date")

  /// 임기 종료일 (퇴위일, 현재 재직 중이면 NULL)
  endDate DateTime? @map("end_date")

  /// 임명/선출 방식
  appointmentMethod AppointmentMethod? @map("appointment_method")

  /// 종료 사유 (Enum)
  endReason TenureEndReason? @map("end_reason")

  /// 종료 사유 상세 설명
  endReasonDetail String? @map("end_reason_detail") @db.Text

  /// 특이사항/비고
  notes String? @db.Text

  /// 우선순위 (같은 직위를 여러 번 역임한 경우 순서 구분, 낮을수록 우선)
  priority Int? @default(0)

  /// 소속 행정부 ID — 이 각료/총독 재임이 속한 행정부(Cabinet)
  cabinetId String? @map("cabinet_id") @db.Char(36)

  /// 소속 중앙부처 ID — 이 재임이 실제 속한 국가별 부처 인스턴스 (예: 미국 국무부, 한국 외교부)
  administrationDepartmentId String? @map("administration_department_id") @db.Char(36)

  /// 등록한 계정 (계정별 각료/재임 구분)
  accountId String? @map("account_id") @db.Char(36)

  //--- 관계 필드
  positionDefinition GovernmentPositionDefinition? @relation(fields: [positionDefinitionId], references: [id], onDelete: SetNull)
  country            Country?                      @relation("TenureCountry", fields: [countryId], references: [id], onDelete: SetNull)
  historicalCountry  HistoricalCountry?            @relation("TenureHistoricalCountry", fields: [historicalCountryId], references: [id], onDelete: SetNull)
  person             Person                        @relation("PersonGovernmentTenure", fields: [personId], references: [id], onDelete: Cascade)
  cabinet            Cabinet?                      @relation("CabinetMembers", fields: [cabinetId], references: [id], onDelete: SetNull)
  headOfCabinet      Cabinet?                      @relation("CabinetHead")
  account            Account?                      @relation("AccountGovernmentTenures", fields: [accountId], references: [id], onDelete: SetNull)
  regnalEras         RegnalEra[]                   @relation("TenureRegnalEras")
  /// 재임 기간 중 업적·한일 (사건과 별도 개념)
  achievements       TenureAchievement[]           @relation("TenureAchievements")
  administrationDepartment AdministrationDepartment? @relation("TenureDepartment", fields: [administrationDepartmentId], references: [id], onDelete: SetNull)

  /// 이 공직 임기가 특정 선거의 당선으로 시작된 경우(대통령·국회의원 등). 1:1.
  electionCandidacyId String? @unique @map("election_candidacy_id") @db.Char(36)
  electionCandidacy   ElectionCandidacy? @relation("TenureFromElectionCandidacy", fields: [electionCandidacyId], references: [id], onDelete: SetNull)

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([positionDefinitionId], name: "idx_gov_tenure_posDefId")
  @@index([personId], name: "idx_gov_tenure_personId")
  @@index([countryId], name: "idx_gov_tenure_countryId")
  @@index([historicalCountryId], name: "idx_gov_tenure_histCountryId")
  @@index([positionType], name: "idx_gov_tenure_posType")
  @@index([termNumber], name: "idx_gov_tenure_termNum")
  @@index([startDate], name: "idx_gov_tenure_startDate")
  @@index([cabinetId], name: "idx_gov_tenure_cabinetId")
  @@index([administrationDepartmentId], name: "idx_gov_tenure_adminDeptId")
  @@index([accountId], name: "idx_gov_tenure_accountId")
  @@map("government_position_tenure")
}

// ========================
// TenureAchievement (재임 업적·한일)
// ========================
/// 재임 기간 중 수반이 한 일·업적. 사건(Event)과 별도로 관리하며, 사건 목록과 유사한 형태로 조회 가능.
model TenureAchievement {
  id String @id @default(uuid()) @db.Char(36)

  /// 소속 재임 기록 (역대 수반 한 명의 한 재임)
  tenureId String @map("tenure_id") @db.Char(36)

  /// 제목 (예: 한글 창제, 대동법 시행)
  title String @db.VarChar(200)

  /// 설명 (선택)
  description String? @db.Text

  /// 시작일 (선택)
  startDate DateTime? @map("start_date")

  /// 종료일 (선택)
  endDate DateTime? @map("end_date")

  /// 표시 순서 (낮을수록 먼저)
  orderNum Int? @default(0) @map("order_num")

  /// 사건 페이지(연대표)에 표시할지 여부
  showOnEventsPage Boolean @default(true) @map("show_on_events_page")

  tenure GovernmentPositionTenure @relation("TenureAchievements", fields: [tenureId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenureId], name: "idx_tenure_achievement_tenureId")
  @@index([showOnEventsPage], name: "idx_tenure_achievement_showOnEventsPage")
  @@map("tenure_achievement")
}

// ========================
// RegnalEra (연호)
// ========================
/// 동아시아 군주의 연호를 기록합니다.
/// 한 군주가 여러 연호를 사용할 수 있으며, 중요 사건이나 재위 기간 구분에 사용됩니다.
/// 
/// 예시:
/// - 청나라 강희제: 康熙 (1662-1722, 61년간 단일 연호)
/// - 청나라 건륭제: 乾隆 (1736-1795, 60년간 단일 연호)
/// - 명나라 만력제: 萬曆 (1573-1620, 48년간 단일 연호)
/// - 조선 세종: 세종 연간 (묘호이자 연호처럼 사용, 1418-1450)
/// - 명나라 홍무제: 洪武 → 건문제: 建文 (단명)
model RegnalEra {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 재임 기록 ID (GovernmentPositionTenure)
  tenureId String @map("tenure_id") @db.Char(36)

  /// 연호명 (예: 康熙, 乾隆, 建文, 洪武)
  eraName String @map("era_name") @db.VarChar(50)

  /// 연호 영문명 (예: Kangxi, Qianlong)
  eraNameEn String? @map("era_name_en") @db.VarChar(50)

  /// 연호 시작 연도
  startYear Int @map("start_year")

  /// 연호 시작 월
  startMonth Int? @map("start_month")

  /// 연호 시작 일
  startDay Int? @map("start_day")

  /// 연호 종료 연도 (NULL이면 재위 종료까지)
  endYear Int? @map("end_year")

  /// 연호 종료 월
  endMonth Int? @map("end_month")

  /// 연호 종료 일
  endDay Int? @map("end_day")

  /// 연호 변경 사유 (예: 재난, 개혁, 경사 등)
  changeReason String? @map("change_reason") @db.VarChar(200)

  //--- 관계 필드
  tenure GovernmentPositionTenure @relation("TenureRegnalEras", fields: [tenureId], references: [id], onDelete: Cascade)

  //--- 메타데이터
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenureId], name: "idx_regnal_era_tenure")
  @@index([startYear], name: "idx_regnal_era_start")
  @@map("regnal_era")
