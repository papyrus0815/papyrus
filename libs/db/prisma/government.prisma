/// ╔══════════════════════════════════════════════════════════════════════════════╗
/// ║                            GOVERNMENT DOMAIN                                 ║
/// ╚══════════════════════════════════════════════════════════════════════════════╝
/// 
/// 이 도메인은 **공식적인 정부 관직과 국가 지도자의 재임 기록**을 관리합니다.
/// 
/// ⚠️ 중요: person.prisma의 GovernmentCareer와의 차이점
/// ┌──────────────────────────────────────────────────────────────────────┐
/// │ GovernmentPositionTenure (이 파일)                                    │
/// │ - 용도: 공식적인 헌법/제도상 직위의 재임 기록                          │
/// │ - 대상: 국가원수, 정부수반, 왕, 황제 등 최고위급                        │
/// │ - 특징: 역대 통치자 목록, 대수 관리, 공식 기록                          │
/// │ - 예시: 제20대 대통령, 조선 제4대 국왕, 루이 14세                       │
/// │                                                                        │
/// │ GovernmentCareer (person.prisma)                                      │
/// │ - 용도: 일반 공무원/정치인의 경력 타임라인                             │
/// │ - 대상: 장관, 차관, 국회의원, 지방정부, 일반 관직                       │
/// │ - 특징: 개인의 career path, 승진 이력, 부서 이동                       │
/// │ - 예시: 외교부 장관, 국회의원, 서울시장, 조선 이조판서                  │
/// └──────────────────────────────────────────────────────────────────────┘
/// 
/// 주요 기능:
/// - 정부 직위 정의(GovernmentPositionDefinition): 관직 체계
///   • 국가원수, 정부수반, 왕세자, 섭정 등
///   • 직위의 설치와 폐지 이력
///   • 국가별/시대별 관직 체계
/// 
/// - 재임 기록(GovernmentPositionTenure): 공식 재임 이력
///   • 제N대 대통령, 왕, 황제, 총리 등
///   • 재위/임기 시작과 종료
///   • 임명/계승 방식과 종료 사유
///   • 연호 관리 (동아시아 군주)
/// 
/// - 연호(RegnalEra): 동아시아 군주 연호
///   • 한 군주의 여러 연호 관리
///   • 연호 변경 이력 추적
/// 
/// 활용 사례:
/// - 한국: 제20대 대통령 윤석열 (2022.05.10~현재)
/// - 미국: 제46대 대통령 조 바이든 (2021.01.20~현재)
/// - 영국: 제80대 총리 리시 수낙 (2022.10.25~2024.07.05)
/// - 조선: 제4대 국왕 세종 (1418.08.10~1450.02.17)
/// - 청나라: 제4대 황제 강희제/康熙 연호 (1661~1722)
/// - 영국: 제임스 1세/6세 (잉글랜드 1세, 스코틀랜드 6세)
/// 
/// 특징:
/// - 대수/회차(termNumber)로 역대 순서 관리
/// - 재위 번호(regnalNumber) 국가별 관리
/// - 현대 국가와 역사적 국가 모두 지원
/// - 직위별 재임자 목록과 통계 제공
/// - 중임 및 겸직 처리 가능
/// - 임명 방식 기록 (선거, 임명, 세습, 쿠데타 등)
/// - 연호 체계 완전 지원

// ========================
// Enums
// ========================

/// 정부 관직의 유형을 분류합니다.
enum GovernmentPositionType {
  /// 국가원수 (대통령, 국왕, 황제, 천황 등)
  HEAD_OF_STATE
  /// 정부수반 (총리, 수상, 영의정 등)
  HEAD_OF_GOVERNMENT
  /// 왕위 계승자 (왕세자, 황태자, 황태손, Crown Prince 등)
  HEIR_APPARENT
  /// 섭정 (Regent, 대리청정)
  REGENT
  /// 각료/장관 (외교부 장관, 국방부 장관, 6조 판서 등)
  CABINET_MINISTER
  /// 차관/차관보 (정무직 고위 공무원)
  VICE_MINISTER
  /// 의회의원 (국회의원, 상원의원, 하원의원 등)
  LEGISLATOR
  /// 사법부 (대법원장, 대법관, 헌법재판소장 등)
  JUDICIARY
  /// 지방정부 (도지사, 시장, 군수 등)
  LOCAL_GOVERNMENT
  /// 특별직 (감사원장, 중앙선거관리위원장 등)
  SPECIAL_POSITION
  /// 군 지휘관 (국군통수권자는 HEAD_OF_STATE)
  MILITARY_COMMANDER
  /// 왕족/귀족 칭호 (공작, 후작, 백작, 대군, 군 등)
  ROYAL_NOBLE_TITLE
  /// 기타
  OTHER
}

/// 임명 또는 선출 방식
enum AppointmentMethod {
  /// 직접 선거
  DIRECT_ELECTION
  /// 간접 선거
  INDIRECT_ELECTION
  /// 임명 (대통령/총리 등의 임명)
  APPOINTMENT
  /// 세습 (왕위 계승 등)
  HEREDITARY
  /// 쿠데타/혁명
  COUP
  /// 의회 선출
  PARLIAMENTARY_ELECTION
  /// 기타
  OTHER
}

/// 재임 종료 사유
enum TenureEndReason {
  /// 임기 만료 (정상)
  TERM_COMPLETED
  /// 사임/사퇴
  RESIGNATION
  /// 자진 퇴위 (왕/군주)
  ABDICATION
  /// 양위/선위 (후계자에게 양보)
  SUCCESSION_TRANSFER
  /// 폐위/해임
  REMOVAL
  /// 탄핵
  IMPEACHMENT
  /// 사망 (재임 중)
  DEATH_IN_OFFICE
  /// 쿠데타/혁명으로 축출
  OVERTHROWN
  /// 전쟁 패배
  WAR_DEFEAT
  /// 국가 멸망
  STATE_DISSOLVED
  /// 기타
  OTHER
}

// ========================
// GovernmentPositionDefinition
// ========================

/// 정부 직위 정의 모델
/// 특정 국가의 특정 관직을 정의합니다.
/// 예: "대한민국 대통령", "조선 영의정", "일본 내각총리대신"
model GovernmentPositionDefinition {
  /// 고유 식별자 (PK)
  id String @id @default(uuid()) @db.Char(36)

  /// 직위명 (예: "대통령", "국무총리", "외교부 장관", "영의정")
  title String @db.VarChar(100)

  /// 영문 직위명
  titleEn String? @map("title_en") @db.VarChar(100)

  /// 현지어 직위명
  titleLocal String? @map("title_local") @db.VarChar(100)

  /// 직위 유형
  positionType GovernmentPositionType @map("position_type")

  /// 설명/개요
  description String? @db.Text

  /// 직급/서열 (숫자가 작을수록 높은 직위, 예: 1=대통령, 2=국무총리)
  rank Int? @default(999)

  /// 부서/부처명 (예: "외교부", "국방부", "이조")
  departmentName String? @map("department_name") @db.VarChar(100)

  /// 소속 국가 (현대 국가)
  countryId String? @map("country_id") @db.Char(36)

  /// 소속 국가 (역사적 국가)
  historicalCountryId String? @map("historical_country_id") @db.Char(36)

  /// 직위 설치일 (이 직위가 생긴 날짜)
  establishedDate DateTime? @map("established_date")

  /// 직위 폐지일 (이 직위가 없어진 날짜)
  abolishedDate DateTime? @map("abolished_date")

  //--- 관계 필드
  country           Country?           @relation("GovernmentPositionCountry", fields: [countryId], references: [id], onDelete: SetNull)
  historicalCountry HistoricalCountry? @relation("GovernmentPositionHistoricalCountry", fields: [historicalCountryId], references: [id], onDelete: SetNull)

  /// 이 직위의 역대 재임자들
  tenures GovernmentPositionTenure[]

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([countryId], name: "idx_gov_pos_def_countryId")
  @@index([historicalCountryId], name: "idx_gov_pos_def_histCountryId")
  @@index([positionType], name: "idx_gov_pos_def_type")
  @@index([rank], name: "idx_gov_pos_def_rank")
  @@map("government_position_definition")
}

// ========================
// GovernmentPositionTenure
// ========================

/// 🔶 국가 최고 지도자의 공식 재임 기록
/// 
/// ⚠️ 중요: person.prisma의 GovernmentCareer와의 차이
/// ┌──────────────────────────────────────────────────────────────────────┐
/// │ GovernmentPositionTenure (이 테이블)                                  │
/// │ ✓ 용도: 국가 최고 지도자의 공식 재임 기록                              │
/// │ ✓ 대상: 국가원수, 왕, 황제, 대통령, 총리, 왕세자                       │
/// │ ✓ 참조: GovernmentPositionDefinition (공식 관직 정의)                 │
/// │ ✓ 국가: Country + HistoricalCountry 모두 지원                         │
/// │ ✓ 상세: 연호, 재위번호, 대수, 임명방식, 종료사유                       │
/// │ ✓ 예시: 제20대 대통령, 조선 제4대 국왕 세종, 루이 14세                 │
/// │                                                                        │
/// │ GovernmentCareer (person.prisma)                                      │
/// │ ✓ 용도: 일반 공무원/정치인의 경력 타임라인                             │
/// │ ✓ 대상: 장관, 차관, 국회의원, 지방정부, 일반 관직                       │
/// │ ✓ 참조: Job 테이블 (일반 직업 분류)                                   │
/// │ ✓ 국가: Country만 지원 (현대 국가)                                    │
/// │ ✓ 예시: 외교부 장관, 국회의원, 서울시장                                │
/// └──────────────────────────────────────────────────────────────────────┘
/// 
/// 활용 사례:
/// - 윤석열: 제20대 대통령 (2022.05.10~현재)
/// - 세종: 조선 제4대 국왕 (1418~1450)
/// - 루이 14세: 프랑스 국왕, 재위번호 14 (1643~1715)
/// - 제임스 1세/6세: 잉글랜드 1세 + 스코틀랜드 6세 (동시)
/// - 강희제: 청나라 제4대 황제, 康熙 연호 (1661~1722)
model GovernmentPositionTenure {
  /// 고유 식별자 (PK)
  id String @id @default(uuid()) @db.Char(36)

  /// 직위 정의 ID
  positionId String @map("position_id") @db.Char(36)

  /// 재임자 (인물) ID
  personId String @map("person_id") @db.Char(36)

  /// 대수/회차 (예: 20 = 제20대, 100 = 제100대)
  /// NULL이면 대수 개념이 없는 직위 (예: 조선시대 관직)
  termNumber Int? @map("term_number")

  /// 재위 번호 (예: 14 → "루이 14세", 1 → "제임스 1세")
  /// 주의: 같은 인물이라도 국가마다 다를 수 있음 (제임스 1세/6세)
  /// 서양 군주 전용, 동아시아는 termNumber 사용
  regnalNumber Int? @map("regnal_number")

  /// 임기 시작일 (즉위일)
  startDate DateTime @map("start_date")

  /// 임기 종료일 (퇴위일, 현재 재직 중이면 NULL)
  endDate DateTime? @map("end_date")

  /// 임명/선출 방식
  appointmentMethod AppointmentMethod? @map("appointment_method")

  /// 종료 사유 (Enum)
  endReason TenureEndReason? @map("end_reason")

  /// 종료 사유 상세 설명
  endReasonDetail String? @map("end_reason_detail") @db.VarChar(200)

  /// 특이사항/비고
  notes String? @db.Text

  /// 우선순위 (같은 직위를 여러 번 역임한 경우 순서 구분, 낮을수록 우선)
  priority Int? @default(0)

  //--- 관계 필드
  position   GovernmentPositionDefinition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  person     Person                       @relation("PersonGovernmentTenure", fields: [personId], references: [id], onDelete: Cascade)
  regnalEras RegnalEra[]                  @relation("TenureRegnalEras")

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([positionId], name: "idx_gov_tenure_posId")
  @@index([personId], name: "idx_gov_tenure_personId")
  @@index([termNumber], name: "idx_gov_tenure_termNum")
  @@index([startDate], name: "idx_gov_tenure_startDate")
  @@map("government_position_tenure")
}

// ========================
// RegnalEra (연호)
// ========================
/// 동아시아 군주의 연호를 기록합니다.
/// 한 군주가 여러 연호를 사용할 수 있으며, 중요 사건이나 재위 기간 구분에 사용됩니다.
/// 
/// 예시:
/// - 청나라 강희제: 康熙 (1662-1722, 61년간 단일 연호)
/// - 청나라 건륭제: 乾隆 (1736-1795, 60년간 단일 연호)
/// - 명나라 만력제: 萬曆 (1573-1620, 48년간 단일 연호)
/// - 조선 세종: 세종 연간 (묘호이자 연호처럼 사용, 1418-1450)
/// - 명나라 홍무제: 洪武 → 건문제: 建文 (단명)
model RegnalEra {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 재임 기록 ID (GovernmentPositionTenure)
  tenureId String @map("tenure_id") @db.Char(36)

  /// 연호명 (예: 康熙, 乾隆, 建文, 洪武)
  eraName String @map("era_name") @db.VarChar(50)

  /// 연호 영문명 (예: Kangxi, Qianlong)
  eraNameEn String? @map("era_name_en") @db.VarChar(50)

  /// 연호 시작 연도
  startYear Int @map("start_year")

  /// 연호 시작 월
  startMonth Int? @map("start_month")

  /// 연호 시작 일
  startDay Int? @map("start_day")

  /// 연호 종료 연도 (NULL이면 재위 종료까지)
  endYear Int? @map("end_year")

  /// 연호 종료 월
  endMonth Int? @map("end_month")

  /// 연호 종료 일
  endDay Int? @map("end_day")

  /// 연호 변경 사유 (예: 재난, 개혁, 경사 등)
  changeReason String? @map("change_reason") @db.VarChar(200)

  //--- 관계 필드
  tenure GovernmentPositionTenure @relation("TenureRegnalEras", fields: [tenureId], references: [id], onDelete: Cascade)

  //--- 메타데이터
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenureId], name: "idx_regnal_era_tenure")
  @@index([startYear], name: "idx_regnal_era_start")
  @@map("regnal_era")
}
