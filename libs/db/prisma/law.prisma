/// ║                                 LAW DOMAIN                                   ║
/// ╚══════════════════════════════════════════════════════════════════════════════╝
/// 
/// 이 도메인은 법률과 정책의 제정, 시행, 변화를 관리합니다.
/// 
/// 주요 기능:
/// - 법률 유형(LawType): 법의 분류 체계
///   • 헌법, 법률, 시행령, 조례 등 법체계
///   • 분야별 법률 분류 (민법, 형법, 상법 등)
///   • 법적 효력과 위계 구조
/// 
/// - 법률(Law): 구체적 법령과 정책
///   • 제정, 개정, 폐지 등 변화 과정
///   • 시행 기간과 효력 범위
///   • 국가별/시대별 법제 차이
///   • 사회 변화와 법적 대응
/// 
/// 활용 사례:
/// - 헌법 제정과 개헌 과정
/// - 주요 법률의 제정 배경과 영향
/// - 기업 활동에 대한 규제 법령
/// - 사회 정책과 복지 법제
/// - 국제법과 조약의 국내 수용
/// 
/// 특징:
/// - 사회 질서와 규범의 제도화
/// - 정치적 의사결정의 결과물
/// - 기업과 개인 활동의 법적 근거
/// - 시대적 가치관과 이념의 반영
/// - 국가 간 법제 비교 연구 기반

// ========================
// LawType
// ========================
model LawType {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 법 유형명
  name String @db.VarChar(100)

  /// 간단 설명
  description String? @db.Text

  //--- 관계 필드
  laws Law[]

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("law_type")
}

// ========================
// Law
// ========================
model Law {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 법/정책 명칭
  name String @db.VarChar(150)

  /// 간단 요약
  summary String? @db.Text

  /// 조 번호(양의 정수만 저장·입력, 표시 시 「제N조」)
  articleNumber Int? @map("article_number")

  /// 항 번호(양의 정수만 저장·입력, 표시 시 「제M항」)
  paragraphNumber Int? @map("paragraph_number")

  /// 시행/폐지 시점
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  /// 기타 메모
  note String?

  //--- 외래키
  lawTypeId           String? @map("law_type_id") @db.Char(36)
  countryId           String? @map("country_id") @db.Char(36)
  historicalCountryId String? @map("historical_country_id") @db.Char(36)

  //--- 관계 필드
  facilities CompanyFacilityLaw[]
  lawType    LawType?             @relation(fields: [lawTypeId], references: [id], onDelete: SetNull)
  country    Country?             @relation(fields: [countryId], references: [id], onDelete: SetNull)
  historicalCountry HistoricalCountry? @relation("LawHistoricalCountry", fields: [historicalCountryId], references: [id], onDelete: SetNull)
  /// 정당과의 연결 (`politics.prisma` PoliticalPartyLaw)
  politicalPartyLaws PoliticalPartyLaw[] @relation("PoliticalPartyLawLink")

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([historicalCountryId], name: "idx_law_historicalCountryId")
  @@map("law")
}
