// ========================
// Military Unit & People Models (부대 및 인물 모델)
// ========================

model MilitaryUnit {
  /// 고유 식별자 (PK)
  id String @id @default(uuid()) @db.Char(36)

  /// 부대명
  name String @db.VarChar(100)

  /// 부대 종류 (MilitaryUnitType Enum 참조)
  unitType MilitaryUnitType? @map("unit_type")

  /// 소속 국가의 외래 키 (FK)
  countryId String? @map("country_id") @db.Char(36)

  /// 부대 상태
  isActive        Boolean?  @map("is_active")
  /// 창설일
  establishedDate DateTime? @map("established_date")
  /// 해체일
  disbandedDate   DateTime? @map("disbanded_date")

  /// 상위 부대의 외래 키 (자기 참조)
  parentUnitId String? @map("parent_unit_id") @db.Char(36)

  /// 부대에 대한 상세 설명
  description String? @db.Text

  // --- 관계 필드
  /// 소속 국가
  country    Country?                 @relation(fields: [countryId], references: [id], onDelete: SetNull)
  /// 상위 부대
  parentUnit MilitaryUnit?            @relation("UnitHierarchy", fields: [parentUnitId], references: [id], onDelete: SetNull)
  /// 하위 부대들
  subUnits   MilitaryUnit[]           @relation("UnitHierarchy")
  /// 지휘관 기록
  commanders MilitaryUnitCommander[]
  /// 참전 기록
  wars       WarHistoryMilitaryUnit[]

  // 🆕 정규화된 군사 사건 관계
  sideDeployedUnits    SideDeployedUnit[]
  countryDeployedUnits CountryDeployedUnit[]

  // --- 메타데이터
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([countryId])
  @@index([parentUnitId])
  @@map("military_units")
}

model MilitaryUnitCommander {
  /// 고유 식별자 (PK)
  id String @id @default(uuid()) @db.Char(36)

  /// 지휘 부대의 외래 키 (FK)
  unitId   String @map("unit_id") @db.Char(36)
  /// 지휘관(인물)의 외래 키 (FK)
  personId String @map("person_id") @db.Char(36)

  // --- 지휘 정보
  /// 계급
  rank      String?   @db.VarChar(50)
  /// 직책 (예: 사단장)
  role      String?   @db.VarChar(50)
  /// 현재 지휘관 여부
  isCurrent Boolean?  @default(false) @map("is_current")
  /// 지휘 시작일
  startDate DateTime? @map("start_date")
  /// 지휘 종료일
  endDate   DateTime? @map("end_date")
  /// 비고
  notes     String?   @db.Text

  // --- 경력 정보
  /// 군 경력 요약
  careerSummary    String? @map("career_summary") @db.Text
  /// 주요 업적
  achievements     String? @db.Text
  /// 주요 전투 경험
  combatExperience String? @map("combat_experience") @db.Text
  /// 수상 경력
  awards           String? @db.Text
  /// 출신 학교 등 교육 배경
  education        String? @db.Text
  /// 저서 또는 발표 자료
  publications     String? @db.Text

  // --- 관계 필드
  /// 지휘 부대
  unit   MilitaryUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  /// 지휘관(인물)
  person Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  // --- 메타데이터
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([unitId])
  @@index([personId])
  @@map("military_unit_commanders")
}

// 참고: WarHistory 모델은 다른 모델에서 참조되지만 원본 스키마에 없어, 완전성을 위해 임시로 추가했습니다.
model WarHistory {
  /// 고유 식별자 (PK)
  id          String    @id @default(uuid()) @db.Char(36)
  /// 전쟁 또는 전투명
  name        String    @unique @db.VarChar(150)
  /// 상세 설명
  description String?   @db.Text
  /// 시작일
  startDate   DateTime? @map("start_date")
  /// 종료일
  endDate     DateTime? @map("end_date")

  // --- 관계 필드
  /// 이 전쟁에 사용된 무기 기록
  weapons        WarHistoryWeapon[]
  /// 이 전쟁에 사용된 지상 장비 기록
  groundVehicles WarHistoryGroundVehicle[]
  /// 이 전쟁에 사용된 항공기 기록
  aircraft       WarHistoryAircraft[]
  /// 이 전쟁에 사용된 함선 기록
  navalVessels   WarHistoryNavalVessel[]
  /// 이 전쟁에 참여한 부대 기록
  militaryUnits  WarHistoryMilitaryUnit[]

  // --- 메타데이터
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("war_histories")
}
