// ========================
// ArtistCareer (예술가 경력 전용)
// ========================
model ArtistCareer {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 인물 ID
  personId String @map("person_id") @db.Char(36)

  /// 타임라인 제목
  timelineTitle String? @map("timeline_title") @db.VarChar(200)

  /// 직책 정보 표시 여부
  showPositionInfo Boolean @default(true) @map("show_position_info")

  /// 직급 ID (화가, 조각가, 작곡가, 배우 등)
  positionId String @map("position_id") @db.Char(36)

  /// 직업 카테고리 ID
  jobCategoryId String? @map("job_category_id") @db.Char(36)

  /// 소속 조직 ID (극단, 화실, 오케스트라 등)
  organizationId String? @map("organization_id") @db.Char(36)

  /// 예술 장르 (유화, 조각, 클래식, 영화 등)
  genre String? @db.VarChar(200)

  /// 작품 활동 분야
  artField String? @map("art_field") @db.VarChar(200)

  /// 시작일
  startDate DateTime? @map("start_date")

  /// 종료일
  endDate DateTime? @map("end_date")

  /// 비고
  notes String? @db.Text

  //--- 관계 필드
  person       Person              @relation("PersonArtistCareers", fields: [personId], references: [id], onDelete: Cascade)
  position     Job                 @relation("ArtistPosition", fields: [positionId], references: [id], onDelete: Restrict)
  organization Organization?       @relation("ArtistOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  images       ArtistCareerImage[]

  //--- 메타데이터
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([personId], name: "idx_artist_career_personId")
  @@index([positionId], name: "idx_artist_career_positionId")
  @@map("artist_career")
}

model ArtistCareerImage {
  id          String        @id @default(uuid()) @db.Char(36)
  careerId    String        @map("career_id") @db.Char(36)
  url         String        @db.VarChar(500)
  description String?       @db.Text
  career      ArtistCareer  @relation(fields: [careerId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([careerId])
  @@map("artist_career_image")
}

// ========================
// AthleteCareer (운동선수 경력)
// ========================
model AthleteCareer {
  id               String               @id @default(uuid()) @db.Char(36)
  personId         String               @map("person_id") @db.Char(36)
  timelineTitle    String?              @map("timeline_title") @db.VarChar(200)
  showPositionInfo Boolean              @default(true) @map("show_position_info")
  positionId       String               @map("position_id") @db.Char(36)
  jobCategoryId    String?              @map("job_category_id") @db.Char(36)
  organizationId   String?              @map("organization_id") @db.Char(36)
  sport            String?              @db.VarChar(100) // 축구, 야구, 육상 등
  position         String?              @db.VarChar(100) // 포지션 (공격수, 투수 등)
  jerseyNumber     Int?                 @map("jersey_number") // 등번호
  startDate        DateTime?            @map("start_date")
  endDate          DateTime?            @map("end_date")
  notes            String?              @db.Text
  person           Person               @relation("PersonAthleteCareers", fields: [personId], references: [id], onDelete: Cascade)
  job              Job                  @relation("AthletePosition", fields: [positionId], references: [id], onDelete: Restrict)
  organization     Organization?        @relation("AthleteOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  images           AthleteCareerImage[]
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([personId])
  @@map("athlete_career")
}

model AthleteCareerImage {
  id          String         @id @default(uuid()) @db.Char(36)
  careerId    String         @map("career_id") @db.Char(36)
  url         String         @db.VarChar(500)
  description String?        @db.Text
  career      AthleteCareer  @relation(fields: [careerId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([careerId])
  @@map("athlete_career_image")
}

