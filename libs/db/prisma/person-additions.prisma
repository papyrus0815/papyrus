// 이 파일은 person.prisma 끝에 추가될 내용입니다

// GovernmentCareer, BusinessCareer, AcademicCareer, ReligiousCareer의 JSON 제거는
// 기존 파일에서 직접 수정 필요

// ========================
// GovernmentCareerImage
// ========================
model GovernmentCareerImage {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 경력 ID
  careerId String @map("career_id") @db.Char(36)

  /// 이미지 URL
  url String @db.VarChar(500)

  /// 설명
  description String? @db.Text

  //--- 관계 필드
  career GovernmentCareer @relation(fields: [careerId], references: [id], onDelete: Cascade)

  //--- 메타데이터
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([careerId], name: "idx_government_career_image_careerId")
  @@map("government_career_image")
}

