// ========================
// PersonAward (수상/훈장)
// ========================
model PersonAward {
  id              String            @id @default(uuid()) @db.Char(36)
  personId        String            @map("person_id") @db.Char(36)
  awardName       String            @map("award_name") @db.VarChar(200) // 노벨상, 올림픽 금메달 등
  category        String?           @db.VarChar(100) // 물리학상, 100m 달리기 등
  awardingBody    String?           @map("awarding_body") @db.VarChar(200) // 수여 기관
  awardDate       DateTime?         @map("award_date")
  description     String?           @db.Text
  person          Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  images          PersonAwardImage[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([personId])
  @@map("person_award")
}

model PersonAwardImage {
  id          String       @id @default(uuid()) @db.Char(36)
  awardId     String       @map("award_id") @db.Char(36)
  url         String       @db.VarChar(500)
