  organizationId   String             @map("organization_id") @db.Char(36) // 방송사, 신문사
  department       String?            @db.VarChar(200) // 부서 (정치부, 경제부 등)
  beat             String?            @db.VarChar(200) // 담당 분야
  startDate        DateTime?          @map("start_date")
  endDate          DateTime?          @map("end_date")
  notes            String?            @db.Text
  person           Person             @relation("PersonMediaCareers", fields: [personId], references: [id], onDelete: Cascade)
  position         Job                @relation("MediaPosition", fields: [positionId], references: [id], onDelete: Restrict)
  organization     Organization       @relation("MediaOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  images           MediaCareerImage[]
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([personId])
