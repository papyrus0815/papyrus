/// ╔══════════════════════════════════════════════════════════════════════════════╗
/// ║                               PERSON DOMAIN                                  ║
/// ╚══════════════════════════════════════════════════════════════════════════════╝
/// 
/// 이 도메인은 역사적/현대적 인물들의 정보를 중앙집중식으로 관리합니다.
/// 
/// 주요 기능:
/// - 인물(Person): 모든 시대의 인물 정보
///   • 기본 신상정보 (이름, 성, 생몰년도, 성별)
///   • 가족 관계 (부모-자식 관계)
///   • 사회적 정체성 (국적, 직업, 종교, 가문)
///   • 생애 기록 및 프로필 이미지
/// 
/// - 인물-국가 관계(PersonCountryAffiliation): 복합적인 국적/소속 관계
///   • 출생지, 시민권, 주요 활동지, 봉사한 국가 등
///   • 역사적 국가와 현대 국가 모두 지원
///   • 시기별 국적 변화 추적
/// 
/// 관계 연결:
/// - 가문(Dynasty): 왕실, 귀족 등 혈통 관계
/// - 종교(Religion/Denomination): 종교적 소속
/// - 직업(Job): 사회적 역할과 지위
/// - 국가(Country/HistoricalCountry): 복합적인 국적 관계
/// - 사건(Event): 참여한 역사적 사건들
/// - 조직(Organization): 소속 조직과 역할
/// - 정당(PoliticalParty): 정치적 소속
/// - 군부대(MilitaryUnit): 군사적 지휘 관계
/// - 기업(Company): 창업 및 경영 관계
/// - 저작(Book): 집필한 도서들
/// 
/// 특징:
/// - 시스템의 핵심 엔티티 중 하나
/// - 다양한 도메인과 광범위한 관계
/// - 가족 관계의 복잡성 모델링
/// - 시대를 초월한 통합 관리
/// - 복합 국적 및 국가 소속 지원

/// 이름 표시 순서 (한국식: 성+이름, 서양식: 이름+성)
enum NameDisplayOrder {
  korean
  western
}

/// 사망 유형
enum DeathType {
  NATURAL       // 자연사
  ILLNESS       // 병사
  ASSASSINATION // 암살
  EXECUTION     // 처형
  BATTLE        // 전사
  ACCIDENT      // 사고사
  SUICIDE       // 자살
  UNKNOWN       // 불명
  OTHER         // 기타
}

/// 인물 간 인간관계 유형
/// - MENTOR: 스승(from) → 제자(to). 친밀도는 선택(없으면 NULL)
/// - GENERAL: 일반 관계. 친밀도(-2..+2 양극형)로 표현, 저장 시 인물 ID 오름차순으로 정규화
enum PersonHumanRelationshipType {
  MENTOR
  GENERAL
}

/// 인간관계 세분화 태그 (한 관계에 다중 부착 가능)
enum PersonRelationshipTag {
  FRIEND       // 친구
  CLOSE_FRIEND // 절친
  LOVER        // 연인
  RIVAL        // 라이벌·경쟁자
  ENEMY        // 정적·원수
  ALLY         // 협력자·맹우
  COLLEAGUE    // 동료
  PATRON       // 후원자·은인
  CLIENT       // 후원받은 자
  RELATIVE     // 친척 (혈연 외 친지)
  OTHER        // 기타
}

/// 인물-국가 관계의 유형
enum PersonCountryAffiliationType {
  /// 출생지
  BIRTH_PLACE
  /// 시민권/국적
  CITIZENSHIP
  /// 주요 활동 지역
  PRIMARY_RESIDENCE
  /// 봉사한 국가 (외교관, 군인 등)
  SERVED
  /// 망명지
  EXILE
  /// 기타
  OTHER
}

// ========================
// Person
// ========================
model Person {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 이름
  name String @db.VarChar(30)

  /// 중간 이름 (Middle Name)
  middleName String? @map("middle_name") @db.VarChar(50)

  /// 성
  surname String? @map("sur_name") @db.VarChar(30)

  /// 원어 이름 (Original Name)
  originalName String? @map("original_name") @db.VarChar(100)

  /// 성의 뜻 (예: 金 = 쇠 금)
  surnameMeaning String? @map("surname_meaning") @db.VarChar(300)
  /// 이름의 뜻 (예: 承 = 이을 승, 煐 = 빛날 영)
  nameMeaning String? @map("name_meaning") @db.VarChar(300)
  /// 중간이름의 뜻
  middleNameMeaning String? @map("middle_name_meaning") @db.VarChar(300)

  /// 이름 표시 순서: korean(성+이름), western(이름+성). null이면 성+이름
  nameDisplayOrder NameDisplayOrder? @map("name_display_order")

  /// 출생 기원 (BC/AD)
  birthEra Era? @default(AD) @map("birth_era")

  /// 출생일
  birthDate DateTime? @map("birth_date")

  /// 출생일 미상 여부
  isBirthDateUnknown Boolean @default(false) @map("is_birth_date_unknown")

  /// 사망 기원 (BC/AD)
  deathEra Era? @default(AD) @map("death_era")

  /// 사망일
  deathDate DateTime? @map("death_date")

  /// 사망일 미상 여부
  isDeathDateUnknown Boolean @default(false) @map("is_death_date_unknown")

  /// 사망 유형 (자연사, 병사, 암살 등)
  deathType DeathType? @map("death_type")

  /// 사망 원인 상세 (예: "폐렴 합병증", "독살 의혹")
  deathCause String? @map("death_cause") @db.VarChar(300)

  /// 사망 관련 메모 (맥락, 논란, 비고 등)
  deathNote String? @map("death_note") @db.Text

  /// 생존 중 여부
  isAlive Boolean @default(false) @map("is_alive")

  /// 역사적 영향력 (0–100)
  influence Int? @map("influence")

  /// 성별
  gender String? @db.VarChar(10)

  /// 생애 소개
  biography String? @db.Text

  /// 프로필 URL
  profileImageUrl String? @map("profile_image_url") @db.VarChar(255)

  /// 이벤트 목록에 생몰년 표시 여부
  showLifespanOnEventList Boolean @default(true) @map("show_lifespan_on_event_list")

  /// 사생아·서출 여부 (가계도 카드에 별표 마커)
  illegitimate Boolean @default(false) @map("illegitimate")

  /// 어느 결혼에서 태어났는지 (PersonSpouse FK) — 다중 배우자 케이스에서 자녀를 어머니별로 묶기.
  /// null이면 미상 또는 단일 배우자 케이스로 모호성 없음.
  parentMarriageId String? @map("parent_marriage_id") @db.Char(36)

  //--- 왕/군주 관련 필드 (인물 고유)
  /// 왕호/재위명 (예: Louis, Henry, 선덕)
  /// 주의: 재위 번호는 국가마다 다르므로 GovernmentPositionTenure에 저장
  regnalName String? @map("regnal_name") @db.VarChar(50)

  /// 묘호 (동아시아 군주, 예: 세종, 태종, 고종)
  templeName String? @map("temple_name") @db.VarChar(50)

  /// 시호 (예: 문종, 무열왕, 효종)
  posthumousName String? @map("posthumous_name") @db.VarChar(100)

  /// 즉위 전 작호/봉호 (예: 수양대군, 충녕대군, 양녕대군)
  preEnthronementTitle String? @map("pre_enthronement_title") @db.VarChar(100)

  //--- 외래키
  dynastyId      String? @map("dynasty_id") @db.Char(36)
  religionId     String? @map("religion_id") @db.Char(36)
  denominationId String? @map("denomination_id") @db.Char(36)
  fatherId       String? @map("father_id") @db.Char(36)
  motherId       String? @map("mother_id") @db.Char(36)
  /// @deprecated 직업 정보는 Career 테이블들 사용 (MilitaryCareer, BusinessCareer 등)
  jobId          String? @map("job_id") @db.Char(36)
  countryId      String? @map("country_id") @db.Char(36) // 주 국적 (간편 조회용, deprecated 예정)
  /// 출생지 (도시)
  birthCityId    String? @map("birth_city_id") @db.Char(36)
  /// 사망지 (도시)
  deathCityId    String? @map("death_city_id") @db.Char(36)
  /// 출생지 행정구역 (도시 없이 행정구역만 선택할 때)
  birthAdminDivisionId String? @map("birth_admin_division_id") @db.Char(36)
  /// 사망지 행정구역 (도시 없이 행정구역만 선택할 때)
  deathAdminDivisionId String? @map("death_admin_division_id") @db.Char(36)
  /// 출생지 직접 입력 텍스트 (역사적 지명 등)
  birthPlaceText String? @map("birth_place_text") @db.VarChar(255)
  /// 사망지 직접 입력 텍스트 (역사적 지명 등)
  deathPlaceText String? @map("death_place_text") @db.VarChar(255)

  //--- 관계 필드
  Company            Company[]
  dynasty            Dynasty?              @relation(fields: [dynastyId], references: [id], onDelete: SetNull)
  religion           Religion?             @relation(fields: [religionId], references: [id], onDelete: SetNull)
  denomination       ReligionDenomination? @relation("DenominationToPerson", fields: [denominationId], references: [id], onDelete: SetNull)
  job                Job?                  @relation("JobToPerson", fields: [jobId], references: [id], onDelete: SetNull)
  country            Country?              @relation("CountryToPerson", fields: [countryId], references: [id], onDelete: SetNull)
  birthCity          City?                 @relation("PersonBirthCity", fields: [birthCityId], references: [id], onDelete: SetNull)
  deathCity          City?                 @relation("PersonDeathCity", fields: [deathCityId], references: [id], onDelete: SetNull)
  birthAdminDivision AdministrativeDivision? @relation("PersonBirthAdminDivision", fields: [birthAdminDivisionId], references: [id], onDelete: SetNull)
  deathAdminDivision AdministrativeDivision? @relation("PersonDeathAdminDivision", fields: [deathAdminDivisionId], references: [id], onDelete: SetNull)
  father             Person?               @relation("ParentChildFather", fields: [fatherId], references: [id], onDelete: SetNull)
  mother             Person?               @relation("ParentChildMother", fields: [motherId], references: [id], onDelete: SetNull)
  childrenFromFather Person[]              @relation("ParentChildFather")
  childrenFromMother Person[]              @relation("ParentChildMother")
  foundedCompanies   Company[]             @relation("FounderToCompany")
  /// 시조로 등록된 가문들 (보통 0~1)
  foundedDynasties   Dynasty[]             @relation("DynastyFounder")

  // 배우자 관계 (혼인 시작/종료일 등)
  spouseRelationsAsPerson PersonSpouse[]   @relation("PersonAsPerson")
  spouseRelationsAsSpouse PersonSpouse[]   @relation("PersonAsSpouse")

  /// 인물 간 인간관계 (from 쪽)
  personHumanRelationshipsFrom PersonHumanRelationship[] @relation("PersonHumanRelFrom")
  /// 인물 간 인간관계 (to 쪽)
  personHumanRelationshipsTo   PersonHumanRelationship[] @relation("PersonHumanRelTo")

  /// 사용자별 능력치 평가
  stats             PersonStats[]            @relation("PersonStatsToPerson")
  /// 사용자별 성격 태그
  traitAssignments  PersonTraitAssignment[]  @relation("PersonTraitsToPerson")

  // 새로운 국가 관계
  countryAffiliations PersonCountryAffiliation[]

  // 별명/호/필명
  nicknames PersonNickname[]

  // 프로필 이미지들
  profileImages PersonProfileImage[]

  // 학력
  educations PersonEducation[] @relation("PersonEducations")

  // 분야별 경력 히스토리 (국가 수반은 GovernmentPositionTenure/연대표에서 관리)
  militaryCareers   MilitaryCareer[]   @relation("PersonMilitaryCareers")
  businessCareers   BusinessCareer[]   @relation("PersonBusinessCareers")
  academicCareers   AcademicCareer[]   @relation("PersonAcademicCareers")
  religiousCareers  ReligiousCareer[]  @relation("PersonReligiousCareers")
  artistCareers     ArtistCareer[]     @relation("PersonArtistCareers")
  athleteCareers    AthleteCareer[]    @relation("PersonAthleteCareers")
  mediaCareers      MediaCareer[]      @relation("PersonMediaCareers")
  legalCareers      LegalCareer[]      @relation("PersonLegalCareers")
  medicalCareers    MedicalCareer[]    @relation("PersonMedicalCareers")

  // 수상/훈장
  awards PersonAward[]

  PersonEvent              PersonEvent[]
  MilitaryUnitCommander    MilitaryUnitCommander[]
  Book                     Book[]
  OrganizationPersonRole   OrganizationPersonRole[]   @relation("OrganizationPersonRoles")
  PoliticalPartyLeadership PoliticalPartyLeadership[] @relation("PoliticalPartyLeadership")
  /// 정당 일반 소속(당원·기간). 지도부는 PoliticalPartyLeadership.
  politicalPartyMemberships PoliticalPartyMembership[] @relation("PoliticalPartyMemberships")
  /// 선거 후보 이력
  electionCandidacies ElectionCandidacy[] @relation("ElectionCandidacies")
  GovernmentTenures        GovernmentPositionTenure[] @relation("PersonGovernmentTenure")
  sovereignReigns          SovereignReign[]           @relation("PersonSovereignReign")
  lifeEvents               PersonLifeEvent[]          @relation("PersonLifeEvents")
  treatySignatories        TreatySignatory[]          @relation("TreatySignatoryPerson")

  // 🆕 정규화된 군사 사건 관계
  commandedBelligerentSides BelligerentSide[]
  commandedCountriesInSides CountryInSide[]

  //--- 등록 계정 (개인 정보 플랫폼: 본인만 수정/삭제)
  accountId String? @map("account_id") @db.Char(36)
  account   Account? @relation("AccountPersons", fields: [accountId], references: [id], onDelete: SetNull)

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([accountId], name: "idx_person_accountId")
  @@index([dynastyId], name: "idx_person_dynastyId")
  @@index([religionId], name: "idx_person_religionId")
  @@index([denominationId], name: "idx_person_denominationId")
  @@index([fatherId], name: "idx_person_fatherId")
  @@index([motherId], name: "idx_person_motherId")
  @@index([jobId], name: "idx_person_jobId")
  @@index([countryId], name: "idx_person_countryId")
  @@index([birthCityId], name: "idx_person_birthCityId")
  @@index([deathCityId], name: "idx_person_deathCityId")
  @@index([parentMarriageId], name: "idx_person_parentMarriageId")
  @@map("person")
}

// ========================
// PersonLifeEvent (인물 연보)
// ========================
/// 인물의 연도별 개인사/활동 기록. 재위(SovereignReign)·행정부 재임(GovernmentPositionTenure)·
/// 공식 사건(Event) 외의 자유 서술형 기록 — 예: "1820년 파리 유학", "1835년 저서 출간".
model PersonLifeEvent {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 인물 FK
  personId String @map("person_id") @db.Char(36)
  person   Person @relation("PersonLifeEvents", fields: [personId], references: [id], onDelete: Cascade)

  /// 제목 (예: "파리 유학")
  title String @db.VarChar(200)

  /// 상세 설명
  description String? @db.Text

  /// 카테고리 (자유 문자열 — 예: EDUCATION, TRAVEL, PUBLICATION, EXILE, AWARD, PERSONAL, OTHER)
  category String? @db.VarChar(30)

  /// 시작일
  startDate          DateTime? @map("start_date")
  /// 시작일 정밀도: year/month/day. null이면 day
  startDatePrecision String?   @map("start_date_precision") @db.VarChar(10)

  /// 종료일 (단일 시점이면 null)
  endDate          DateTime? @map("end_date")
  /// 종료일 정밀도
  endDatePrecision String?   @map("end_date_precision") @db.VarChar(10)

  /// 같은 시점의 여러 이벤트 정렬용
  sortOrder Int? @default(0) @map("sort_order")

  /// 등록 계정
  accountId String?  @map("account_id") @db.Char(36)
  account   Account? @relation("AccountPersonLifeEvents", fields: [accountId], references: [id], onDelete: SetNull)

  /// 이 사건을 근거로 삼는 인간관계들
  humanRelationshipSources PersonHumanRelationshipSource[] @relation("PersonLifeEventSources")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([personId], name: "idx_person_life_event_personId")
  @@index([accountId], name: "idx_person_life_event_accountId")
  @@index([startDate], name: "idx_person_life_event_startDate")
  @@map("person_life_event")
}

// ========================
// PersonSpouse (배우자 관계)
// ========================
/// 인물 간 배우자 관계. 혼인 기간·비고 관리.
model PersonSpouse {
  id                String    @id @default(uuid()) @db.Char(36)
  personId          String    @map("person_id") @db.Char(36)
  spouseId          String    @map("spouse_id") @db.Char(36)
  marriageStartDate DateTime? @map("marriage_start_date") @db.DateTime(3)
  marriageEndDate   DateTime? @map("marriage_end_date") @db.DateTime(3)
  note              String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  person Person @relation("PersonAsPerson", fields: [personId], references: [id], onDelete: Cascade)
  spouse Person @relation("PersonAsSpouse", fields: [spouseId], references: [id], onDelete: Cascade)

  @@index([personId], name: "idx_person_spouse_personId")
  @@index([spouseId], name: "idx_person_spouse_spouseId")
  @@unique([personId, spouseId], name: "person_spouse_person_id_spouse_id_key")
  @@map("person_spouse")
}

// ========================
// PersonHumanRelationship (인물 간 인간관계)
// ========================
/// 멘토(MENTOR): fromPersonId = 스승, toPersonId = 제자
/// GENERAL · isMutual=true: 양쪽이 합의된 대칭 관계 (UUID 정규화로 중복 방지)
/// GENERAL · isMutual=false: from = 시점 인물, to = 상대 인물 (시점별 비대칭 관계)
model PersonHumanRelationship {
  id String @id @default(uuid()) @db.Char(36)

  fromPersonId String @map("from_person_id") @db.Char(36)
  toPersonId   String @map("to_person_id") @db.Char(36)

  relationshipType PersonHumanRelationshipType @map("relationship_type")

  /// GENERAL 전용 — true면 양쪽 합의된 대칭 관계, false면 from(주체) 시점만 표현
  isMutual Boolean @default(false) @map("is_mutual")

  /// 친밀도: -2(매우 적대) ~ +2(매우 우호). NULL = 기록 없음(unknown). 0 = 중립으로 명시.
  affinityLevel Int? @map("affinity_level")

  /// 신뢰도: -2(매우 불신) ~ +2(완전 신뢰). NULL = 기록 없음.
  /// 친밀도와 분리 — "좋아하지만 신뢰는 안 한다"형 케이스 표현용.
  trustLevel Int? @map("trust_level")

  /// 권력 비대칭: -2(매우 종속) ~ 0(대등) ~ +2(매우 우위). from 인물 기준.
  /// MENTOR에서는 보통 +1~+2(스승 우위). NULL = 해당 없음.
  powerDynamic Int? @map("power_dynamic")

  /// 격식: -2(매우 친밀·격의없음) ~ +2(매우 격식·예의). NULL = 기록 없음.
  formality Int? @map("formality")

  startDate DateTime? @map("start_date") @db.DateTime(3)
  endDate   DateTime? @map("end_date") @db.DateTime(3)
  note      String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  fromPerson Person @relation("PersonHumanRelFrom", fields: [fromPersonId], references: [id], onDelete: Cascade)
  toPerson   Person @relation("PersonHumanRelTo", fields: [toPersonId], references: [id], onDelete: Cascade)

  /// 세분화 태그(친구·라이벌·후원자 등) — 다중 부착 가능
  tags PersonHumanRelationshipTagAssignment[] @relation("PersonHumanRelTagAssignments")

  /// 근거 사건(연보) 연결 — 다중 부착 가능
  sources PersonHumanRelationshipSource[] @relation("PersonHumanRelSources")

  /// 시기별 스냅샷 — 한 관계가 시간에 따라 친밀도·차원이 달라지는 변화를 기록.
  /// 비어 있으면 위 본체의 단일 값(affinityLevel 등)이 전 기간 대표값으로 사용됨.
  phases PersonHumanRelationshipPhase[] @relation("PersonHumanRelPhases")

  @@index([fromPersonId], name: "idx_person_human_rel_from")
  @@index([toPersonId], name: "idx_person_human_rel_to")
  @@unique([fromPersonId, toPersonId, relationshipType], name: "person_human_rel_pair_type_key")
  @@map("person_human_relationship")
}

// ========================
// PersonHumanRelationshipPhase (시기별 스냅샷)
// ========================
/// 한 관계가 시간이 흐르며 변하는 구간을 표현. 예: 차르토리스키-알렉산드르 1세
/// "1795~1801 절친 → 1815~1820 협력자 → 1830~ 정치적 결별".
/// affinity·trust·power·formality·tags·note 모두 phase별로 가질 수 있음.
model PersonHumanRelationshipPhase {
  id String @id @default(uuid()) @db.Char(36)

  relationshipId String @map("relationship_id") @db.Char(36)

  /// phase 시작·종료 — startDate가 NULL이면 "관계 시작과 동일", endDate가 NULL이면 "현재까지/관계 종료까지"
  startDate DateTime? @map("start_date") @db.DateTime(3)
  endDate   DateTime? @map("end_date") @db.DateTime(3)

  affinityLevel Int? @map("affinity_level")
  trustLevel    Int? @map("trust_level")
  powerDynamic  Int? @map("power_dynamic")
  formality     Int? @map("formality")

  /// 이 phase의 짧은 라벨 (예: "황태자 시절", "외무장관 시기", "결별기")
  label String? @db.VarChar(120)

  note String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  relationship PersonHumanRelationship @relation("PersonHumanRelPhases", fields: [relationshipId], references: [id], onDelete: Cascade)

  @@index([relationshipId], name: "idx_person_human_rel_phase_relId")
  @@index([startDate], name: "idx_person_human_rel_phase_start")
  @@map("person_human_relationship_phase")
}

// ========================
// PersonHumanRelationshipSource (관계 근거)
// ========================
/// PersonHumanRelationship의 근거가 되는 PersonLifeEvent(연보) 연결.
/// 한 관계에 여러 사건을 근거로 부착 가능.
model PersonHumanRelationshipSource {
  id             String @id @default(uuid()) @db.Char(36)
  relationshipId String @map("relationship_id") @db.Char(36)
  lifeEventId    String @map("life_event_id") @db.Char(36)

  /// 짧은 메모 (예: "이 사건에서 처음 만남")
  note String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  relationship PersonHumanRelationship @relation("PersonHumanRelSources", fields: [relationshipId], references: [id], onDelete: Cascade)
  lifeEvent    PersonLifeEvent         @relation("PersonLifeEventSources", fields: [lifeEventId], references: [id], onDelete: Cascade)

  @@unique([relationshipId, lifeEventId], name: "person_human_rel_source_unique")
  @@index([relationshipId], name: "idx_person_human_rel_source_relId")
  @@index([lifeEventId], name: "idx_person_human_rel_source_eventId")
  @@map("person_human_relationship_source")
}

// ========================
// PersonHumanRelationshipTagAssignment
// ========================
/// PersonHumanRelationship에 부착되는 태그 (다대다)
model PersonHumanRelationshipTagAssignment {
  id             String                  @id @default(uuid()) @db.Char(36)
  relationshipId String                  @map("relationship_id") @db.Char(36)
  tag            PersonRelationshipTag

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  relationship PersonHumanRelationship @relation("PersonHumanRelTagAssignments", fields: [relationshipId], references: [id], onDelete: Cascade)

  @@unique([relationshipId, tag], name: "person_human_rel_tag_unique")
  @@index([relationshipId], name: "idx_person_human_rel_tag_relId")
  @@index([tag], name: "idx_person_human_rel_tag_tag")
  @@map("person_human_relationship_tag")
}

// ========================
// PersonCountryAffiliation
// ========================
/// 인물과 국가(현대/역사적) 간의 소속/관계를 나타내는 중간 테이블
/// 
/// 사용 예시:
/// - 비스마르크: BIRTH_PLACE(프로이센), CITIZENSHIP(독일 제국), SERVED(독일 제국, 프로이센)
/// - 아인슈타인: BIRTH_PLACE(독일), CITIZENSHIP(스위스, 미국), EXILE(미국)
model PersonCountryAffiliation {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 인물 ID
  personId String @map("person_id") @db.Char(36)

  /// 현대 국가 ID (둘 중 하나는 필수)
  countryId String? @map("country_id") @db.Char(36)

  /// 역사적 국가 ID (둘 중 하나는 필수)
  historicalCountryId String? @map("historical_country_id") @db.Char(36)

  /// 관계 유형
  affiliationType PersonCountryAffiliationType @map("affiliation_type")

  /// 관계 시작일 (선택)
  startDate DateTime? @map("start_date")

  /// 관계 종료일 (선택)
  endDate DateTime? @map("end_date")

  /// 우선순위 (주 국적 판단 등에 사용, 낮을수록 우선)
  priority Int? @default(0)

  /// 비고
  note String? @db.Text

  //--- 관계 필드
  person            Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  country           Country?           @relation("PersonCountryAffiliations", fields: [countryId], references: [id], onDelete: Cascade)
  historicalCountry HistoricalCountry? @relation("PersonHistoricalCountryAffiliations", fields: [historicalCountryId], references: [id], onDelete: Cascade)

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([personId], name: "idx_person_country_aff_personId")
  @@index([countryId], name: "idx_person_country_aff_countryId")
  @@index([historicalCountryId], name: "idx_person_country_aff_histCountryId")
  @@index([affiliationType], name: "idx_person_country_aff_type")
  @@map("person_country_affiliation")
}

