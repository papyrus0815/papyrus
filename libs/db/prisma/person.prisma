// ========================
// PersonStats (인물 능력치 — 6축 레이더, 사용자별 평가)
// ========================
/// 한 인물에 대해 *사용자(account)별*로 매기는 6축 능력치.
/// (personId, accountId)가 unique — 한 사용자는 한 인물당 한 세트.
/// 점수는 각 0~100. 미평가 차원은 NULL.
model PersonStats {
  id        String  @id @default(uuid()) @db.Char(36)
  personId  String  @map("person_id") @db.Char(36)
  accountId String  @map("account_id") @db.Char(36)

  /// 정치 (정쟁·국내 권력 운용)
  politics       Int? @db.SmallInt
  /// 군사 (야전 지휘·전략)
  military       Int? @db.SmallInt
  /// 외교 (협상·동맹)
  diplomacy      Int? @db.SmallInt
  /// 학식 (학문·저술)
  intellect      Int? @db.SmallInt
  /// 카리스마 (대중·부하 장악)
  charisma       Int? @db.SmallInt
  /// 행정 (통치·재정·관료 운용)
  administration Int? @db.SmallInt

  /// 평가 자유 메모 (예: "초기엔 군사 중심, 만년에는 학문")
  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  person  Person  @relation("PersonStatsToPerson", fields: [personId], references: [id], onDelete: Cascade)
  account Account @relation("PersonStatsToAccount", fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([personId, accountId], name: "person_stats_person_account_key")
  @@index([personId], name: "idx_person_stats_personId")
  @@index([accountId], name: "idx_person_stats_accountId")
  @@map("person_stats")
}

/// 인물 성격 태그 (사료에서 형용사로 묘사되는 결).
/// 양극 페어(BRUTAL ↔ MERCIFUL 등)도 동시 부착 가능 — 평가자에 따라 갈리는 것이 자연.
enum PersonTrait {
  AMBITIOUS    // 야망가
  CAUTIOUS     // 신중함
  IMPULSIVE    // 충동적
  DELIBERATE   // 사려깊음
  COURAGEOUS   // 용감함
  COWARDLY     // 비겁함
  BRUTAL       // 잔혹함
  MERCIFUL     // 자비로움
  GENEROUS     // 관대함
  GREEDY       // 탐욕스러움
  LOYAL        // 충성스러움
  TREACHEROUS  // 배신·기만
  PIOUS        // 독실함
  SECULAR      // 세속적
  SCHOLARLY    // 학자적
  CHARISMATIC  // 카리스마형
  AUSTERE      // 엄격·금욕
  LIBERTINE    // 방종
  JUST         // 정의로움
  VENGEFUL     // 복수심
  PATIENT      // 인내·끈기
  HOT_TEMPERED // 다혈질
  HUMBLE       // 겸손
  ARROGANT     // 오만
  OTHER        // 기타
}

// ========================
// PersonTraitAssignment (인물 성격 태그 부착, 사용자별 다중)
// ========================
/// 한 사용자가 한 인물에 부착하는 성격 태그.
/// (personId, accountId, trait)가 unique — 같은 사용자가 같은 태그 중복 부착 방지.
model PersonTraitAssignment {
  id        String      @id @default(uuid()) @db.Char(36)
  personId  String      @map("person_id") @db.Char(36)
  accountId String      @map("account_id") @db.Char(36)
  trait     PersonTrait

  /// 강도 1(약함) ~ 3(강함). null이면 미설정.
  intensity Int? @db.SmallInt

  /// 자유 메모 (왜 이 태그인지)
  note String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  person  Person  @relation("PersonTraitsToPerson", fields: [personId], references: [id], onDelete: Cascade)
  account Account @relation("PersonTraitsToAccount", fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([personId, accountId, trait], name: "person_trait_assignment_unique")
  @@index([personId], name: "idx_person_trait_personId")
  @@index([accountId], name: "idx_person_trait_accountId")
  @@index([trait], name: "idx_person_trait_trait")
  @@map("person_trait_assignment")
}
