  educationType String? @map("education_type") @db.VarChar(50)

  /// 기수 (육사 50기, 공사 32기 등) - 군 사관학교 전용
  classNumber Int? @map("class_number")

  /// 학위 유형 (학사, 석사, 박사, 수료 등)
  degree String? @db.VarChar(50)

  /// 전공
  major String? @db.VarChar(200)

  /// 학과
  department String? @db.VarChar(200)

  /// 입학일
  startDate DateTime? @map("start_date")

  /// 졸업일/수료일
  endDate DateTime? @map("end_date")

  /// 졸업 여부 (졸업/수료/중퇴/재학중)
  status String? @db.VarChar(50)

  /// 학번/학위번호
  studentNumber String? @map("student_number") @db.VarChar(50)

  /// 비고
  notes String? @db.Text

  //--- 관계 필드
