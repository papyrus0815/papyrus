// ========================
// ArtistCareer (예술가 경력 전용)
// ========================
model ArtistCareer {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 인물 ID
  personId String @map("person_id") @db.Char(36)

  /// 타임라인 제목
  timelineTitle String? @map("timeline_title") @db.VarChar(200)

  /// 직책 정보 표시 여부
  showPositionInfo Boolean @default(true) @map("show_position_info")

  /// 직급 ID (화가, 조각가, 작곡가, 배우 등)
  positionId String @map("position_id") @db.Char(36)

  /// 직업 카테고리 ID
  jobCategoryId String? @map("job_category_id") @db.Char(36)

  /// 소속 조직 ID (극단, 화실, 오케스트라 등)
  organizationId String? @map("organization_id") @db.Char(36)

  /// 예술 장르 (유화, 조각, 클래식, 영화 등)
  genre String? @db.VarChar(200)

  /// 작품 활동 분야
  artField String? @map("art_field") @db.VarChar(200)

  /// 시작일
  startDate DateTime? @map("start_date")

  /// 종료일
  endDate DateTime? @map("end_date")

  /// 비고
  notes String? @db.Text

  //--- 관계 필드
  person       Person              @relation("PersonArtistCareers", fields: [personId], references: [id], onDelete: Cascade)
  position     Job                 @relation("ArtistPosition", fields: [positionId], references: [id], onDelete: Restrict)
  organization Organization?       @relation("ArtistOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  images       ArtistCareerImage[]

  //--- 메타데이터
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([personId], name: "idx_artist_career_personId")
  @@index([positionId], name: "idx_artist_career_positionId")
  @@map("artist_career")
}

