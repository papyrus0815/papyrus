/// ╔══════════════════════════════════════════════════════════════════════════════╗
/// ║                               PERSON DOMAIN                                  ║
/// ╚══════════════════════════════════════════════════════════════════════════════╝
/// 
/// 이 도메인은 역사적/현대적 인물들의 정보를 중앙집중식으로 관리합니다.
/// 
/// 주요 기능:
/// - 인물(Person): 모든 시대의 인물 정보
///   • 기본 신상정보 (이름, 성, 생몰년도, 성별)
///   • 가족 관계 (부모-자식 관계)
///   • 사회적 정체성 (국적, 직업, 종교, 가문)
///   • 생애 기록 및 프로필 이미지
/// 
/// - 인물-국가 관계(PersonCountryAffiliation): 복합적인 국적/소속 관계
///   • 출생지, 시민권, 주요 활동지, 봉사한 국가 등
///   • 역사적 국가와 현대 국가 모두 지원
///   • 시기별 국적 변화 추적
/// 
/// 관계 연결:
/// - 가문(Dynasty): 왕실, 귀족 등 혈통 관계
/// - 종교(Religion/Denomination): 종교적 소속
/// - 직업(Job): 사회적 역할과 지위
/// - 국가(Country/HistoricalCountry): 복합적인 국적 관계
/// - 사건(Event): 참여한 역사적 사건들
/// - 조직(Organization): 소속 조직과 역할
/// - 정당(PoliticalParty): 정치적 소속
/// - 군부대(MilitaryUnit): 군사적 지휘 관계
/// - 기업(Company): 창업 및 경영 관계
/// - 저작(Book): 집필한 도서들
/// 
/// 특징:
/// - 시스템의 핵심 엔티티 중 하나
/// - 다양한 도메인과 광범위한 관계
/// - 가족 관계의 복잡성 모델링
/// - 시대를 초월한 통합 관리
/// - 복합 국적 및 국가 소속 지원

/// 인물-국가 관계의 유형
enum PersonCountryAffiliationType {
  /// 출생지
  BIRTH_PLACE
  /// 시민권/국적
  CITIZENSHIP
  /// 주요 활동 지역
  PRIMARY_RESIDENCE
  /// 봉사한 국가 (외교관, 군인 등)
  SERVED
  /// 망명지
  EXILE
  /// 기타
  OTHER
}

// ========================
// Person
// ========================
model Person {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 이름
  name String @db.VarChar(30)

  /// 중간 이름 (Middle Name)
  middleName String? @map("middle_name") @db.VarChar(50)

  /// 성
  surname String? @map("sur_name") @db.VarChar(30)

  /// 원어 이름 (Original Name)
  originalName String? @map("original_name") @db.VarChar(100)

  /// 출생 기원 (BC/AD)
  birthEra Era? @default(AD) @map("birth_era")

  /// 출생일
  birthDate DateTime? @map("birth_date")

  /// 출생일 미상 여부
  isBirthDateUnknown Boolean @default(false) @map("is_birth_date_unknown")

  /// 사망 기원 (BC/AD)
  deathEra Era? @default(AD) @map("death_era")

  /// 사망일
  deathDate DateTime? @map("death_date")

  /// 사망일 미상 여부
  isDeathDateUnknown Boolean @default(false) @map("is_death_date_unknown")

  /// 생존 중 여부
  isAlive Boolean @default(false) @map("is_alive")

  /// 성별
  gender String? @db.VarChar(10)

  /// 생애 소개
  biography String? @db.Text

  /// 프로필 URL
  profileImageUrl String? @map("profile_image_url") @db.VarChar(255)

  /// 이벤트 목록에 생몰년 표시 여부
  showLifespanOnEventList Boolean @default(true) @map("show_lifespan_on_event_list")

  //--- 왕/군주 관련 필드 (인물 고유)
  /// 왕호/재위명 (예: Louis, Henry, 선덕)
  /// 주의: 재위 번호는 국가마다 다르므로 GovernmentPositionTenure에 저장
  regnalName String? @map("regnal_name") @db.VarChar(50)

  /// 묘호 (동아시아 군주, 예: 세종, 태종, 고종)
  templeName String? @map("temple_name") @db.VarChar(50)

  /// 시호 (예: 문종, 무열왕, 효종)
  posthumousName String? @map("posthumous_name") @db.VarChar(100)

  //--- 외래키
  dynastyId      String? @map("dynasty_id") @db.Char(36)
  religionId     String? @map("religion_id") @db.Char(36)
  denominationId String? @map("denomination_id") @db.Char(36)
  fatherId       String? @map("father_id") @db.Char(36)
  motherId       String? @map("mother_id") @db.Char(36)
  /// @deprecated 직업 정보는 Career 테이블들 사용 (MilitaryCareer, BusinessCareer 등)
  jobId          String? @map("job_id") @db.Char(36)
  countryId      String? @map("country_id") @db.Char(36) // 주 국적 (간편 조회용, deprecated 예정)

  //--- 관계 필드
  Company            Company[]
  dynasty            Dynasty?              @relation(fields: [dynastyId], references: [id], onDelete: SetNull)
  religion           Religion?             @relation(fields: [religionId], references: [id], onDelete: SetNull)
  denomination       ReligionDenomination? @relation("DenominationToPerson", fields: [denominationId], references: [id], onDelete: SetNull)
  job                Job?                  @relation("JobToPerson", fields: [jobId], references: [id], onDelete: SetNull)
  country            Country?              @relation("CountryToPerson", fields: [countryId], references: [id], onDelete: SetNull)
  father             Person?               @relation("ParentChildFather", fields: [fatherId], references: [id], onDelete: SetNull)
  mother             Person?               @relation("ParentChildMother", fields: [motherId], references: [id], onDelete: SetNull)
  childrenFromFather Person[]              @relation("ParentChildFather")
  childrenFromMother Person[]              @relation("ParentChildMother")
  foundedCompanies   Company[]             @relation("FounderToCompany")

  // 새로운 국가 관계
  countryAffiliations PersonCountryAffiliation[]

  // 별명/호/필명
  nicknames PersonNickname[]

  // 프로필 이미지들
  profileImages PersonProfileImage[]

  // 학력
  educations PersonEducation[] @relation("PersonEducations")

  // 분야별 경력 히스토리
  militaryCareers   MilitaryCareer[]   @relation("PersonMilitaryCareers")
  governmentCareers GovernmentCareer[] @relation("PersonGovernmentCareers")
  businessCareers   BusinessCareer[]   @relation("PersonBusinessCareers")
  academicCareers   AcademicCareer[]   @relation("PersonAcademicCareers")
  religiousCareers  ReligiousCareer[]  @relation("PersonReligiousCareers")
  artistCareers     ArtistCareer[]     @relation("PersonArtistCareers")
  athleteCareers    AthleteCareer[]    @relation("PersonAthleteCareers")
  mediaCareers      MediaCareer[]      @relation("PersonMediaCareers")
  legalCareers      LegalCareer[]      @relation("PersonLegalCareers")
  medicalCareers    MedicalCareer[]    @relation("PersonMedicalCareers")

  // 수상/훈장
  awards PersonAward[]

  EventTimelinePerson      EventTimelinePerson[]
  PersonEvent              PersonEvent[]
  MilitaryUnitCommander    MilitaryUnitCommander[]
  Book                     Book[]
  OrganizationPersonRole   OrganizationPersonRole[]   @relation("OrganizationPersonRoles")
  PoliticalPartyLeadership PoliticalPartyLeadership[] @relation("PoliticalPartyLeadership")
  GovernmentTenures        GovernmentPositionTenure[] @relation("PersonGovernmentTenure")

  // 🆕 정규화된 군사 사건 관계
  commandedBelligerentSides BelligerentSide[]
  commandedCountriesInSides CountryInSide[]

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([dynastyId], name: "idx_person_dynastyId")
  @@index([religionId], name: "idx_person_religionId")
  @@index([denominationId], name: "idx_person_denominationId")
  @@index([fatherId], name: "idx_person_fatherId")
  @@index([motherId], name: "idx_person_motherId")
  @@index([jobId], name: "idx_person_jobId")
  @@index([countryId], name: "idx_person_countryId")
  @@map("person")
}

// ========================
// PersonCountryAffiliation
// ========================
/// 인물과 국가(현대/역사적) 간의 소속/관계를 나타내는 중간 테이블
/// 
/// 사용 예시:
/// - 비스마르크: BIRTH_PLACE(프로이센), CITIZENSHIP(독일 제국), SERVED(독일 제국, 프로이센)
/// - 아인슈타인: BIRTH_PLACE(독일), CITIZENSHIP(스위스, 미국), EXILE(미국)
model PersonCountryAffiliation {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 인물 ID
  personId String @map("person_id") @db.Char(36)

  /// 현대 국가 ID (둘 중 하나는 필수)
  countryId String? @map("country_id") @db.Char(36)

  /// 역사적 국가 ID (둘 중 하나는 필수)
  historicalCountryId String? @map("historical_country_id") @db.Char(36)

  /// 관계 유형
  affiliationType PersonCountryAffiliationType @map("affiliation_type")

  /// 관계 시작일 (선택)
  startDate DateTime? @map("start_date")

  /// 관계 종료일 (선택)
  endDate DateTime? @map("end_date")

  /// 우선순위 (주 국적 판단 등에 사용, 낮을수록 우선)
  priority Int? @default(0)

  /// 비고
  note String? @db.Text

  //--- 관계 필드
  person            Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  country           Country?           @relation("PersonCountryAffiliations", fields: [countryId], references: [id], onDelete: Cascade)
  historicalCountry HistoricalCountry? @relation("PersonHistoricalCountryAffiliations", fields: [historicalCountryId], references: [id], onDelete: Cascade)

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([personId], name: "idx_person_country_aff_personId")
  @@index([countryId], name: "idx_person_country_aff_countryId")
  @@index([historicalCountryId], name: "idx_person_country_aff_histCountryId")
  @@index([affiliationType], name: "idx_person_country_aff_type")
  @@map("person_country_affiliation")
}

// ========================
// PersonNickname (별명/호/필명)
// ========================
model PersonNickname {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 인물 ID
  personId String @map("person_id") @db.Char(36)

  /// 별명/호/필명
  nickname String @db.VarChar(100)

  /// 유형 (별명, 호, 필명, 아호 등)
  type String? @db.VarChar(50)

  /// 우선순위 (낮을수록 우선)
  priority Int? @default(0)

  //--- 관계 필드
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  //--- 메타데이터
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([personId], name: "idx_person_nickname_personId")
  @@map("person_nickname")
}

// ========================
// PersonProfileImage (프로필 이미지)
// ========================
model PersonProfileImage {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 인물 ID
  personId String @map("person_id") @db.Char(36)

  /// 이미지 URL
  url String @db.VarChar(500)

  /// 설명/캡션
  description String? @db.Text

  /// 우선순위 (낮을수록 우선, 0이 메인 프로필)
  priority Int? @default(0)

  //--- 관계 필드
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  //--- 메타데이터
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([personId], name: "idx_person_profile_image_personId")
  @@map("person_profile_image")
}

// ========================
// PersonEducation (학력)
// ========================
/// 인물의 학력 정보를 저장하는 테이블
/// 
/// 사용 예시:
/// - 백선엽 장군: 육군사관학교, 50기, 군사학 학사
/// - 아인슈타인: 프린스턴 대학교, 박사, 물리학
model PersonEducation {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 인물 ID
  personId String @map("person_id") @db.Char(36)

  /// 타임라인 제목
  timelineTitle String? @map("timeline_title") @db.VarChar(200)

  /// 학교/교육기관 ID (육사, 공사, 서울대 등)
  organizationId String @map("organization_id") @db.Char(36)

  /// 교육 유형 (정규교육, 단기과정, 특수과정 등)
  educationType String? @map("education_type") @db.VarChar(50)

  /// 기수 (육사 50기, 공사 32기 등) - 군 사관학교 전용
  classNumber Int? @map("class_number")

  /// 학위 유형 (학사, 석사, 박사, 수료 등)
  degree String? @db.VarChar(50)

  /// 전공
  major String? @db.VarChar(200)

  /// 학과
  department String? @db.VarChar(200)

  /// 입학일
  startDate DateTime? @map("start_date")

  /// 졸업일/수료일
  endDate DateTime? @map("end_date")

  /// 졸업 여부 (졸업/수료/중퇴/재학중)
  status String? @db.VarChar(50)

  /// 학번/학위번호
  studentNumber String? @map("student_number") @db.VarChar(50)

  /// 비고
  notes String? @db.Text

  //--- 관계 필드
  person       Person           @relation("PersonEducations", fields: [personId], references: [id], onDelete: Cascade)
  organization Organization     @relation("EducationOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  images       EducationImage[]

  //--- 메타데이터
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([personId], name: "idx_person_education_personId")
  @@index([organizationId], name: "idx_person_education_orgId")
  @@index([classNumber], name: "idx_person_education_classNumber")
  @@map("person_education")
}

// ========================
// EducationImage (학력 이미지)
// ========================
model EducationImage {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 학력 ID
  educationId String @map("education_id") @db.Char(36)

  /// 이미지 URL
  url String @db.VarChar(500)

  /// 설명 (졸업증서, 학위증, 기념사진 등)
  description String? @db.Text

  //--- 관계 필드
  education PersonEducation @relation(fields: [educationId], references: [id], onDelete: Cascade)

  //--- 메타데이터
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([educationId], name: "idx_education_image_educationId")
  @@map("education_image")
}

// ========================
// MilitaryCareer (군인 경력 전용)
// ========================
/// 군인 경력 전용 테이블
/// 예시: 백선엽 장군 - 대장, 제8군단, 군단장
model MilitaryCareer {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 인물 ID
  personId String @map("person_id") @db.Char(36)

  /// 타임라인 제목
  timelineTitle String? @map("timeline_title") @db.VarChar(200)

  /// 직책 정보 표시 여부
  showPositionInfo Boolean @default(true) @map("show_position_info")

  /// 군 계급 ID (대장, 중장, 소장 등)
  rankId String @map("rank_id") @db.Char(36)

  /// 직업 카테고리 ID
  jobCategoryId String? @map("job_category_id") @db.Char(36)

  /// 군종 (육군, 해군, 공군, 해병대)
  branch String @db.VarChar(50)

  /// 소속 부대/조직 ID
  organizationId String @map("organization_id") @db.Char(36)

  /// 보직 (군단장, 사단장, 참모총장 등)
  position String? @db.VarChar(100)

  /// 대수 (예: 2대 군단장)
  termNumber Int? @map("term_number")

  /// 시작일
  startDate DateTime? @map("start_date")

  /// 종료일
  endDate DateTime? @map("end_date")

  /// 비고
  notes String? @db.Text

  //--- 관계 필드
  person       Person                @relation("PersonMilitaryCareers", fields: [personId], references: [id], onDelete: Cascade)
  rank         Job                   @relation("MilitaryRank", fields: [rankId], references: [id], onDelete: Restrict)
  organization Organization          @relation("MilitaryOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  images       MilitaryCareerImage[]

  //--- 메타데이터
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([personId], name: "idx_military_career_personId")
  @@index([rankId], name: "idx_military_career_rankId")
  @@index([organizationId], name: "idx_military_career_orgId")
  @@map("military_career")
}

// ========================
// MilitaryCareerImage
// ========================
model MilitaryCareerImage {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 경력 ID
  careerId String @map("career_id") @db.Char(36)

  /// 이미지 URL
  url String @db.VarChar(500)

  /// 설명
  description String? @db.Text

  //--- 관계 필드
  career MilitaryCareer @relation(fields: [careerId], references: [id], onDelete: Cascade)

  //--- 메타데이터
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([careerId], name: "idx_military_career_image_careerId")
  @@map("military_career_image")
}

// ========================
// GovernmentCareer (공무원/정치인 경력 전용)
// ========================
/// 🔷 일반 공무원/정치인의 경력 타임라인 기록
/// 
/// ⚠️ 중요: government.prisma의 GovernmentPositionTenure와의 차이
/// ┌──────────────────────────────────────────────────────────────────────┐
/// │ GovernmentCareer (이 테이블)                                          │
/// │ ✓ 용도: 일반 공무원/정치인의 career path                              │
/// │ ✓ 대상: 장관, 차관, 국회의원, 지방정부, 일반 관직                      │
/// │ ✓ 참조: Job 테이블 (일반 직업 분류)                                   │
/// │ ✓ 국가: Country만 지원 (현대 국가)                                    │
/// │ ✓ 예시: 외교부 장관, 국회의원, 서울시장, 국방부 차관                   │
/// │                                                                        │
/// │ GovernmentPositionTenure (government.prisma)                          │
/// │ ✓ 용도: 국가 최고 지도자의 공식 재임 기록                              │
/// │ ✓ 대상: 국가원수, 왕, 황제, 대통령, 총리, 왕세자                       │
/// │ ✓ 참조: GovernmentPositionDefinition (공식 관직 정의)                 │
/// │ ✓ 국가: Country + HistoricalCountry 모두 지원                         │
/// │ ✓ 상세: 연호, 재위번호, 묘호, 시호, 왕조 연결                          │
/// │ ✓ 예시: 제20대 대통령, 조선 제4대 국왕 세종, 루이 14세                 │
/// └──────────────────────────────────────────────────────────────────────┘
/// 
/// 활용 사례:
/// - 외교부 장관 (2020~2022) → 국방부 장관 (2022~2024)
/// - 국회의원 20대 (2016~2020) → 21대 (2020~2024)
/// - 서울시장 (2018~2022)
/// - 조선 이조판서 (1450~1455)
model GovernmentCareer {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 인물 ID
  personId String @map("person_id") @db.Char(36)

  /// 타임라인 제목
  timelineTitle String? @map("timeline_title") @db.VarChar(200)

