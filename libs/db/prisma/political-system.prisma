/// ╔══════════════════════════════════════════════════════════════════════════════╗
/// ║                         POLITICAL SYSTEM DOMAIN                             ║
/// ╚══════════════════════════════════════════════════════════════════════════════╝
///
/// 국가의 **정체(政體)** — 대통령제냐 의원내각제냐, 단원제냐 양원제냐.
///
/// 국가에 붙은 붙박이 필드가 아니라 **기간을 가진 레코드**다. 정체는 바뀌기 때문이다.
/// 프랑스는 제3·4공화국이 의원내각제였다가 제5공화국에서 이원집정부제가 됐고, 대한민국은
/// 제1~6공화국을 오가며 대통령제↔의원내각제, 단원↔양원을 여러 번 바꿨다. 국가당 한 값으로
/// 두면 그 역사가 통째로 사라진다.
///
/// 현대 국가(Country)와 과거 국가(HistoricalCountry) 양쪽에 붙는다 — 이 앱의 dual FK 규약
/// (역사 우선 + 현대는 dual-fill)을 따른다.

/// 정부 형태 — 행정권이 어디에 있는가.
/// base.prisma의 GovernmentType(대통령제/의원내각제/군사정권/군주제/기타)은 어느 모델도
/// 참조하지 않는 고아 enum이고 군주제를 입헌/절대로 못 가른다. 여기서 더 촘촘히 다시 센다.
enum GovernmentForm {
  /// 대통령제 — 국가원수가 곧 정부수반
  PRESIDENTIAL
  /// 의원내각제 — 정부수반이 의회에 책임
  PARLIAMENTARY
  /// 이원집정부제(반대통령제) — 대통령과 총리가 행정권을 나눠 가짐
  SEMI_PRESIDENTIAL
  /// 입헌군주제 — 군주는 상징, 실권은 내각·의회
  CONSTITUTIONAL_MONARCHY
  /// 절대군주제
  ABSOLUTE_MONARCHY
  /// 군사정권 — 군부가 행정권 장악
  MILITARY
  /// 일당제 국가
  ONE_PARTY
  /// 신정 — 종교 권위가 통치
  THEOCRACY
  /// 과도정부·임시정부
  PROVISIONAL
  /// 기타
  OTHER
}

/// 입법부 구성
enum LegislatureType {
  /// 단원제
  UNICAMERAL
  /// 양원제
  BICAMERAL
  /// 의회 없음 (절대군주제·군정 등)
  NONE
}

/// 국가 구조
enum StateStructure {
  /// 연방제
  FEDERAL
  /// 단일국가
  UNITARY
  /// 국가연합
  CONFEDERATION
  /// 기타
  OTHER
}

/// 정당제
enum PartySystem {
  /// 일당제
  ONE_PARTY
  /// 양당제
  TWO_PARTY
  /// 다당제
  MULTI_PARTY
  /// 무정당 (정당 자체가 없거나 금지)
  NON_PARTISAN
  /// 기타
  OTHER
}

/// 국가원수 선출·계승 방식
enum HeadSelectionMethod {
  /// 국민 직선 (결선투표 포함)
  DIRECT
  /// 간선 (의회·선거인단·통일주체국민회의 등)
  INDIRECT
  /// 세습 (왕위·황위 계승)
  HEREDITARY
  /// 임명·지명 (총독, 최고지도자 지명 등)
  APPOINTED
  /// 군사집권·비상추대
  COUP_OR_JUNTA
  /// 기타
  OTHER
}

/// 의회(하원·단원 기준) 주 선거제도 유형
enum ElectoralSystemType {
  /// 소선거구 단순다수제
  FPTP
  /// 결선투표제 (2회 투표제)
  TWO_ROUND
  /// 병립형 (지역구 + 비례대표 별도 산정)
  PARALLEL
  /// 연동형 비례대표제 (준연동형 포함)
  MMP
  /// 정당명부식 비례대표제
  PARTY_LIST_PR
  /// 중·대선거구 단기비이양식
  SNTV_MMDP
  /// 단기이양식 선호투표
  STV
  /// 간선·선거인단·직능선출
  INDIRECT_ELECTORAL
  /// 기타
  OTHER
}

/// 헌법상 개전·선전포고 결정 권한 소재 (누가 전쟁을 선포하는가)
enum WarPowerAuthority {
  /// 군주 대권 단독 (예: 일본 제국 헌법 제13조 천황 대권, 러시아 제국 황제)
  MONARCH_PREROGATIVE
  /// 군주 선포 + 상원·참의원 동의 (예: 1871 독일 제국 헌법 제11조 — 황제가 연방참의원 동의로 선포, 영토 피침 시 예외)
  MONARCH_WITH_UPPER_HOUSE
  /// 의회 전속 의결·승인 (예: 미국 헌법 제1조 8절 연방의회, 1791 프랑스 헌법·제3공화국 양원 합동 동의)
  LEGISLATURE_EXCLUSIVE
  /// 행정부(원수·수반) 선포 + 의회 사전·사후 동의 (예: 대한민국 헌법 제60조 2항 국회의 선전포고 동의권)
  EXECUTIVE_WITH_LEGISLATURE_CONSENT
  /// 국가원수·행정부 단독 결정 (전권 대통령제·군정·일당제 최고지도부 등)
  EXECUTIVE_EXCLUSIVE
  /// 헌법상 교전권·전쟁 포기 (예: 일본국 헌법 제9조)
  RENOUNCED
  /// 기타·혼합
  OTHER
}

model PoliticalSystem {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  //--- 대상 국가 (dual FK — 역사 우선, 현대는 dual-fill)
  countryId String?  @map("country_id") @db.Char(36)
  country   Country? @relation("CountryPoliticalSystems", fields: [countryId], references: [id], onDelete: Cascade)

  historicalCountryId String?            @map("historical_country_id") @db.Char(36)
  historicalCountry   HistoricalCountry? @relation("HistoricalCountryPoliticalSystems", fields: [historicalCountryId], references: [id], onDelete: Cascade)

  //--- 정체 이름
  /// 이 정체의 통칭 — '제5공화국', '바이마르 공화국', '메이지 헌법 체제'. 없을 수도 있다.
  name String? @db.VarChar(120)

  //--- 존속 기간 (BC·고대·연단위 지원)
  /// 재임(재위)과 달리 DATETIME 거울 컬럼을 두지 않는다. 정체는 사실상 연 단위로만
  /// 기록되고, 레거시 소비자가 없어 구조화 Int 축 하나만 진실로 두는 편이 안전하다
  /// (드라이버가 연도<100 DATETIME을 손상시키는 함정을 아예 만들지 않는다).
  startEra   Era? @map("start_era")
  startYear  Int? @map("start_year")
  startMonth Int? @map("start_month")
  startDay   Int? @map("start_day")

  endEra   Era? @map("end_era")
  endYear  Int? @map("end_year")
  endMonth Int? @map("end_month")
  endDay   Int? @map("end_day")

  /// 아직 지속 중 — 종료 필드가 비어 있는 것과 "모른다"를 구분한다
  isCurrent Boolean @default(false) @map("is_current")

  //--- 핵심 두 축
  governmentForm  GovernmentForm?  @map("government_form")
  legislatureType LegislatureType? @map("legislature_type")

  //--- 입법부 상세
  /// 하원(양원제) 또는 유일 원(단원제)의 이름 — '중의원', '국회', '하원'
  lowerHouseName  String? @map("lower_house_name") @db.VarChar(100)
  /// 그 원의 의석 수
  lowerHouseSeats Int?    @map("lower_house_seats")
  /// 상원 이름 — 양원제일 때만 의미 있다. '참의원', '상원', '귀족원'
  upperHouseName  String? @map("upper_house_name") @db.VarChar(100)
  upperHouseSeats Int?    @map("upper_house_seats")

  /// 하원(또는 단원) — 원 카탈로그(B7). 고르면 서버가 위 이름 칸을 표시 캐시로 채운다
  lowerChamberId String?  @map("lower_chamber_id") @db.Char(36)
  lowerChamber   Chamber? @relation("PoliticalSystemLowerChamber", fields: [lowerChamberId], references: [id], onDelete: SetNull)
  /// 상원 — 양원제일 때만
  upperChamberId String?  @map("upper_chamber_id") @db.Char(36)
  upperChamber   Chamber? @relation("PoliticalSystemUpperChamber", fields: [upperChamberId], references: [id], onDelete: SetNull)

  //--- 국가원수 / 정부수반
  ///
  /// 직함은 **관직 정의 카탈로그**(GovernmentPositionDefinition)를 정본으로 본다 —
  /// 재임·재위가 이미 그 테이블을 참조하므로, 여기만 자유 문자열로 두면 같은 '대통령'이
  /// 두 어휘로 갈라진다. FK가 있으면 그 정의의 title이 표시의 진실이고, 아래 텍스트 칸은
  /// 카탈로그에 없는 칭호('연합회의 의장'·'임시정부 수반')를 위한 자유입력으로 남는다.
  /// 표시 우선순위: 정의.title → 자유입력 텍스트.
  headOfStatePositionId String?                       @map("head_of_state_position_id") @db.Char(36)
  headOfStatePosition   GovernmentPositionDefinition? @relation("PoliticalSystemHeadOfStatePosition", fields: [headOfStatePositionId], references: [id], onDelete: SetNull)

  /// 국가원수 직함 자유입력 — 카탈로그에 없는 칭호일 때만. FK가 있으면 비운다.
  headOfStateTitle String? @map("head_of_state_title") @db.VarChar(100)
  /// 국가원수가 실권을 갖는가 — 입헌군주제의 국왕은 false, 대통령제의 대통령은 true
  headOfStateHasPower Boolean? @map("head_of_state_has_power")
  headOfGovernmentPositionId String?                       @map("head_of_government_position_id") @db.Char(36)
  headOfGovernmentPosition   GovernmentPositionDefinition? @relation("PoliticalSystemHeadOfGovernmentPosition", fields: [headOfGovernmentPositionId], references: [id], onDelete: SetNull)

  /// 정부수반 직함 자유입력 — 카탈로그에 없는 칭호일 때만. 대통령제처럼 국가원수와 같으면 비운다
  headOfGovernmentTitle String? @map("head_of_government_title") @db.VarChar(100)
  headOfGovernmentHasPower Boolean? @map("head_of_government_has_power")

  //--- 부가 축
  stateStructure StateStructure? @map("state_structure")
  partySystem    PartySystem?    @map("party_system")

  //--- 헌법상 선출·임기·선거제도 규칙
  /// 국가원수 선출·계승 방식 (직선·간선·세습 등)
  headSelectionMethod       HeadSelectionMethod? @map("head_selection_method")
  /// 국가원수 법정 임기 (년, 예: 5, 4)
  headOfStateTermYears      Int?                 @map("head_of_state_term_years")
  /// 국가원수 중임·연임 상한 횟수 (1=단임, 2=1차 중임 허용, null=무제한·미정)
  headOfStateTermLimit      Int?                 @map("head_of_state_term_limit")
  /// 하원(또는 단원) 의원 법정 임기 (년, 예: 4, 2, 5)
  lowerHouseTermYears       Int?                 @map("lower_house_term_years")
  /// 상원 의원 법정 임기 (년, 예: 6)
  upperHouseTermYears       Int?                 @map("upper_house_term_years")
  /// 주 선거제도 유형 (소선거구, 병립형, 연동형, 정당명부 비례 등)
  electoralSystem           ElectoralSystemType? @map("electoral_system")
  /// 의회 비례대표·정당 진입 봉쇄조항 기준 득표율 (%, 예: 3.0, 5.0)
  electoralThresholdPercent Float?               @map("electoral_threshold_percent")

  //--- 헌법상 군 통수권 · 개전·선전포고 규칙
  /// 개전·선전포고 권한 소재 (군주 대권, 의회 전속, 행정부 선포+의회 동의, 교전권 포기 등)
  warPowerAuthority          WarPowerAuthority?            @map("war_power_authority")
  /// 선전포고 의결·동의 담당 의회 원 (예: 독일 제국 연방참의원, 단원제 국회 등. 양원 모두 동의면 비우거나 주 원 지정)
  warConsentChamberId        String?                       @map("war_consent_chamber_id") @db.Char(36)
  warConsentChamber          Chamber?                      @relation("PoliticalSystemWarConsentChamber", fields: [warConsentChamberId], references: [id], onDelete: SetNull)
  /// 헌법상 군 최고통수권자 직위 (관직 정의 카탈로그 정본 — 예: 황제, 대통령, 국왕)
  commanderInChiefPositionId String?                       @map("commander_in_chief_position_id") @db.Char(36)
  commanderInChiefPosition   GovernmentPositionDefinition? @relation("PoliticalSystemCommanderInChiefPosition", fields: [commanderInChiefPositionId], references: [id], onDelete: SetNull)
  /// 개전·통수권 예외·단서 조항 메모 (예: '제국 영토·해안 피침 시 연방참의원 동의 면제')
  warPowerNotes              String?                       @map("war_power_notes") @db.VarChar(500)

  //--- 헌정 근거 법령 및 출범 사건
  /// 이 정체의 기본 헌법·헌장·기본법(Law) 연결
  constitutionLawId String? @map("constitution_law_id") @db.Char(36)
  constitutionLaw   Law?    @relation("PoliticalSystemConstitutionLaw", fields: [constitutionLawId], references: [id], onDelete: SetNull)

  /// 이 정체가 출범하게 된 계기 사건(제헌·혁명·개헌·건국 등)
  foundingEventId String? @map("founding_event_id") @db.Char(36)
  foundingEvent   Event?  @relation("PoliticalSystemFoundingEvent", fields: [foundingEventId], references: [id], onDelete: SetNull)

  /// 이 정체에 명시적으로 귀속 지정된 행정부·내각들
  cabinets Cabinet[] @relation("CabinetPoliticalSystem")

  /// 헌법·정체 전환의 배경 등 서술
  notes String? @db.Text

  //--- 소유권
  accountId String?  @map("account_id") @db.Char(36)
  account   Account? @relation("AccountPoliticalSystems", fields: [accountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([countryId], name: "idx_political_system_countryId")
  @@index([historicalCountryId], name: "idx_political_system_historicalCountryId")
  @@index([startYear], name: "idx_political_system_startYear")
  @@index([headOfStatePositionId], name: "idx_political_system_headOfStatePositionId")
  @@index([headOfGovernmentPositionId], name: "idx_political_system_headOfGovernmentPositionId")
  @@index([lowerChamberId], name: "idx_political_system_lowerChamberId")
  @@index([upperChamberId], name: "idx_political_system_upperChamberId")
  @@index([constitutionLawId], name: "idx_political_system_constitutionLawId")
  @@index([foundingEventId], name: "idx_political_system_foundingEventId")
  @@index([warConsentChamberId], name: "idx_political_system_warConsentChamberId")
  @@index([commanderInChiefPositionId], name: "idx_political_system_commanderInChiefPosId")
  @@map("political_system")
}

// ========================
// Chamber (의회의 원) — B7, docs/political-party-model-review.md
// ========================

/// 원의 자리 — 양원제의 하원·상원, 단원제의 유일 원, 의결권 없는 자문 기구(중추원)
enum ChamberRole {
  LOWER
  UPPER
  UNICAMERAL
  ADVISORY
  OTHER
}

/// 의원이 어떻게 그 자리에 오는가
enum ChamberComposition {
  /// 직선
  ELECTED
  /// 군주·정부 임명(이탈리아 왕국 원로원)
  APPOINTED
  /// 세습(귀족원)
  HEREDITARY
  /// 간선 — 주·지방 의회가 뽑음(독일 연방참의원)
  INDIRECT
  /// 직능·조합 대표(파시 및 조합원)
  CORPORATIST
  /// 섞임
  MIXED
  OTHER
}

/// 의회의 원 하나 — 정당 의석·선거·정체가 가리키는 정본. 공유 정본(계정 소유 없음)
model Chamber {
  id String @id @default(uuid()) @db.Char(36)

  //--- 국가 (dual FK — 역사 우선, 현대는 dual-fill)
  countryId           String?            @map("country_id") @db.Char(36)
  country             Country?           @relation("CountryChambers", fields: [countryId], references: [id], onDelete: SetNull)
  historicalCountryId String?            @map("historical_country_id") @db.Char(36)
  historicalCountry   HistoricalCountry? @relation("HistoricalCountryChambers", fields: [historicalCountryId], references: [id], onDelete: SetNull)

  /// 한국어 이름 — '대의원', '서민원'
  name      String  @db.VarChar(150)
  /// 원어 — 'Camera dei Deputati', 'House of Commons'
  localName String? @map("local_name") @db.VarChar(200)
  shortName String? @map("short_name") @db.VarChar(60)

  role        ChamberRole
  composition ChamberComposition?

  /// 원이 존재한 기간(구조화) — 모르면 비운다(정원 이력·정체 기간이 따로 있다)
  startEra       Era?    @map("start_era")
  startYear      Int?    @map("start_year")
  startMonth     Int?    @map("start_month")
  startDay       Int?    @map("start_day")
  startPrecision String? @map("start_precision") @db.VarChar(10)
  endEra         Era?    @map("end_era")
  endYear        Int?    @map("end_year")
  endMonth       Int?    @map("end_month")
  endDay         Int?    @map("end_day")
  endPrecision   String? @map("end_precision") @db.VarChar(10)

  /// 이 원이 대신한 원 — 국가가 바뀌어도 같은 기관이 이어지면(그레이트브리튼 → 연합왕국 서민원)
  predecessorId String?   @map("predecessor_id") @db.Char(36)
  predecessor   Chamber?  @relation("ChamberLineage", fields: [predecessorId], references: [id], onDelete: SetNull)
  successors    Chamber[] @relation("ChamberLineage")

  note      String? @db.Text
  sortOrder Int     @default(0) @map("sort_order")

  sizes                     ChamberSize[]
  elections                 Election[]                 @relation("ElectionChamber")
  observations              Observation[]              @relation("ObservationChamber")
  tenures                   GovernmentPositionTenure[] @relation("TenureChamber")
  passedLaws                Law[]                      @relation("LawPassedChamber")
  ratifiedTreatySignatories TreatySignatory[]          @relation("TreatySignatoryRatifiedChamber")
  systemsAsLower            PoliticalSystem[]          @relation("PoliticalSystemLowerChamber")
  systemsAsUpper            PoliticalSystem[]          @relation("PoliticalSystemUpperChamber")
  systemsAsWarConsent       PoliticalSystem[]          @relation("PoliticalSystemWarConsentChamber")
  approvedWarDeclarations   WarDeclaration[]           @relation("WarDeclarationApprovedChamber")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([countryId], name: "idx_chamber_countryId")
  @@index([historicalCountryId], name: "idx_chamber_historicalCountryId")
  @@index([predecessorId], name: "idx_chamber_predecessorId")
  @@map("chamber")
}

/// 원의 정원 이력 — 선거법·영토가 바뀔 때마다(대의원 508 → 535 → 400)
model ChamberSize {
  id        String  @id @default(uuid()) @db.Char(36)
  chamberId String  @map("chamber_id") @db.Char(36)
  chamber   Chamber @relation(fields: [chamberId], references: [id], onDelete: Cascade)

  seats Int

  startEra       Era?    @map("start_era")
  startYear      Int?    @map("start_year")
  startMonth     Int?    @map("start_month")
  startDay       Int?    @map("start_day")
  startPrecision String? @map("start_precision") @db.VarChar(10)
  endEra         Era?    @map("end_era")
  endYear        Int?    @map("end_year")
  endMonth       Int?    @map("end_month")
  endDay         Int?    @map("end_day")
  endPrecision   String? @map("end_precision") @db.VarChar(10)

  note      String? @db.Text
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([chamberId], name: "idx_chamber_size_chamberId")
  @@map("chamber_size")
}
