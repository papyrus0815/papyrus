/// ║                               POLITICS DOMAIN                                ║
/// ╚══════════════════════════════════════════════════════════════════════════════╝
/// 
/// 이 도메인은 정당과 정치적 조직을 전문적으로 관리합니다.
/// 
/// 주요 기능:
/// - 정당(PoliticalParty): 정치적 집단
///   • 이념, 강령, 정치적 스펙트럼
///   • 상징, 로고 관리
///   • 설립과 해산, 합당과 분당
///   • 지역적 기반과 지지층
/// 
/// - 정당 별칭(PoliticalPartyAlias): 명칭 관리
///   • 약칭, 별칭, 과거명, 현지어명
///   • 언어별/시대별 명칭 변화
///   • 공식명과 통칭의 구분
/// 
/// - 당직(당수·서기장·원내대표…)은 PoliticalPartyMembership(roleCategory=LEADERSHIP + officeKind)이 정본.
///   (옛 PoliticalPartyLeadership 표는 0행·쓰기 경로 없이 이중 정본이라 B3에서 제거)
/// 
/// - 정당-조직 관계(PoliticalPartyOrganization): 연계 조직
///   • 당 전국위원회, 산하단체
///   • 정치자금 조직, 싱크탱크
///   • 청년회, 여성회 등 계층 조직
/// 
/// 활용 사례:
/// - 미국: 공화당, 민주당과 RNC, DNC
/// - 영국: 보수당, 노동당
/// - 독일: CDU, SPD, 녹색당
/// - 한국: 주요 정당들과 계파
/// 
/// 특징:
/// - 민주주의 체제의 핵심 주체
/// - 선거와 정책 경쟁의 단위
/// - 이데올로기와 이익 대표
/// - 조직(Organization)과 구분된 정치 전문 영역

// ========================
// Enums
// ========================

/// 정당의 이념적 스펙트럼(간략 분류)
enum PoliticalPosition {
  FAR_LEFT
  LEFT
  CENTER_LEFT
  CENTER
  CENTER_RIGHT
  RIGHT
  FAR_RIGHT
  BIG_TENT
}

/// 정당 이름의 유형 — 한 정당이 시기·언어마다 가진 이름들
enum PoliticalPartyAliasType {
  /// 약칭·두문자 (PNF)
  ACRONYM
  /// 별칭·비공식 명칭
  ALIAS
  /// 과거명 (호환 — 새 입력은 OFFICIAL + 기간)
  FORMER_NAME
  /// 현지어 명칭 (Partito Nazionale Fascista)
  LOCAL_NAME
  /// 그 기간의 공식 명칭 — 개명 이력. 법적 동일성이 이어지면 같은 정당의 OFFICIAL 이력, 합당·재창당이면 새 정당 + 계보
  OFFICIAL
  /// 다른 언어 번역명 (National Fascist Party)
  TRANSLATION
  /// 통칭 (파시스트당)
  COMMON
}

/// 정당의 종류 — 근대 정당만이 아니라 운동·붕당·교섭단체까지 같은 모델로 받는다
enum PoliticalPartyKind {
  /// 근대 정당
  PARTY
  /// 정치 운동 — 정당으로 조직되기 전 단계(전투 파쇼 1919)
  MOVEMENT
  /// 붕당·파벌 — 선거 없는 정치 집단(동인·서인·노론, 로마 옵티마테스)
  FACTION
  /// 의회 클럽·교섭단체 — 원내 집단(19세기 독일 Fraktion)
  PARLIAMENTARY_GROUP
  /// 공동 명부 — 여러 정당이 한 명부로 한 정당처럼 득표(프랑스 신인민전선)
  ELECTORAL_LIST
  /// 기타
  OTHER
}

/// 정당의 법적 지위 — 체제 안에서 그 정당이 놓인 자리(국가의 PartySystem과 짝)
enum PoliticalPartyLegalStatusKind {
  /// 합법 활동
  LEGAL
  /// 유일 합법 정당 (PNF 1928~, NSDAP 1933~)
  SOLE_LEGAL
  /// 당-국가 — 당이 국가 기구 위에 선다(소련 공산당)
  RULING_STATE_PARTY
  /// 불법화·금지
  BANNED
  /// 지하 활동
  UNDERGROUND
  /// 망명
  IN_EXILE
  /// 활동 정지
  SUSPENDED
  /// 헌법재판·사법 판결로 강제 해산 (통합진보당 2014)
  CONSTITUTIONALLY_DISSOLVED
  /// 기타
  OTHER
}

// ========================
// PoliticalParty
// ========================

/// 국가 단위의 정당 정보를 저장하는 모델
model PoliticalParty {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 정당명(공식 명칭) — 동일 국가(현대·역사) 내에서만 유일. 전역 유일 아님.
  name String @db.VarChar(150)

  /// 약칭/두문자
  shortName String? @map("short_name") @db.VarChar(50)

  /// 현지어 명칭
  localName String? @map("local_name") @db.VarChar(150)

  /// 이념 표시 캐시 — 정본은 PoliticalPartyIdeology(카탈로그 연결). 서비스가 연결 순서대로 이름을 이어 갱신한다(목록·검색이 조인 없이 돈다)
  ideology String? @db.Text

  /// 이념 스펙트럼 — 대표값. 시기별 변화는 PoliticalPartyPositionPeriod(지속 중 행을 저장하면 이 칸도 맞춘다)
  position PoliticalPosition?

  /// 종류 — 정당·운동·붕당·교섭단체·공동 명부
  kind PoliticalPartyKind @default(PARTY)

  /// 설명/개요
  description String? @db.Text

  /// 설립/해산 — AD 1000~9999만 채우는 정렬·호환용 거울. 진실은 아래 구조화 칸(재위·가문 선례 동형)
  foundedDate   DateTime? @map("founded_date")
  dissolvedDate DateTime? @map("dissolved_date")

  /// 구조화 창당일 — BC·연 정밀도 수용(옵티마테스, 1575 분당). year=크기값, precision은 서버 파생(year|month|day)
  foundedEra       Era?    @map("founded_era")
  foundedYear      Int?    @map("founded_year")
  foundedMonth     Int?    @map("founded_month")
  foundedDay       Int?    @map("founded_day")
  foundedPrecision String? @map("founded_precision") @db.VarChar(10)

  /// 구조화 해산일
  dissolvedEra       Era?    @map("dissolved_era")
  dissolvedYear      Int?    @map("dissolved_year")
  dissolvedMonth     Int?    @map("dissolved_month")
  dissolvedDay       Int?    @map("dissolved_day")
  dissolvedPrecision String? @map("dissolved_precision") @db.VarChar(10)

  /// 대표 로고 캐시 — 정본은 PoliticalPartySymbol(kind=LOGO, isPrimary). 서비스가 같은 트랜잭션에서 맞춘다
  logoUrl String? @map("logo_url") @db.VarChar(255)

  /// 차트·목록 강조용 브랜드 컬러 (#RRGGBB) — 하나
  brandColor String? @map("brand_color") @db.VarChar(7)

  /// 상징색 여러 개 — #RRGGBB 문자열 배열(검정·빨강). 차트용은 brandColor
  colorPalette Json? @map("color_palette")

  /// 현재 당사 도시 캐시 — 정본은 PoliticalPartyHeadquarters(지속 중 행, 없으면 가장 늦은 행)
  headquartersCityId String? @map("headquarters_city_id") @db.Char(36)

  //--- 외래키(국가 맥락)
  countryId           String? @map("country_id") @db.Char(36)
  historicalCountryId String? @map("historical_country_id") @db.Char(36)

  /// 자유 확장용 JSON
  extra Json?

  //--- 관계
  headquartersCity  City?              @relation("PoliticalPartyHeadquartersCity", fields: [headquartersCityId], references: [id], onDelete: SetNull)
  country           Country?           @relation("PoliticalPartyCountry", fields: [countryId], references: [id], onDelete: SetNull)
  historicalCountry HistoricalCountry? @relation("PoliticalPartyHistoricalCountry", fields: [historicalCountryId], references: [id], onDelete: SetNull)

  transitionsFrom PoliticalPartyTransition[] @relation("PartyTransitionFrom")
  transitionsTo   PoliticalPartyTransition[] @relation("PartyTransitionTo")

  /// 계보가 아닌 관계(자매·위성·계파·공동 교섭단체) — 이 정당이 from/to
  linksFrom PoliticalPartyLink[] @relation("PartyLinkFrom")
  linksTo   PoliticalPartyLink[] @relation("PartyLinkTo")

  aliases              PoliticalPartyAlias[]
  /// 법적 지위 기간(합법·유일 합법·불법화·해산 판결…)
  legalStatuses        PoliticalPartyLegalStatus[]
  /// 이념 연결(카탈로그) — 대표·기간·순서
  ideologyLinks        PoliticalPartyIdeology[]
  /// 스펙트럼 기간 변화
  positionPeriods      PoliticalPartyPositionPeriod[]
  /// 표지 — 로고·당기·상징·투표 상징·사진·포스터
  symbols              PoliticalPartySymbol[]
  /// 표현 — 표어·구호·당가·인사법
  expressions          PoliticalPartyExpression[]
  /// 당사 이전 이력
  headquarters         PoliticalPartyHeadquarters[]
  affiliations         PoliticalPartyOrganization[]
  /// 일반 당원·소속 기간
  memberships          PoliticalPartyMembership[]   @relation("PartyMemberships")
  /// 선거 후보(공천 정당)
  electionCandidacies  ElectionCandidacy[]          @relation("ElectionCandidacyParty")
  /// 선거별 정당 집계(득표·득표율·의석 등)
  electionPartyResults ElectionPartyResult[]        @relation("ElectionPartyResults")
  /// 내각과의 연정·여당 관계
  cabinetAffiliations  CabinetPoliticalParty[]      @relation("CabinetPartyAffiliations")
  /// 이 정당 소속으로 기록된 공직·군직 재임들
  governmentTenures    GovernmentPositionTenure[]   @relation("TenurePoliticalParty")
  /// 관련 법령(`Law`) 연결 — 정당법·정치자금법 등
  politicalPartyLaws   PoliticalPartyLaw[]           @relation("PartyLawAffiliations")
  /// 사건(`Event`) 참여·창당·해산 관계
  eventRelations       EventPoliticalPartyRelation[]

  //--- 메타데이터
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([countryId], name: "idx_party_countryId")
  @@index([position], name: "idx_party_position")
  @@index([kind], name: "idx_party_kind")
  @@index([headquartersCityId], name: "idx_party_hqCityId")
  @@unique([countryId, name], name: "uniq_party_country_name")
  @@unique([historicalCountryId, name], name: "uniq_party_historical_country_name")
  @@map("political_party")
}

// ========================
// PoliticalPartyLaw (정당 ↔ 법령)
// ========================
/// 정당 설립·운영·선거와 관련된 법령을 `Law`로 연결
model PoliticalPartyLaw {
  id String @id @default(uuid()) @db.Char(36)

  partyId String @map("party_id") @db.Char(36)
  lawId   String @map("law_id") @db.Char(36)

  /// 조문·적용 범위 등 메모
  relevanceNote String? @map("relevance_note") @db.Text

  sortOrder Int @default(0) @map("sort_order")

  party PoliticalParty @relation("PartyLawAffiliations", fields: [partyId], references: [id], onDelete: Cascade)
  /// 법령 행 삭제 전 조인을 해제해야 함
  law   Law            @relation("PoliticalPartyLawLink", fields: [lawId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([partyId, lawId], name: "uniq_political_party_law")
  @@index([lawId], name: "idx_political_party_law_lawId")
  @@map("political_party_law")
}

// ========================
// PoliticalPartyAlias
// ========================

/// 정당의 별칭/약칭/과거명 등을 저장
model PoliticalPartyAlias {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 대상 정당
  partyId String @map("party_id") @db.Char(36)

  /// 별칭/약칭 명칭
  name String @db.VarChar(150)

  /// 유형
  type PoliticalPartyAliasType

  /// 언어 코드(예: en, ko)
  languageCode String? @map("language_code") @db.VarChar(10)

  /// 같은 유형·언어 안의 대표 이름 — 서비스가 하나만 남긴다
  isPrimary Boolean @default(false) @map("is_primary")

  /// 사용 기간 — 구조화 날짜(BC·연 정밀도). precision은 서버 파생
  startEra       Era?    @map("start_era")
  startYear      Int?    @map("start_year")
  startMonth     Int?    @map("start_month")
  startDay       Int?    @map("start_day")
  startPrecision String? @map("start_precision") @db.VarChar(10)
  endEra         Era?    @map("end_era")
  endYear        Int?    @map("end_year")
  endMonth       Int?    @map("end_month")
  endDay         Int?    @map("end_day")
  endPrecision   String? @map("end_precision") @db.VarChar(10)

  /// 메모 — '국민·민족 파시스트당이라는 번역도 드물게 쓰인다'
  note String? @db.Text

  sortOrder Int @default(0) @map("sort_order")

  //--- 관계
  party PoliticalParty @relation(fields: [partyId], references: [id], onDelete: Cascade)

  //--- 메타데이터
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([partyId, name, type, languageCode], name: "uniq_party_alias")
  @@index([partyId], name: "idx_party_alias_partyId")
  @@map("political_party_alias")
}

// ========================
// PoliticalPartyIdeology (정당 × 이념 카탈로그)
// ========================

/// 정당의 이념·노선 — 카탈로그(Ideology) 연결. 순서 = 표시 순서, isPrimary = 대표 이념.
/// 기간은 그 이념을 내건 시기(나중에 버린 노선 등). 한 정당에 같은 이념은 한 행.
model PoliticalPartyIdeology {
  id String @id @default(uuid()) @db.Char(36)

  partyId    String @map("party_id") @db.Char(36)
  ideologyId String @map("ideology_id") @db.Char(36)

  isPrimary Boolean @default(false) @map("is_primary")

  startEra       Era?    @map("start_era")
  startYear      Int?    @map("start_year")
  startMonth     Int?    @map("start_month")
  startDay       Int?    @map("start_day")
  startPrecision String? @map("start_precision") @db.VarChar(10)
  endEra         Era?    @map("end_era")
  endYear        Int?    @map("end_year")
  endMonth       Int?    @map("end_month")
  endDay         Int?    @map("end_day")
  endPrecision   String? @map("end_precision") @db.VarChar(10)

  note      String? @db.Text
  sortOrder Int     @default(0) @map("sort_order")

  party    PoliticalParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  /// 쓰이는 이념은 지울 수 없다(연결을 먼저 푼다)
  ideology Ideology       @relation(fields: [ideologyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([partyId, ideologyId], name: "uniq_party_ideology")
  @@index([ideologyId], name: "idx_party_ideology_ideologyId")
  @@map("political_party_ideology")
}

// ========================
// PoliticalPartyPositionPeriod (스펙트럼 기간)
// ========================

/// 정당 스펙트럼의 시기별 변화 — 좌경화·우경화. 지속 중(isCurrent) 행을 저장하면 PoliticalParty.position도 맞춘다.
model PoliticalPartyPositionPeriod {
  id String @id @default(uuid()) @db.Char(36)

  partyId String @map("party_id") @db.Char(36)

  position PoliticalPosition

  startEra       Era?    @map("start_era")
  startYear      Int?    @map("start_year")
  startMonth     Int?    @map("start_month")
  startDay       Int?    @map("start_day")
  startPrecision String? @map("start_precision") @db.VarChar(10)
  endEra         Era?    @map("end_era")
  endYear        Int?    @map("end_year")
  endMonth       Int?    @map("end_month")
  endDay         Int?    @map("end_day")
  endPrecision   String? @map("end_precision") @db.VarChar(10)

  isCurrent Boolean @default(false) @map("is_current")

  /// 근거·맥락 — '1990년대 제3의 길 노선으로 중도좌파'
  note      String? @db.Text
  sortOrder Int     @default(0) @map("sort_order")

  party PoliticalParty @relation(fields: [partyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([partyId], name: "idx_party_position_period_partyId")
  @@map("political_party_position_period")
}

// ========================
// PoliticalPartySymbol (표지)
// ========================

enum PoliticalPartySymbolKind {
  /// 로고·당 휘장
  LOGO
  /// 당기
  FLAG
  /// 상징물 — 파스케스, 낫과 망치
  EMBLEM
  /// 투표 상징 — 인도 국민회의의 손바닥(문맹 유권자용 기표 그림)
  BALLOT_SYMBOL
  /// 사진 — 당사·집회
  PHOTO
  /// 포스터·선전물
  POSTER
  /// 기타
  OTHER
}

/// 정당의 표지 이미지 — 종류·기간·캡션. 같은 종류 안의 대표 하나(isPrimary). 대표 LOGO는 PoliticalParty.logoUrl 캐시.
model PoliticalPartySymbol {
  id String @id @default(uuid()) @db.Char(36)

  partyId String @map("party_id") @db.Char(36)

  kind PoliticalPartySymbolKind

  /// 업로드 경로(/uploads/…) 또는 외부 URL
  imageUrl String @map("image_url") @db.VarChar(500)

  /// 캡션 — '1934년 총선 앞둔 당사(팔라초 브라스키)'
  caption String? @db.Text

  isPrimary Boolean @default(false) @map("is_primary")

  startEra       Era?    @map("start_era")
  startYear      Int?    @map("start_year")
  startMonth     Int?    @map("start_month")
  startDay       Int?    @map("start_day")
  startPrecision String? @map("start_precision") @db.VarChar(10)
  endEra         Era?    @map("end_era")
  endYear        Int?    @map("end_year")
  endMonth       Int?    @map("end_month")
  endDay         Int?    @map("end_day")
  endPrecision   String? @map("end_precision") @db.VarChar(10)

  sortOrder Int @default(0) @map("sort_order")

  party PoliticalParty @relation(fields: [partyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([partyId, kind], name: "idx_party_symbol_party_kind")
  @@map("political_party_symbol")
}

// ========================
// PoliticalPartyExpression (표현)
// ========================

enum PoliticalPartyExpressionKind {
  /// 표어 — Credere, Obbedire, Combattere
  MOTTO
  /// 선거 구호
  SLOGAN
  /// 당가 — Giovinezza
  ANTHEM
  /// 당 노래(당가 외)
  PARTY_SONG
  /// 인사법·경례
  SALUTE
  /// 기타
  OTHER
}

/// 정당의 말·노래 — 원문·언어·번역·기간·음원/악보 링크. 같은 종류 안의 대표 하나(isPrimary).
model PoliticalPartyExpression {
  id String @id @default(uuid()) @db.Char(36)

  partyId String @map("party_id") @db.Char(36)

  kind PoliticalPartyExpressionKind

  /// 원문(노래는 제목) — 'Credere, Obbedire, Combattere', 'Giovinezza'
  originalText String @map("original_text") @db.Text

  /// 원문 언어 ISO 639
  languageCode String? @map("language_code") @db.VarChar(10)

  /// 번역 — '믿고, 따르고, 싸우라', '청춘이여'
  translation String? @db.Text

  /// 음원·악보·가사 링크
  mediaUrl String? @map("media_url") @db.VarChar(500)

  isPrimary Boolean @default(false) @map("is_primary")

  startEra       Era?    @map("start_era")
  startYear      Int?    @map("start_year")
  startMonth     Int?    @map("start_month")
  startDay       Int?    @map("start_day")
  startPrecision String? @map("start_precision") @db.VarChar(10)
  endEra         Era?    @map("end_era")
  endYear        Int?    @map("end_year")
  endMonth       Int?    @map("end_month")
  endDay         Int?    @map("end_day")
  endPrecision   String? @map("end_precision") @db.VarChar(10)

  note      String? @db.Text
  sortOrder Int     @default(0) @map("sort_order")

  party PoliticalParty @relation(fields: [partyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([partyId, kind], name: "idx_party_expression_party_kind")
  @@map("political_party_expression")
}

// ========================
// PoliticalPartyHeadquarters (당사 이력)
// ========================

/// 당사가 놓였던 곳 — 도시(선택 FK)·건물·주소·기간. 지속 중 행(없으면 가장 늦은 행)의 도시가 PoliticalParty.headquartersCityId 캐시.
model PoliticalPartyHeadquarters {
  id String @id @default(uuid()) @db.Char(36)

  partyId String @map("party_id") @db.Char(36)

  cityId String? @map("city_id") @db.Char(36)

  /// 건물 — 팔라초 브라스키(Palazzo Braschi)
  buildingName String? @map("building_name") @db.VarChar(200)

  address String? @db.VarChar(300)

  startEra       Era?    @map("start_era")
  startYear      Int?    @map("start_year")
  startMonth     Int?    @map("start_month")
  startDay       Int?    @map("start_day")
  startPrecision String? @map("start_precision") @db.VarChar(10)
  endEra         Era?    @map("end_era")
  endYear        Int?    @map("end_year")
  endMonth       Int?    @map("end_month")
  endDay         Int?    @map("end_day")
  endPrecision   String? @map("end_precision") @db.VarChar(10)

  isCurrent Boolean @default(false) @map("is_current")

  note      String? @db.Text
  sortOrder Int     @default(0) @map("sort_order")

  party PoliticalParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  /// FK 이름을 따로 — 기본 이름이 political_party.headquarters_city_id FK와 겹친다
  city  City?          @relation("PoliticalPartyHeadquartersHistoryCity", fields: [cityId], references: [id], onDelete: SetNull, map: "party_hq_history_city_id_fkey")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([partyId], name: "idx_party_hq_partyId")
  @@index([cityId], name: "idx_party_hq_cityId")
  @@map("political_party_headquarters")
}

// ========================
// PoliticalPartyLegalStatus (법적 지위 기간)
// ========================

/// 정당의 법적 지위가 바뀐 구간 — '1928년부터 유일 합법 정당', '1933년 불법화', '2014년 헌재 해산'.
/// 근거 법령·사건을 선택 연결한다. 국가의 일당제·다당제(PoliticalSystem.partySystem)는 체제, 이건 그 체제 안의 정당 자리.
model PoliticalPartyLegalStatus {
  id String @id @default(uuid()) @db.Char(36)

  partyId String @map("party_id") @db.Char(36)

  status PoliticalPartyLegalStatusKind

  /// 기간 — 구조화 날짜(precision 서버 파생)
  startEra       Era?    @map("start_era")
  startYear      Int?    @map("start_year")
  startMonth     Int?    @map("start_month")
  startDay       Int?    @map("start_day")
  startPrecision String? @map("start_precision") @db.VarChar(10)
  endEra         Era?    @map("end_era")
  endYear        Int?    @map("end_year")
  endMonth       Int?    @map("end_month")
  endDay         Int?    @map("end_day")
  endPrecision   String? @map("end_precision") @db.VarChar(10)

  /// 아직 지속 중 — 종료가 비어 있는 것과 '모른다'를 가른다(정체 선례)
  isCurrent Boolean @default(false) @map("is_current")

  /// 근거 법령(정당법·해산 명령 등)
  lawId String? @map("law_id") @db.Char(36)
  /// 계기 사건(해산 판결·쿠데타 등)
  eventId String? @map("event_id") @db.Char(36)

  note      String? @db.Text
  sortOrder Int     @default(0) @map("sort_order")

  party PoliticalParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  law   Law?           @relation("PoliticalPartyLegalStatusLaw", fields: [lawId], references: [id], onDelete: SetNull)
  event Event?         @relation("PoliticalPartyLegalStatusEvent", fields: [eventId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([partyId], name: "idx_party_legal_status_partyId")
  @@index([lawId], name: "idx_party_legal_status_lawId")
  @@index([eventId], name: "idx_party_legal_status_eventId")
  @@map("political_party_legal_status")
}

// ========================
// PoliticalPartyOrganization (Party ↔ Organization)
// ========================

/// 정당의 산하·연계 조직에서 그 조직이 맡은 자리
enum PoliticalPartyOrganizationRole {
  /// 지도 기구 — 대평의회·중앙위원회·정치국
  GOVERNING_ORGAN
  /// 청년 조직 — 발릴라, 히틀러 유겐트, 콤소몰
  YOUTH_WING
  /// 학생 조직
  STUDENT_WING
  /// 여성 조직
  WOMEN_WING
  /// 준군사조직 — 검은 셔츠단, SA
  PARAMILITARY_WING
  /// 기관지·당 매체 — 이탈리아 인민, 프라우다
  OFFICIAL_MEDIA
  /// 싱크탱크·정책 재단
  THINK_TANK
  /// 계열 노조
  TRADE_UNION
  /// 지역 지부·지역 지도부 — 대관구, 바트당 지역 지도부
  REGIONAL_BRANCH
  /// 해외 지부
  OVERSEAS_BRANCH
  /// 원내 교섭단체·의원단
  PARLIAMENTARY_GROUP
  /// 국제 조직 가입 — 코민테른, 사회주의 인터내셔널
  INTERNATIONAL_MEMBERSHIP
  /// 지속 연합 참여 — 인민전선
  ALLIANCE_MEMBERSHIP
  /// 기타
  OTHER
}

/// 정당의 산하·연계 조직 — 조직(Organization) 또는 군부대(MilitaryUnit)에 역할·기간을 달아 잇는다.
/// 이름 문자열로 두지 않는다: 기관지 편집장 경력·청년단 지도자·부대 지휘관이 같은 엔티티에 걸려야 한다.
/// 대상은 organizationId·militaryUnitId 중 정확히 하나(서비스가 검증). 같은 조직이 시기마다 역할이 다르면 행이 둘.
model PoliticalPartyOrganization {
  id String @id @default(uuid()) @db.Char(36)

  partyId String @map("party_id") @db.Char(36)

  role PoliticalPartyOrganizationRole

  organizationId String? @map("organization_id") @db.Char(36)
  militaryUnitId String? @map("military_unit_id") @db.Char(36)

  /// 기간 — 구조화 날짜(precision 서버 파생)
  startEra       Era?    @map("start_era")
  startYear      Int?    @map("start_year")
  startMonth     Int?    @map("start_month")
  startDay       Int?    @map("start_day")
  startPrecision String? @map("start_precision") @db.VarChar(10)
  endEra         Era?    @map("end_era")
  endYear        Int?    @map("end_year")
  endMonth       Int?    @map("end_month")
  endDay         Int?    @map("end_day")
  endPrecision   String? @map("end_precision") @db.VarChar(10)

  note      String? @db.Text
  sortOrder Int     @default(0) @map("sort_order")

  party        PoliticalParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  militaryUnit MilitaryUnit?  @relation("PoliticalPartyMilitaryUnit", fields: [militaryUnitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([partyId, organizationId, role], name: "uniq_party_org_role")
  @@unique([partyId, militaryUnitId, role], name: "uniq_party_unit_role")
  @@index([partyId], name: "idx_party_org_partyId")
  @@index([organizationId], name: "idx_party_org_orgId")
  @@index([militaryUnitId], name: "idx_party_org_unitId")
  @@map("political_party_organization")
}

// ========================
// PoliticalPartyLink (계보가 아닌 관계)
// ========================

/// 정당 사이의 '함께 있었던' 관계 — 계보(Transition)는 '어디서 왔나', 이건 '나란히 어떤 사이였나'
enum PoliticalPartyLinkKind {
  /// 자매 정당 — 대칭(CDU–CSU). 한 행만 두고 양쪽에서 읽는다
  SISTER_PARTY
  /// 위성정당 — from이 to의 위성(더불어시민당 → 더불어민주당)
  SATELLITE_OF
  /// 계파·분파 — from이 to 안의 계파(노론 안의 시파) 또는 당내 파벌
  FACTION_OF
  /// 공동 교섭단체·원내 연합 — 대칭
  PARLIAMENTARY_UNION
  /// 기타
  OTHER
}

/// 정당 두 곳의 관계 한 줄 — 종류·기간·메모. 대칭 종류(자매·공동 교섭단체)는 방향과 무관하게 한 쌍에 한 행(서비스가 막는다)
model PoliticalPartyLink {
  id String @id @default(uuid()) @db.Char(36)

  fromPartyId String @map("from_party_id") @db.Char(36)
  toPartyId   String @map("to_party_id") @db.Char(36)

  kind PoliticalPartyLinkKind

  startEra       Era?    @map("start_era")
  startYear      Int?    @map("start_year")
  startMonth     Int?    @map("start_month")
  startDay       Int?    @map("start_day")
  startPrecision String? @map("start_precision") @db.VarChar(10)
  endEra         Era?    @map("end_era")
  endYear        Int?    @map("end_year")
  endMonth       Int?    @map("end_month")
  endDay         Int?    @map("end_day")
  endPrecision   String? @map("end_precision") @db.VarChar(10)

  note      String? @db.Text
  sortOrder Int     @default(0) @map("sort_order")

  fromParty PoliticalParty @relation("PartyLinkFrom", fields: [fromPartyId], references: [id], onDelete: Cascade)
  toParty   PoliticalParty @relation("PartyLinkTo", fields: [toPartyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([fromPartyId, toPartyId, kind], name: "uniq_party_link")
  @@index([toPartyId], name: "idx_party_link_to")
  @@map("political_party_link")
}

// ========================
// PoliticalPartyTransition (전신·후신·합당·분당)
// ========================

/// 정당 간 계보: 한 방향 엣지(from → to). 합당은 여러 행(A→C, B→C)으로 표현.
enum PoliticalPartyTransitionKind {
  SUCCESSION
  MERGER_INTO
  SPLIT_FROM
  CONTINUITY
}

model PoliticalPartyTransition {
  id String @id @default(uuid()) @db.Char(36)

  fromPartyId String @map("from_party_id") @db.Char(36)
  toPartyId   String @map("to_party_id") @db.Char(36)

  kind PoliticalPartyTransitionKind @map("kind")

  /// 정렬·하위 호환 거울 — AD1000+ 일 단위만. 정본은 아래 구조화 날짜
  effectiveDate DateTime? @map("effective_date")
  /// 계보가 일어난 때(구조화) — 1921년만 아는 경우·BC 붕당도 담는다. precision은 서버 파생
  effectiveEra       Era?    @map("effective_era")
  effectiveYear      Int?    @map("effective_year")
  effectiveMonth     Int?    @map("effective_month")
  effectiveDay       Int?    @map("effective_day")
  effectivePrecision String? @map("effective_precision") @db.VarChar(10)
  notes         String?   @db.Text

  fromParty PoliticalParty @relation("PartyTransitionFrom", fields: [fromPartyId], references: [id], onDelete: Cascade)
  toParty   PoliticalParty @relation("PartyTransitionTo", fields: [toPartyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([fromPartyId], name: "idx_party_trans_from")
  @@index([toPartyId], name: "idx_party_trans_to")
  /// 동일 방향(from→to) 중복 행 방지 — 유형·날짜·메모 변경은 PATCH로
  @@unique([fromPartyId, toPartyId], name: "uniq_party_transition_from_to")
  @@map("political_party_transition")
}
