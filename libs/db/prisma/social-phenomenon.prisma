/// 사회현상/문제에 대한 해결책/대응방안 모델
model Solution {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 사회현상/문제 ID
  phenomenonId String @map("phenomenon_id") @db.Char(36)

  /// 해결책 제목
  title String @db.VarChar(200)

  /// 해결책 상세 설명
  description String? @db.Text

  /// 시행 세기
  implementationCentury Century? @map("implementation_century")

  /// 시행 연도
  implementationYear Int? @map("implementation_year")

  /// 효과성 평가 (1-10)
  effectivenessRating Int? @map("effectiveness_rating")

  /// 예상 비용
  costEstimate Decimal? @map("cost_estimate") @db.Decimal(15, 2)

  /// 비용 통화
  costCurrency String? @default("USD") @map("cost_currency") @db.VarChar(3)

  /// 현재 상태
  status SolutionStatus @default(PROPOSED)

  /// 시행 결과 및 평가
  outcome String? @db.Text

  /// 썸네일 이미지 URL
  thumbnailUrl String? @map("thumbnail_url") @db.VarChar(255)

  //--- 관계 필드
  phenomenon SocialPhenomenon @relation(fields: [phenomenonId], references: [id], onDelete: Cascade)

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([phenomenonId], name: "idx_solution_phenomenonId")
  @@index([status], name: "idx_solution_status")
  @@index([implementationYear], name: "idx_solution_implementationYear")
  @@map("solution")
}

// ========================
// SocialPhenomenonTag
// ========================

/// 사회현상/문제를 분류하는 태그 모델
model SocialPhenomenonTag {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 태그명
  name String @unique @db.VarChar(100)

  /// 태그 설명
  description String? @db.Text

  /// 태그 카테고리
  category String? @db.VarChar(50)

  /// 태그 색상 (UI에서 사용)
  color String? @db.VarChar(7) // HEX 색상 코드

  /// 썸네일 이미지 URL
  thumbnailUrl String? @map("thumbnail_url") @db.VarChar(255)

  //--- 관계 필드
  phenomena SocialPhenomenonTagRelation[]

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("social_phenomenon_tag")
}

// ========================
// SocialPhenomenonTagRelation
// ========================

/// 사회현상/문제와 태그 간의 연결 모델
model SocialPhenomenonTagRelation {
  /// 사회현상/문제 ID
  phenomenonId String @map("phenomenon_id") @db.Char(36)

  /// 태그 ID
  tagId String @map("tag_id") @db.Char(36)

  //--- 관계 필드
  phenomenon SocialPhenomenon    @relation(fields: [phenomenonId], references: [id], onDelete: Cascade)
  tag        SocialPhenomenonTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")

  @@id([phenomenonId, tagId])
  @@index([phenomenonId], name: "idx_phenomenon_tag_phenomenonId")
  @@index([tagId], name: "idx_phenomenon_tag_tagId")
  @@map("social_phenomenon_tag_relation")
}
