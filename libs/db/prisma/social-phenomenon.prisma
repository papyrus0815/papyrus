/// 국가별 사회현상/문제 모델
model SocialPhenomenon {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 현상/문제 제목
  title String @db.VarChar(200)

  /// 현상/문제 설명
  description String? @db.Text

  /// 카테고리
  category SocialPhenomenonCategory

  /// 심각도 수준
  severityLevel SeverityLevel @map("severity_level")

  /// 현상이 시작된 세기
  startCentury Century? @map("start_century")

  /// 현상이 시작된 연도
  startYear Int? @map("start_year")

  /// 현상이 종료된 세기
  endCentury Century? @map("end_century")

  /// 현상이 종료된 연도 (NULL이면 현재 진행중)
  endYear Int? @map("end_year")

  /// 현재 상태
  status PhenomenonStatus @default(ONGOING)

  /// 사회적 영향에 대한 상세 설명
  impactDescription String? @map("impact_description") @db.Text

  /// 원인 분석
  causeAnalysis String? @map("cause_analysis") @db.Text

  /// 썸네일 이미지 URL
  thumbnailUrl String? @map("thumbnail_url") @db.VarChar(255)

  //--- 외래키
  /// 국가 ID (현대 국가)
  countryId           String? @map("country_id") @db.Char(36)
  /// 역사적 국가 ID (과거 국가)
  historicalCountryId String? @map("historical_country_id") @db.Char(36)

  //--- 관계 필드
  country       HistoricalCountry? @relation(fields: [historicalCountryId], references: [id], onDelete: Cascade)
  modernCountry Country?           @relation(fields: [countryId], references: [id], onDelete: Cascade)

  /// 연도별 세부 지표 데이터
  yearlyMetrics SocialPhenomenonMetric[]
  /// 해결책/대응방안
  solutions     Solution[]
  /// 관련 태그들
  tags          SocialPhenomenonTagRelation[]
  /// 현상의 구체적 관측(기관, 맥락, 방법론 등 포함)
  observations  SocialPhenomenonObservation[]

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([countryId], name: "idx_social_phenomenon_countryId")
  @@index([historicalCountryId], name: "idx_social_phenomenon_historicalCountryId")
  @@index([category], name: "idx_social_phenomenon_category")
  @@index([status], name: "idx_social_phenomenon_status")
  @@index([startCentury], name: "idx_social_phenomenon_startCentury")
  @@index([startYear], name: "idx_social_phenomenon_startYear")
  @@index([endCentury], name: "idx_social_phenomenon_endCentury")
  @@map("social_phenomenon")
}

// ========================
// SocialPhenomenonMetric
// ========================

/// 사회현상/문제의 연도별 측정 지표 모델
model SocialPhenomenonMetric {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 사회현상/문제 ID
  phenomenonId String @map("phenomenon_id") @db.Char(36)

  /// 측정 세기
  century Century? @map("century")

  /// 측정 연도
  year Int

  /// 측정 지표명 (예: 출생률, 실업률, GDP 성장률)
  metricName String @map("metric_name") @db.VarChar(100)

  /// 측정값
  metricValue Decimal? @map("metric_value") @db.Decimal(15, 4)

  /// 측정 단위 (예: %, 명, 달러)
  metricUnit String? @map("metric_unit") @db.VarChar(50)

  /// 데이터 출처
  source String? @db.VarChar(200)

  /// 추가 메모
  notes String? @db.Text

  //--- 관계 필드
  phenomenon SocialPhenomenon @relation(fields: [phenomenonId], references: [id], onDelete: Cascade)

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([phenomenonId, year, metricName], name: "uniq_metric_phenomenon_year_name")
  @@index([phenomenonId], name: "idx_metric_phenomenonId")
  @@index([year], name: "idx_metric_year")
  @@map("social_phenomenon_metric")
}

// ========================
// SocialPhenomenonObservation
// ========================

/// 특정 현상에 대한 관측치(예: 여론조사 '하우스 이펙트' 편향치)를 저장하는 모델
model SocialPhenomenonObservation {
  /// PK
  id String @id @default(uuid()) @db.Char(36)

  /// 어떤 현상에 대한 관측인가
  phenomenonId String @map("phenomenon_id") @db.Char(36)

  /// 관측 대상(다형 FK: COUNTRY, PERSON, 등) 타입
  subjectType AggregateType @map("subject_type")

  /// 관측 대상의 PK (subjectType과 조합하여 식별)
  subjectId String @map("subject_id") @db.Char(36)

  /// 관측을 수행한 기관명(예: 갤럽, 유고브). 별도 조직 모델이 없으므로 문자열로 보관
  organizationName String? @map("organization_name") @db.VarChar(100)

  /// 관측 맥락(예: 2024 대선, 특정 문항 등)
  context String? @db.VarChar(255)

  /// 관측 범위 시작일(기간 기반 관측을 위한 옵션)
  observedStartAt DateTime? @map("observed_start_at")

  /// 관측 범위 종료일(단일 시점인 경우 NULL 가능)
  observedEndAt DateTime? @map("observed_end_at")

  /// 지표명(예: house_effect_bias, approval_gap)
  metricName String @map("metric_name") @db.VarChar(100)

  /// 관측값(예: +1.8, -2.3)
  metricValue Decimal @map("metric_value") @db.Decimal(15, 4)

  /// 단위(예: pp, %, index)
  metricUnit String? @map("metric_unit") @db.VarChar(20)

  /// 효과 방향(부호). metricValue로도 유추 가능하지만 검색/필터 용이성을 위해 별도 보관
  direction PhenomenonDirection? @map("direction")

  /// 표본수(N)
  sampleSize Int? @map("sample_size")

  /// 표본 모집단(예: LV, RV, A)
  population String? @db.VarChar(20)

  /// 조사 방식(예: PHONE, ONLINE, MIXED)
  mode String? @db.VarChar(20)

  /// 방법론 세부(가중치, 문항, 설계 등). JSON으로 유연 저장
  method Json? @map("method")

  /// 출처(URL 또는 서지)
  source String? @db.VarChar(255)

  /// 비고 메모
  notes String? @db.Text

  //--- 관계 필드
  phenomenon SocialPhenomenon @relation(fields: [phenomenonId], references: [id], onDelete: Cascade)

  //--- 메타데이터 필드
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([phenomenonId], name: "idx_observation_phenomenonId")
  @@index([subjectType, subjectId], name: "idx_observation_subject")
  @@index([organizationName], name: "idx_observation_orgName")
  @@index([metricName], name: "idx_observation_metricName")
  @@map("social_phenomenon_observation")
}

