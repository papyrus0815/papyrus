/// ║                           SOCIAL PHENOMENON DOMAIN                          ║
/// ╚══════════════════════════════════════════════════════════════════════════════╝
/// 
/// 이 도메인은 사회 현상과 그 관측 데이터를 과학적으로 관리합니다.
/// 
/// 주요 기능:
/// - 사회현상(SocialPhenomenon): 사회적 문제와 현상
///   • 인구, 경제, 환경, 정치 등 영역별 분류
///   • 심각도와 진행 상황 추적
///   • 시작과 종료 시점 (세기/연도 조합)
///   • 원인 분석과 영향 평가
/// 
/// - 현상 지표(SocialPhenomenonMetric): 정량적 측정
///   • 연도별 지표 데이터 (출생률, 실업률 등)
///   • 측정값, 단위, 출처 정보
///   • 시계열 데이터로 변화 추이 분석
/// 
/// - 관측 데이터(SocialPhenomenonObservation): 연구 기관별 관측
///   • 기관별 편향과 방법론 차이 ('하우스 이펙트')
///   • 표본 설계와 조사 방식
///   • 다형성 관계로 다양한 대상 관측
///   • 메타데이터와 방법론 상세 기록
/// 
/// - 해결책(Solution): 대응 방안과 정책
///   • 시행된 정책과 프로그램
///   • 효과성 평가와 비용 분석
///   • 성공/실패 사례 축적
/// 
/// - 태그 시스템: 유연한 분류와 검색
///   • 주제별, 지역별, 방법론별 태그
///   • 다중 태그로 복합적 특성 표현
/// 
/// 활용 사례:
/// - 인구 감소, 고령화 등 인구 문제
/// - 여론조사의 기관별 편향 분석
/// - 경제 지표의 시계열 분석
/// - 정책 효과성 비교 연구
/// 
/// 특징:
/// - 정량적 데이터와 정성적 분석 결합
/// - 연구 방법론의 투명성 확보
/// - 시간적 변화와 인과관계 추적
/// - 증거 기반 정책 수립 지원
/// 
/// 세기와 연도 정보를 함께 관리하여 역사적 맥락을 더 정확하게 파악할 수 있습니다.
/// 정확한 연도를 모를 때는 세기만 입력하고, 알 수 있을 때는 연도도 함께 입력할 수 있습니다.
/// 예시:
/// - startCentury: TWENTIETH, startYear: 1989 (20세기 1989년)
/// - startCentury: NINETEENTH, startYear: 1868 (19세기 1868년)
/// - startCentury: BC_3RD, startYear: -250 (기원전 3세기 250년)
/// - startCentury: BC_50TH, startYear: null (기원전 50세기, 정확한 연도 불명)
/// - startCentury: BC_30TH, startYear: null (기원전 30세기, 정확한 연도 불명)

// ========================
// Enums for Social Phenomena
// ========================

/// 사회현상/문제의 카테고리를 정의합니다.
enum SocialPhenomenonCategory {
  /// 인구 문제
  POPULATION
  /// 경제 문제
  ECONOMY
  /// 사회 문제
  SOCIETY
  /// 환경 문제
  ENVIRONMENT
  /// 정치 문제
  POLITICS
  /// 교육 문제
  EDUCATION
  /// 보건 문제
  HEALTHCARE
  /// 기술 문제
  TECHNOLOGY
  /// 문화 문제
  CULTURE
  /// 기타
  OTHER
}

/// 사회현상/문제의 심각도 수준을 정의합니다.
enum SeverityLevel {
  /// 매우 낮음
  VERY_LOW
  /// 낮음
  LOW
  /// 보통
  MEDIUM
  /// 높음
  HIGH
  /// 매우 높음
  VERY_HIGH
  /// 심각
  CRITICAL
}

/// 사회현상/문제의 현재 상태를 정의합니다.
enum PhenomenonStatus {
  /// 진행중
  ONGOING
  /// 해결됨
  RESOLVED
  /// 악화됨
  WORSENED
  /// 안정화됨
  STABILIZED
  /// 역사적 (과거에만 존재)
  HISTORICAL
}

/// 관측된 효과의 방향(부호)을 정의합니다.
enum PhenomenonDirection {
  /// 긍정적 영향(값 > 0)
  POSITIVE
  /// 부정적 영향(값 < 0)
  NEGATIVE
  /// 중립(0 또는 방향성 판단 불가)
  NEUTRAL
}

