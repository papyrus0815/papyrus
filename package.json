    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "classnames": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.28",
    "howler": "^2.2.4",
    "joi": "^18.0.2",
    "lottie-react": "^2.4.1",
    "mysql2": "^3.16.0",
    "node-cron": "^4.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.0.2",
    "react-focus-lock": "^2.13.7",
    "react-hook-form": "^7.70.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.11.0",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.6.0",
    "redux-persist": "^6.0.0",
    "rxjs": "^7.8.2",
    "styled-components": "^6.1.19",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.8.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@nestia/core": "^10.0.1",
    "@nestia/sdk": "^10.0.1",
    "@nx/eslint": "22.3.3",
    "@nx/eslint-plugin": "22.3.3",
    "@nx/jest": "22.3.3",
    "@nx/js": "22.3.3",
    "@nx/node": "22.3.3",
    "@nx/vite": "22.3.3",
    "@nx/workspace": "22.3.3",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "^1.15.8",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.1.18",
    "@trivago/prettier-plugin-sort-imports": "^6.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/howler": "^2.2.12",
    "@types/jest": "^30.0.0",
    "@types/joi": "^17.2.2",
    "@types/multer": "^2.0.0",
    "@types/node": "25.0.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.36",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "~9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globby": "^16.1.0",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "jsonc-eslint-parser": "^2.4.2",
    "nestia": "^10.0.1",
    "nx": "22.3.3",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "^7.2.0",
    "prisma-erd-generator": "^2.4.2",
    "puppeteer": "^24.34.0",
    "shx": "^0.4.0",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.3.0",
    "tsconfig-paths": "^4.2.0",
    "ttypescript": "^1.5.15",
    "typescript": "~5.9.3",
    "typescript-transform-paths": "^3.5.6",
    "typia": "^11.0.0",
    "vite": "^7.3.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-tsconfig-paths": "^6.0.3"
  }
}
