{
  "name": "papyrus",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "script": "node scripts/run.js",
    "dev": "node scripts/run.js development/dev",
    "dev:nginx": "node scripts/run.js development/dev --nginx",
    "serve:api": "node scripts/run.js development/serve-api",
    "serve:web": "node scripts/run.js development/serve-web",
    "serve:web:network": "node scripts/run.js development/serve-web --network",
    "serve:web:tunnel": "node scripts/run.js development/serve-web --tunnel",
    "serve:web-admin": "nx run web:serve",
    "serve:web-user": "nx run web-user:serve",
    "dev:all": "concurrently \"npm run serve:api\" \"npm run serve:web-admin\" \"npm run serve:web-user\" --names \"API,ADMIN,USER\" --prefix-colors \"bgBlue,bgGreen,bgMagenta\"",
    "build:api": "node scripts/run.js build/api",
    "build:web": "node scripts/run.js build/web",
    "build:nestia": "node scripts/run.js build/nestia",
    "electron:dev": "cd apps/web && cross-env NODE_ENV=development electron .",
    "electron:build": "cd apps/web && npm run build && electron-builder",
    "electron:build:win": "cd apps/web && npm run build && electron-builder --win",
    "electron:build:mac": "cd apps/web && npm run build && electron-builder --mac",
    "electron:build:linux": "cd apps/web && npm run build && electron-builder --linux",
    "db:build": "node scripts/run.js database/build",
    "db:migrate": "node scripts/run.js database/migrate",
    "db:generate": "node scripts/run.js database/generate",
    "db:reset": "node scripts/run.js database/reset",
    "docker:up": "node scripts/run.js docker/up",
    "docker:up:env": "node scripts/run.js docker/up --env",
    "docker:up:https": "node scripts/run.js docker/up --https",
    "lint": "node scripts/run.js lint/check",
    "lint:fix": "node scripts/run.js lint/fix",
    "lint:api": "node scripts/run.js lint/check --api",
    "lint:web": "node scripts/run.js lint/check --web",
    "env:dev": "node scripts/run.js environment/dev",
    "env:prod": "node scripts/run.js environment/prod",
    "ssl:generate": "node scripts/run.js infrastructure/ssl-generate",
    "ssl:generate:simple": "node scripts/run.js infrastructure/ssl-generate --simple",
    "nginx:generate": "node scripts/run.js infrastructure/nginx-generate",
    "prisma:seed": "node -r ./prisma-seed-loader.js -r ts-node/register apps/api/prisma/seed.ts",
    "prepare": "ts-patch install"
  },
  "prisma": {
    "seed": "node -r ./prisma-seed-loader.js -r ts-node/register apps/api/prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/error-message": "^2.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@nestjs/common": "^11.1.10",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.10",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.10",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.3",
    "@prisma/adapter-mariadb": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@prisma/driver-adapter-utils": "^7.2.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@remix-run/router": "^1.23.0",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tiptap/extension-color": "^3.14.0",
    "@tiptap/extension-image": "^3.14.0",
    "@tiptap/extension-link": "^3.14.0",
    "@tiptap/extension-placeholder": "^3.14.0",
    "@tiptap/extension-text-style": "^3.14.0",
    "@tiptap/react": "^3.14.0",
    "@tiptap/starter-kit": "^3.14.0",
    "argon2": "^0.44.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
