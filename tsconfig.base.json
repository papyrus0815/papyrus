{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2023",
    "rootDir": ".",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "transform": "typia/lib/transform"
      }
    ],
    "strictNullChecks": true,
    "paths": {
      "@dto/*": ["libs/dto/*"],
      "@types/*": ["libs/types/*"],
      "@api": ["apps/api/src/api/module.ts"],
      "@api/*": ["apps/api/src/api/*"],
      "@papyrus/api-sdk": ["libs/api-sdk/src/index.ts"],

      "@prisma/client": ["node_modules/.prisma/client"],
      "@prisma/client/*": ["node_modules/.prisma/client/*"],
      "@prisma/prisma.service": ["apps/api/prisma/prisma.service"],
      "@prisma/config": ["apps/api/prisma/prisma.config"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
